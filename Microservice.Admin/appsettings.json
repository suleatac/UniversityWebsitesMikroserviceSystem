{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AuthCookie": {
    "CookieName": "MikroserviceAuthWebCookie",
    "ExpireMinutes": 60,
    "CookiePath": "/",
    "SameSite": "Lax",
    "SecurePolicy": "SameAsRequest",
    "SlidingExpiration": true,
    "ChunkSize": 4096,
    "EnableTicketStore": true,
    "TicketKeyPrefix": "auth:ticket:",
    "TicketBufferMinutes": 10,
    "KeycloakScope": "openid offline_access",
    "RoleClaimTypes": [
      "realm_access.roles",
      "resource_access.roles",
      "roles",
      "role",
      "http://schemas.microsoft.com/ws/2008/06/identity/claims/role"
    ],
    "NameClaimTypes": [
      "preferred_username",
      "name",
      "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name"
    ]
  },
  "AllowedHosts": "*"
}
