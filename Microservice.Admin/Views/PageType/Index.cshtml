@model IEnumerable<Microservice.Admin.ViewModels.PageType.GetPageTypeVm>
@{ ViewBag.pTitle = "PageType"; ViewBag.Title = "PageType Yönetimi"; Layout = "~/Views/Shared/_Layout.cshtml"; }
<div class="page-header-card mb-4 p-4 text-white" style="background:linear-gradient(135deg,#405de6,#5851db);border-radius:12px">
    <div class="d-flex justify-content-between align-items-center"><div><h4><i class="mdi mdi-file-tree me-2"></i>PageType Yönetimi</h4><p class="mb-0 opacity-75">Sayfa türlerini buradan yönetin</p></div><a asp-action="Create" class="btn btn-light"><i class="mdi mdi-plus me-1"></i>Yeni PageType</a></div>
</div>
<div class="card shadow-sm border-0"><div class="card-header"><div class="d-flex justify-content-between"><h5 class="mb-0"><i class="mdi mdi-table me-2 text-primary"></i>PageType Listesi</h5><span class="badge bg-primary">@Model.Count() Kayıt</span></div></div><div class="card-body">
    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> } @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
    <div class="table-responsive"><table class="table table-striped table-bordered align-middle"><thead><tr><th>ID</th><th>PageTypeId</th><th>Site</th><th>Dil</th><th>Ad</th><th>Slug</th><th>Template</th><th>View</th><th>Aktif</th><th>İşlemler</th></tr></thead><tbody>
    @foreach (var item in Model) { <tr><td>@item.Id</td><td>@item.PageTypeId</td><td>@item.SiteId</td><td>@item.DilId</td><td>@item.Name</td><td>@item.Slug</td><td>@item.TemplateId</td><td>@item.ViewName</td><td>@(item.IsActive ? "Evet" : "Hayır")</td><td><a class="btn btn-outline-primary btn-sm" asp-action="Edit" asp-route-id="@item.Id" title="Düzenle"><i class="fas fa-pencil-alt"></i></a> <a class="btn btn-outline-danger btn-sm" asp-action="Delete" asp-route-id="@item.Id" title="Sil"><i class="fas fa-trash-alt"></i></a></td></tr> }
    </tbody></table></div>
</div></div>
@section Scripts { <script src="~/assets/js/app.js"></script> }