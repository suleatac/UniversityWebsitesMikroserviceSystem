@model Microservice.Admin.ViewModels.PageBuilder.PageSectionDetailVm

@{
    ViewBag.pTitle = "Sayfa Bölüm Yönetimi";
    ViewBag.Title = "Yeni Bölüm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-xxl-9">
        <div class="card shadow-lg border-0">
            <div class="card-header bg-primary bg-opacity-10 border-bottom">
                <div class="d-flex align-items-center">
                    <div class="avatar-sm me-3">
                        <div class="avatar-title bg-primary rounded-circle">
                            <i class="mdi mdi-file-document-plus-outline fs-5"></i>
                        </div>
                    </div>
                    <div>
                        <h5 class="card-title mb-1">Yeni Bölüm Oluştur</h5>
                        <p class="card-text text-muted mb-0">Ana sayfaya yeni bir dinamik bölüm ekleyin.</p>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                <form asp-action="Create" method="post" id="sectionForm">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <input type="hidden" asp-for="SiteId" />
                    <input type="hidden" asp-for="DilId" />

                    <partial name="_SectionFormPartial" model="Model" />

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-secondary"><i class="mdi mdi-arrow-left me-1"></i> İptal</a>
                        <button type="submit" class="btn btn-primary"><i class="mdi mdi-check me-1"></i> Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<partial name="_FileManagerModalPartial" />

@section scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/app.js"></script>
    <script>
        $(function () {
            let currentInput = null;
            $('.open-file-manager').on('click', function () {
                currentInput = $(this).closest('.input-group').find('.file-picker-input');
                let type = $(this).data('type');
                $('#fileManagerFrame').attr('src', '/File?mode=picker&type=' + type);
                $('#fileManagerModal').modal('show');
            });
            window.addEventListener('message', function (event) {
                if (event.data && event.data.type === 'file-selected') {
                    if (currentInput) {
                        currentInput.val(event.data.url).trigger('input');
                    }
                    $('#fileManagerModal').modal('hide');
                }
            });
        });
    </script>
}
