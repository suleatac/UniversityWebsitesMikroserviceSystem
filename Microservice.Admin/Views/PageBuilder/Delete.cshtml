@model Microservice.Admin.ViewModels.PageBuilder.GetPageSectionVm

@{
    ViewBag.pTitle = "Sayfa Bölüm Yönetimi";
    ViewBag.Title = "Bölüm Sil";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int BlockSayaci(List<Microservice.Admin.ViewModels.PageBuilder.GetPageBlockVm> blocks)
    {
        return blocks.Sum(b => 1 + BlockSayaci(b.Children));
    }
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-lg border-0">
            <div class="card-header bg-danger bg-opacity-10 border-bottom">
                <h5 class="card-title mb-1">
                    <i class="mdi mdi-alert-circle-outline text-danger me-2"></i>Bölüm Silinsin mi?
                </h5>
            </div>

            <div class="card-body p-4">
                <div class="alert alert-warning">
                    <strong>"@Model.Baslik"</strong> başlıklı bölüm silinecek.
                    Bölümle birlikte <strong>@BlockSayaci(Model.Blocks) adet container</strong> ve carousel slaytları da kaldırılacaktır.
                </div>

                @if (Model.Blocks.Any())
                {
                    <h6 class="text-muted">Silinecek containerlar:</h6>
                    <ul class="list-group mb-4">
                        @foreach (var b in Model.Blocks.OrderBy(x => x.RowNumber))
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span><span class="badge bg-info text-dark me-2">@b.ContentType</span>@(string.IsNullOrWhiteSpace(b.Content) ? $"Container #{b.Id}" : System.Text.RegularExpressions.Regex.Replace(b.Content, "<.*?>", "").Length > 60 ? System.Text.RegularExpressions.Regex.Replace(b.Content, "<.*?>", "").Substring(0, 60) + "…" : System.Text.RegularExpressions.Regex.Replace(b.Content, "<.*?>", ""))</span>
                                <span class="text-muted small">col-@b.ColumnSize</span>
                            </li>
                        }
                    </ul>
                }

                <form asp-action="DeleteConfirmed" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-secondary"><i class="mdi mdi-arrow-left me-1"></i> Vazgeç</a>
                        <button type="submit" class="btn btn-danger"><i class="mdi mdi-trash-can-outline me-1"></i> Evet, Sil</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
