@model Microservice.Admin.ViewModels.ShortcutButton.ShortcutButtonVm

@{
    ViewBag.pTitle = "Kısayol Butonlar";
    ViewBag.Title = "Kısayol Butonu Sil";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-xxl-8">
        <div class="card shadow-lg border-0">
            <!-- Kırmızı uyarı başlığı -->
            <div class="card-header bg-danger bg-opacity-10 border-bottom">
                <div class="d-flex align-items-center">
                    <div class="avatar-sm me-3">
                        <div class="avatar-title bg-danger rounded-circle">
                            <i class="mdi mdi-delete fs-5"></i>
                        </div>
                    </div>
                    <div>
                        <h5 class="card-title mb-1">Kısayol Butonu Silme Onayı</h5>
                        <p class="card-text text-muted mb-0">Bu işlem geri alınamaz!</p>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                <!-- Uyarı mesajı -->
                <div class="alert alert-danger d-flex align-items-center" role="alert">
                    <i class="mdi mdi-alert-circle fs-4 me-2"></i>
                    <div>
                        <strong>Dikkat!</strong> "<strong>@Model.Ad</strong>" kısayol butonunu silmek üzeresiniz.
                        Bu işlem geri alınamaz.
                    </div>
                </div>

                <!-- Buton Bilgileri -->
                <h6 class="text-primary border-bottom pb-2 mb-3">
                    <i class="mdi mdi-information-outline me-1"></i> Kısayol Butonu Bilgileri
                </h6>

                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label text-muted small">Buton Adı</label>
                            <div class="form-control-plaintext fw-semibold">@Model.Ad</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label text-muted small">Link</label>
                            <div class="form-control-plaintext fw-semibold">@(string.IsNullOrWhiteSpace(Model.Link) ? "—" : Model.Link)</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label text-muted small">Sıra</label>
                            <div class="form-control-plaintext fw-semibold">@Model.Sira</div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label text-muted small">Görsel Türü</label>
                            <div class="form-control-plaintext fw-semibold">
                                @(Model.IsIconImage == true ? "İkon" : (Model.IsIconImage == false ? "Resim" : "—"))
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label text-muted small">İkon</label>
                            <div class="form-control-plaintext fw-semibold">
                                @if (!string.IsNullOrWhiteSpace(Model.IconUrl))
                                {
                                    <i class="@Model.IconUrl me-2" style="font-size:1.3rem; color:#556ee6;"></i>@Model.IconUrl
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label text-muted small">Resim</label>
                            <div class="form-control-plaintext fw-semibold">
                                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                                {
                                    <img src="@Model.ImageUrl" alt="@Model.Ad" style="width:48px; height:48px; object-fit:contain; border:1px solid #eee; border-radius:6px;" />
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Form Actions -->
                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="mdi mdi-arrow-left me-1"></i> İptal
                    </a>
                    <form asp-action="DeleteConfirmed" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-danger">
                            <i class="mdi mdi-delete me-1"></i> Evet, Sil
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/app.js"></script>
}
