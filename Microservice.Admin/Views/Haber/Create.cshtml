@model Microservice.Admin.ViewModels.Haber.HaberCreateIndexVm
@{
    ViewBag.pTitle = "Haberler";
    ViewBag.Title = "Yeni Haber";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-xxl-10">
        <div class="card shadow-lg border-0">
            <div class="card-header bg-primary bg-opacity-10 border-bottom">
                <div class="d-flex align-items-center">
                    <div class="avatar-sm me-3">
                        <div class="avatar-title bg-primary rounded-circle">
                            <i class="mdi mdi-newspaper fs-5"></i>
                        </div>
                    </div>
                    <div>
                        <h5 class="card-title mb-1">Haber Bilgileri</h5>
                        <p class="card-text text-muted mb-0">Yeni bir haber oluşturmak için formu doldurun</p>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                <form asp-action="Create" id="haberCreateForm" class="needs-validation" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none" role="alert" id="validationSummary">
                        <i class="mdi mdi-block-helper me-2"></i>
                        <ul></ul>
                    </div>

                    <!-- Site ve Dil Seçimi (Session'dan gelen gizli alanlar) -->
                    <input type="hidden" asp-for="CreateHaber.SiteId" />
                    <input type="hidden" asp-for="CreateHaber.DilId" />
 

                    <!-- Temel Bilgiler -->
                    <div class="mb-4">
                        <h6 class="text-primary border-bottom pb-2">
                            <i class="mdi mdi-information-outline me-1"></i> Temel Bilgiler
                        </h6>

                        <div class="row">
                            <div class="col-md-8">
                                <div class="mb-3">
                                    <label asp-for="CreateHaber.Baslik" class="form-label">
                                        Başlık <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="mdi mdi-format-title"></i></span>
                                        <input asp-for="CreateHaber.Baslik" class="form-control" placeholder="Haber başlığını giriniz" />
                                    </div>
                                    <span asp-validation-for="CreateHaber.Baslik" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="CreateHaber.KisaAciklama" class="form-label">
                                        Kısa Açıklama <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="mdi mdi-text-short"></i></span>
                                        <input asp-for="CreateHaber.KisaAciklama" class="form-control" placeholder="Kısa açıklama giriniz" />
                                    </div>
                                    <span asp-validation-for="CreateHaber.KisaAciklama" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- İçerik ve Medya -->
                    <div class="mb-4">
                        <h6 class="text-primary border-bottom pb-2">
                            <i class="mdi mdi-file-document-outline me-1"></i> İçerik ve Medya
                        </h6>

                        <!-- TinyMCE Editör -->
                        <div class="mb-3">
                            <label asp-for="CreateHaber.IcerikMetni" class="form-label">
                                İçerik Metni <span class="text-danger">*</span>
                            </label>
                            <textarea asp-for="CreateHaber.IcerikMetni" id="IcerikMetniEditor" class="form-control" rows="10" placeholder="Haber içeriğini giriniz..."></textarea>
                            <span asp-validation-for="CreateHaber.IcerikMetni" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-5">
                                <div class="mb-3">
                                    <label asp-for="CreateHaber.Link" class="form-label">
                                        Link
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="mdi mdi-link"></i></span>
                                        <input asp-for="CreateHaber.Link" class="form-control" placeholder="https://..." />
                                    </div>
                                    <span asp-validation-for="CreateHaber.Link" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-5">
                                <div class="mb-3">
                                    <label asp-for="CreateHaber.ResimUrl" class="form-label">
                                        Resim URL
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="mdi mdi-image-outline"></i></span>
                                        <input asp-for="CreateHaber.ResimUrl" id="ResimUrlInput" class="form-control" placeholder="https://example.com/image.jpg" />
                                        <button type="button" class="btn btn-outline-primary" id="openFileManagerBtn" title="Dosya Yöneticisi">
                                            <i class="mdi mdi-folder-open-outline"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="CreateHaber.ResimUrl" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="mb-3">
                                    <label asp-for="CreateHaber.HedefId" class="form-label">
                                        Hedef
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="mdi mdi-target"></i></span>
                                        <select asp-for="CreateHaber.HedefId" class="form-select"
                                                asp-items="@(new SelectList(Model.Hedefler, "Id", "Aciklama"))">
                                        </select>
                                    </div>
                                    <span asp-validation-for="CreateHaber.HedefId" class="text-danger small"></span>
                                </div>
                            </div>
                            
                        </div>
                    </div>

                    <!-- Tarih Bilgileri -->
                    <div class="mb-4">
                        <h6 class="text-primary border-bottom pb-2">
                            <i class="mdi mdi-calendar-outline me-1"></i> Tarih Bilgileri
                        </h6>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="CreateHaber.YayimTarihi" class="form-label">
                                        Yayım Tarihi <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="mdi mdi-calendar-check"></i></span>
                                        <input asp-for="CreateHaber.YayimTarihi" type="datetime-local" class="form-control"
                                        value="@Model.CreateHaber.YayimTarihi.ToString("yyyy-MM-ddTHH:mm")" />
                                    </div>
                                    <span asp-validation-for="CreateHaber.YayimTarihi" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="CreateHaber.BaslamaTarihi" class="form-label">
                                        Başlama Tarihi
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="mdi mdi-calendar-start"></i></span>
                                        <input asp-for="CreateHaber.BaslamaTarihi" type="datetime-local" class="form-control" />
                                    </div>
                                    <span asp-validation-for="CreateHaber.BaslamaTarihi" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="CreateHaber.BitisTarihi" class="form-label">
                                        Bitiş Tarihi
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="mdi mdi-calendar-end"></i></span>
                                        <input asp-for="CreateHaber.BitisTarihi" type="datetime-local" class="form-control" />
                                    </div>
                                    <span asp-validation-for="CreateHaber.BitisTarihi" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- SEO Ayarları -->
                    <div class="mb-4">
                        <h6 class="text-primary border-bottom pb-2">
                            <i class="mdi mdi-search-web me-1"></i> SEO Ayarları
                        </h6>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="CreateHaber.SeoUrl" class="form-label">
                                        SEO URL
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="mdi mdi-link-variant"></i></span>
                                        <input asp-for="CreateHaber.SeoUrl" class="form-control" placeholder="haber-basligi" />
                                    </div>
                                    <span asp-validation-for="CreateHaber.SeoUrl" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="CreateHaber.SeoTitle" class="form-label">
                                        SEO Title
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="mdi mdi-format-text"></i></span>
                                        <input asp-for="CreateHaber.SeoTitle" class="form-control" placeholder="SEO başlığı" />
                                    </div>
                                    <span asp-validation-for="CreateHaber.SeoTitle" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="CreateHaber.SeoDescription" class="form-label">
                                        SEO Description
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="mdi mdi-text-box-search-outline"></i></span>
                                        <input asp-for="CreateHaber.SeoDescription" class="form-control" placeholder="SEO açıklaması" />
                                    </div>
                                    <span asp-validation-for="CreateHaber.SeoDescription" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Dosyalar -->
                    <div class="mb-4">
                        <h6 class="text-primary border-bottom pb-2">
                            <i class="mdi mdi-paperclip me-1"></i> Dosyalar
                        </h6>

                        <p class="text-muted small mb-2">
                            Habere istediğiniz kadar dosya ekleyebilirsiniz. Dosyalar site üzerinde
                            "Dosyalar" bölümünde görünür.
                        </p>

                        <div class="mb-3">
                            <button type="button" class="btn btn-outline-primary btn-sm" id="btnIcerikDosyaSec">
                                <i class="mdi mdi-folder-open-outline me-1"></i>
                                Dosya Yöneticisinden Seç
                            </button>
                            <span class="ms-2 text-muted small">
                                MinIO'ya daha önce yüklediğiniz dosyalardan seçin. Yeni dosyalarınızı
                                Dosya Yöneticisi ekranından yükleyebilirsiniz.
                            </span>
                        </div>

                        <style>
                            .dosya-drag-handle {
                                cursor: grab;
                                color: #adb5bd;
                                font-size: 1.25rem;
                                min-width: 28px;
                                min-height: 28px;
                                display: flex;
                                align-items: center;
                                justify-content: center;
                                touch-action: none;
                                -webkit-user-select: none;
                                user-select: none;
                            }

                                .dosya-drag-handle:active {
                                    cursor: grabbing;
                                }

                            .icerik-dosya-ghost {
                                background: #e7f1ff !important;
                                opacity: 0.6;
                            }
                        </style>

                        <div id="dosyaListesi">
                            @for (int i = 0; i < Model.CreateHaber.Dosyalar.Count; i++)
                            {
                                var dosya = Model.CreateHaber.Dosyalar[i];
                                <div class="row g-2 align-items-center mb-2 icerik-dosya-row border rounded p-2 bg-light">
                                    <input type="hidden" name="CreateHaber.Dosyalar[@i].Id" value="@dosya.Id" />
                                    <input type="hidden" name="CreateHaber.Dosyalar[@i].DosyaUrl" value="@dosya.DosyaUrl" />
                                    <input type="hidden" name="CreateHaber.Dosyalar[@i].DosyaAdi" value="@dosya.DosyaAdi" />
                                    <input type="hidden" name="CreateHaber.Dosyalar[@i].DosyaBoyut" value="@dosya.DosyaBoyut" />
                                    <input type="hidden" name="CreateHaber.Dosyalar[@i].DosyaTuru" value="@dosya.DosyaTuru" />
                                    <input type="hidden" name="CreateHaber.Dosyalar[@i].Sira" value="@dosya.Sira" class="dosya-sira" />
                                    <div class="col-auto dosya-drag-handle" title="Sürükleyerek sırala">
                                        <i class="mdi mdi-drag-vertical-variant"></i>
                                    </div>
                                    <div class="col-md-2 text-center">
                                        <i class="mdi mdi-file-document-outline fs-4 text-secondary"></i>
                                    </div>
                                    <div class="col-md-4">
                                        <span class="dosya-adi fw-semibold">@dosya.DosyaAdi</span>
                                        <small class="text-muted d-block">@dosya.DosyaBoyut bytes</small>
                                    </div>
                                    <div class="col-md-3">
                                        <input type="text" name="CreateHaber.Dosyalar[@i].Baslik" value="@dosya.Baslik"
                                               class="form-control form-control-sm" placeholder="Dosya başlığı (opsiyonel)" />
                                    </div>
                                    <div class="col-md-1 text-end">
                                        <button type="button" class="btn btn-outline-danger btn-sm btn-dosya-kaldir" title="Kaldır">
                                            <i class="mdi mdi-delete-outline"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Form Actions -->
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="mdi mdi-arrow-left me-1"></i> Listeye Dön
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="mdi mdi-content-save me-1"></i> Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Dosya Yöneticisi Modal -->
<div class="modal fade" id="fileManagerModal" tabindex="-1" aria-labelledby="fileManagerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="fileManagerModalLabel">
                    <i class="mdi mdi-folder-open-outline me-1"></i> Dosya Yöneticisi
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body p-0" style="height: 600px;">
                <iframe id="fileManagerFrame" src="" style="width:100%; height:100%; border:none;"></iframe>
            </div>
        </div>
    </div>
</div>

<!-- Dosya Picker Modal (IcerikDosya secimi) -->
<div class="modal fade" id="dosyaPickerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="mdi mdi-folder-open-outline me-1"></i>
                    Dosya Yöneticisinden Seç
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body p-0" style="height: 600px;">
                <iframe id="dosyaPickerFrame" src="" style="width:100%; height:100%; border:none;"></iframe>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/assets/js/app.js"></script>
    <!-- Validation Scripts -->
    <partial name="_ValidationScriptsPartial" />

    <!-- TinyMCE -->
    <script src="~/assets/libs/tinymce/tinymce.min.js"></script>
    <!-- SortableJS (dosya siralama) -->
    <script src="~/assets/libs/sortablejs/Sortable.min.js"></script>
    <script>
        // ============================================
        // TinyMCE Editör Başlatma
        // ============================================
        tinymce.init({
            selector: '#IcerikMetniEditor',
            height: 500,
            menubar: true,
            language: 'tr_TR',

            plugins: [
                'advlist', 'autolink', 'lists', 'link', 'image', 'charmap', 'preview',
                'anchor', 'searchreplace', 'visualblocks', 'code', 'fullscreen',
                'insertdatetime', 'media', 'table', 'help', 'wordcount', 'codesample'
            ],

            toolbar: 'undo redo | blocks fontfamily fontsize | ' +
                     'bold italic underline strikethrough | forecolor backcolor | ' +
                     'alignleft aligncenter alignright alignjustify | ' +
                     'bullist numlist outdent indent | link image table | ' +
                     'codesample | removeformat | help',

            content_style: 'body { font-family:Helvetica,Arial,sans-serif; font-size:14px; padding: 10px; }',

            // Branding gizle
            branding: false,

            // Görsel yükleme için placeholder
            placeholder: 'Haber içeriğini buraya yazınız...',

            // Dosya yöneticisi entegrasyonu
            file_picker_callback: function (callback, value, meta) {
                let typeFilter = '';
                if (meta.filetype === 'image') {
                    typeFilter = 'image';
                } else if (meta.filetype === 'media') {
                    typeFilter = 'video';
                }

                openFileManagerForTinyMCE(function (url) {
                    if (meta.filetype === 'image') {
                        callback(url, { alt: 'Görsel' });
                    } else {
                        callback(url);
                    }
                }, typeFilter);
            },

            // Form submit öncesi TinyMCE içeriğini textarea'ya yaz
            setup: function (editor) {
                editor.on('change', function () {
                    editor.save();
                });
                editor.on('keyup', function () {
                    editor.save();
                });
            }
        });

        // ============================================
        // Form Submit - TinyMCE içeriğini senkronize et
        // ============================================
        document.getElementById('haberCreateForm').addEventListener('submit', function (e) {
            // TinyMCE içeriğini textarea'ya aktar
            var editor = tinymce.get('IcerikMetniEditor');
            if (editor) {
                editor.save();
            }
        });

        // ============================================
        // Dosya Yöneticisi - Modal (Resim URL alanı için)
        // ============================================
        $(function () {
            $('#openFileManagerBtn').on('click', function () {
                var type = 'image';
                $('#fileManagerFrame').attr('src', '/File?mode=picker&type=' + type);
                $('#fileManagerModal').modal('show');
            });

            // Dosya seçildiğinde mesaj dinle
            window.addEventListener('message', function (event) {
                if (event.data.type === 'file-selected') {
                    $('#ResimUrlInput').val(event.data.url);
                    $('#fileManagerModal').modal('hide');
                }
            });
        });

        // ============================================
        // Dosya Yöneticisi - TinyMCE için (Popup pencere)
        // ============================================
        function openFileManagerForTinyMCE(callback, type) {
            var w = window.open(
                '/File?mode=picker&type=' + type,
                'FileManager',
                'width=1200,height=700'
            );

            window.addEventListener('message', function handler(event) {
                if (event.data.type === 'file-selected') {
                    callback(event.data.url);
                    w.close();
                    window.removeEventListener('message', handler);
                }
            });
        }

        // ============================================
        // Dosyalar (IcerikDosya) - Yonetici secimi + surukle siralama
        // ============================================
        $(function () {
            const $liste = $('#dosyaListesi');
            const $btnSec = $('#btnIcerikDosyaSec');
            const formPrefix = 'CreateHaber';

            function reindexDosyalar() {
                $liste.find('.icerik-dosya-row').each(function (idx) {
                    $(this).find('[name]').each(function () {
                        const name = $(this).attr('name');
                        $(this).attr('name', name.replace(/Dosyalar\[\d+\]/, 'Dosyalar[' + idx + ']'));
                    });
                    // Siralama, listedeki konuma gore otomatik guncellenir
                    $(this).find('.dosya-sira').val(idx);
                });
            }

            function dosyaRowHtml(d) {
                const i = 0; // index atılırken yeniden düzenlenir
                const p = formPrefix + '.Dosyalar[' + i + ']';
                return '' +
                    '<div class="row g-2 align-items-center mb-2 icerik-dosya-row border rounded p-2 bg-light">' +
                    '<input type="hidden" name="' + p + '.Id" value="' + (d.id || 0) + '" />' +
                    '<input type="hidden" name="' + p + '.DosyaUrl" value="' + (d.url || '') + '" />' +
                    '<input type="hidden" name="' + p + '.DosyaAdi" value="' + (d.dosyaAdi || '') + '" />' +
                    '<input type="hidden" name="' + p + '.DosyaBoyut" value="' + (d.dosyaBoyut || 0) + '" />' +
                    '<input type="hidden" name="' + p + '.DosyaTuru" value="' + (d.dosyaTuru || '') + '" />' +
                    '<input type="hidden" name="' + p + '.Sira" value="0" class="dosya-sira" />' +
                    '<div class="col-auto dosya-drag-handle" title="Sürükleyerek sırala"><i class="mdi mdi-drag-vertical-variant"></i></div>' +
                    '<div class="col-md-2 text-center"><i class="mdi mdi-file-document-outline fs-4 text-secondary"></i></div>' +
                    '<div class="col-md-4"><span class="dosya-adi fw-semibold"></span><small class="text-muted d-block"></small></div>' +
                    '<div class="col-md-3"><input type="text" name="' + p + '.Baslik" value="" class="form-control form-control-sm" placeholder="Dosya başlığı (opsiyonel)" /></div>' +
                    '<div class="col-md-1 text-end">' +
                    '<button type="button" class="btn btn-outline-danger btn-sm btn-dosya-kaldir" title="Kaldır"><i class="mdi mdi-delete-outline"></i></button>' +
                    '</div></div>';
            }

            function formatBytes(b) {
                if (!b) return '';
                if (b < 1024) return b + ' B';
                if (b < 1048576) return (b / 1024).toFixed(1) + ' KB';
                return (b / 1048576).toFixed(1) + ' MB';
            }

            $btnSec.on('click', function () {
                $('#dosyaPickerFrame').attr('src', '/File?mode=picker&type=dosya');
                $('#dosyaPickerModal').modal('show');
            });

            // Dosya Yöneticisi'nden seçilen dosya (MinIO'da zaten yüklü)
            window.addEventListener('message', function (event) {
                if (!event.data || event.data.type !== 'icerik-dosya-selected') return;

                const $row = $(dosyaRowHtml(event.data));
                $row.find('.dosya-adi').text(event.data.dosyaAdi);
                $row.find('small').text(formatBytes(event.data.dosyaBoyut));
                $liste.append($row);
                reindexDosyalar();

                $('#dosyaPickerModal').modal('hide');
            });

            $liste.on('click', '.btn-dosya-kaldir', function () {
                $(this).closest('.icerik-dosya-row').remove();
                reindexDosyalar();
            });

            // Siralama: surukle-birak (SortableJS) - banner listesindeki gibi
            function initDosyaSiralama() {
                if (!window.Sortable) {
                    console.warn('SortableJS yuklenmedi - dosya siralama devre disi.');
                    return;
                }

                var liste = document.getElementById('dosyaListesi');
                if (!liste || liste._dosyaSortable) return; // tek sefer baslat

                liste._dosyaSortable = new Sortable(liste, {
                    handle: '.dosya-drag-handle',
                    animation: 200,
                    ghostClass: 'icerik-dosya-ghost',
                    forceFallback: true,
                    fallbackTolerance: 3,
                    onEnd: function () {
                        reindexDosyalar();
                    }
                });
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initDosyaSiralama);
            } else {
                initDosyaSiralama();
            }

            // Mevcut satırlardaki boyut bilgisini güzelleştir
            $liste.find('.icerik-dosya-row').each(function () {
                const boyut = parseInt($(this).find('input[name$=".DosyaBoyut"]').val() || '0', 10);
                $(this).find('small').text(formatBytes(boyut));
            });
        });

        // ============================================
        // Validation Summary Göster/Gizle
        // ============================================
        $(document).ready(function () {
