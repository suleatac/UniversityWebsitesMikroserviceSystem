{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ElasticSearch": {
    "BaseUrl": "http://localhost:9201",
    "UserName": "kibana_system",
    "Password": "strong-password",
    "IndexName": "site-api"
  },
  "OpenTelemetry": {
    "ServiceName": "Mikroservice.Site.Api",
    "ServiceVersion": "1.0.0",
    "ActivitySourceName": "Mikroservice.Site.Api.ActivitySource",
    "ActivitySourceFileName": "ActivitySource.Mikroservice.Site.Api.File"
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379, password= Password12",
    "PostgreSqlServer": "Host=localhost;Port=5433;Database=site_db;Username=site_db_user;Password=site_db_user_password"
  },
  "IdentityOption": {
    "Issuer": "http://localhost:8081/realms/UniversityRealm",
    "Audience": "site.api",
    "Adress": "http://localhost:8081/realms/UniversityRealm"
  },
  "RabbitMqMassTransitBusOption": {
    "Address": "localhost",
    "UserName": "root",
    "Password": "Password12",
    "Port": 5672
  },
  "SiteNginxConfig": {
    "ConfDirectory": "nginx-conf",
    "SnippetsDirectoryName": "snippets",
    "ContainerConfDirectory": "/etc/nginx/conf.d",
    "CertificateDirectory": "/etc/nginx/ssl",
    "CertificateBaseName": "sivas.edu.tr",
    "DomainSuffix": "sivas.edu.tr",
    "ProxyPassUrl": "http://localhost:5100",
    "MediaProxyPassUrl": "http://localhost:9000/site-media/",

    "TemplateVersion": 2,

    "EnableConfigReload": false,
    "ReloadDebounceSeconds": 3,

    "EnableReconcile": false,
    "ReconcileStartupDelaySeconds": 20,
    "ReconcileIntervalMinutes": 30,

    "EnableDistributedLock": false,
    "LockTimeoutSeconds": 60,
    "LockWaitSeconds": 15
  }
}
