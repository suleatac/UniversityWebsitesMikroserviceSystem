{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SiteNginxConfig": {
    "ProxyPassUrl": "http://mikroservice.gateway:8080",
    "ReloadCommand": "/usr/bin/docker",
    "ReloadArguments": "docker exec nginx nginx -s reload"
  }
}
