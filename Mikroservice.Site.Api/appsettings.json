{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SiteNginxConfig": {
    "ConfDirectory": "/nginx-conf",
    "SnippetsDirectoryName": "snippets",
    "ContainerConfDirectory": "/etc/nginx/conf.d",
    "CertificateDirectory": "/etc/nginx/ssl",
    "CertificateBaseName": "sivas.edu.tr",
    "DomainSuffix": "sivas.edu.tr",
    "ProxyPassUrl": "http://microservice.web:8080",
    "MediaProxyPassUrl": "http://minio:9000/site-media/",

    "TemplateVersion": 2,

    "EnableConfigReload": false,
    "ReloadCommand": "/usr/bin/docker",
    "ReloadArguments": "exec nginx nginx -s reload",
    "ValidateCommand": "/usr/bin/docker",
    "ValidateArguments": "exec nginx nginx -t",
    "ReloadDebounceSeconds": 3,

    "EnableReconcile": true,
    "ReconcileStartupDelaySeconds": 20,
    "ReconcileIntervalMinutes": 30,

    "EnableDistributedLock": true,
    "LockTimeoutSeconds": 60,
    "LockWaitSeconds": 15
  }
}
