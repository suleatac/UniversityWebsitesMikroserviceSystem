        <div class="container">
            <div class="row justify-content-center">
                <div class="col-xl-6 col-lg-8 mb-5">
                    <div class="text-center ">
                        <div class=" text-center">
                            <h2>@T("Haberler ", "News and Activities")</h2>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row news_list">

                <div class=" course_categories carousel_slider owl-carousel owl-theme nav_style1" data-margin="15" data-nav="true" data-dots="true" data-loop="false" data-autoplay="false" data-responsive='{"0":{"items": "1"}, "380":{"items": "1"}, "576":{"items": "3"}, "1000":{"items": "3"}, "1199":{"items": "3"}}'>

                    @foreach (var haberitem in Model.Haberler)
                    {
                        var href = BuildContentHref(haberitem.Link, haberitem.SeoUrl, haberitem.PageType?.Slug);

                        <div class="item">
                            <div class="content_box event_box box_shadow1 animation mb-4 " data-animation="fadeInUp" data-animation-delay="0.02s">
                                <div class="content_img">
                                    <a href="@href"><img src="@haberitem.ResimUrl" alt="@haberitem.Baslik" /></a>
                                </div>
                                <div class="row mx-1">
                                    <div class="event_date">
                                        <h5><span class="event_time bg_default"><span>@haberitem.YayimTarihi.Day.ToString()</span> @haberitem.YayimTarihi.ToString("MMMM")</span></h5>
                                    </div>
                                    <h4 class="content_title"><a href="@href">@haberitem.Baslik</a></h4>
                                </div>
                                <hr />
                                <div class="content_desc bg-white">
                                    <p>@haberitem.KisaAciklama</p>
                                </div>
                            </div>
                        </div>
                    }

                </div>

            </div>
            <div class="row">
                <div class="col-12">
                    <div class="text-center animation" data-animation="fadeInUp" data-animation-delay="0.2s">
                        <div class="medium_divider"></div>
                        <a href="@Model.HaberListUrl" class="btn btn-default rounded-0">@T("Tüm Haberleri Görün", "See All News") <i class="ion-ios-arrow-thin-right ml-1"></i></a>
                    </div>
                </div>
            </div>

        </div>
    </section>
}
<!-- END SECTION NEWS -->

<!-- START SECTION Tanıtım Videoları -->
@if (Model.Videolar.Any())
{
    <section class="small_pt">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-xl-6 col-lg-8">
                    <div class="text-center ">
                        <div class="heading_s1 text-center">
                            <h2>@T("Videolarımız", "Our Videos")</h2>
                        </div>

                    </div>
                </div>
            </div>

            <div class="row">
                @foreach (var item in Model.Videolar)
                {
                    <div class="col-lg-4 col-sm-6">
                        <div class="content_box radius_all_10 box_shadow1 ">
                            <div class="content_img radius_ltrt_10">
                                <div class="">
                                    <div class="overlay_bg_30 about_img ">
                                        <img class="w-100" src="@item.ResimUrl" alt="@item.Baslik" />
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(item.VideoUrl))
                                    {
                                        <a href="@NormalizeVideoUrl(item.VideoUrl)" class="video_popup video_play">
                                            <span class="ripple"><i class="ion-play ml-1"></i></span>
                                        </a>
                                    }
                                </div>
                            </div>
                            <div class="content_desc">
                                <h4 class="content_title">
                                    <a href="@BuildContentHref(item.Link, item.SeoUrl, item.PageType?.Slug)">@item.Baslik</a>
                                </h4>
                                <p>@item.KisaAciklama</p>
                            </div>
                            <div class="content_footer">
                                <div class="price">
                                    <div class="">
                                        @if (!string.IsNullOrWhiteSpace(item.VideoUrl))
                                        {
                                            <a href="@NormalizeVideoUrl(item.VideoUrl)" class="video_popup ">
                                                <span class="alert alert-success">@T("Şimdi İzle", "Watch Now") <i class="fa fa-arrow-circle-right"></i></span>
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

            </div>
            <div class="row">
                <div class="col-12">
                    <div class="text-center ">
                        <div class="medium_divider"></div>
                        <a href="@Model.VideoListUrl" class="btn btn-default">@T("Tüm Videoları Görüntüle", "See All Videos") <i class="ion-ios-arrow-thin-right ml-1"></i></a>
                    </div>
                </div>
            </div>

        </div>
