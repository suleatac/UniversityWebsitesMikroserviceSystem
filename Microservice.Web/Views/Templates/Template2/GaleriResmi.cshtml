@model Microservice.Web.ViewModels.GaleriResim.GaleriResimDetayPageViewModel
@{
    var resim = Model.GaleriResim;

    ViewData["Title"] = resim.SeoTitle ?? resim.Baslik ?? "Galeri Resmi";

    if (!string.IsNullOrWhiteSpace(resim.SeoDescription))
    {
        ViewData["MetaDescription"] = resim.SeoDescription;
    }

    // Detay linki: Link dolu ise dogrudan, bos ise /{dil}/{detay-pageType-slug}/{seoUrl}
    string BuildResimHref(Microservice.Web.ViewModels.GaleriResim.GetGaleriResimVm r)
    {
        if (!string.IsNullOrWhiteSpace(r.Link))
        {
            var link = r.Link.Trim();

            return link.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                ? link
                : "/" + link.Trim('/');
        }

        if (!string.IsNullOrWhiteSpace(r.SeoUrl) && r.PageType is not null)
        {
            return $"/{Model.LanguageCode}/{r.PageType.Slug}/{r.SeoUrl.Trim('/')}";
        }

        return "#";
    }

    // Paylasim linkleri icin mevcut sayfa adresi
    var currentPageUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
    var encodedUrl = Uri.EscapeDataString(currentPageUrl);
    var encodedTitle = Uri.EscapeDataString(resim.Baslik ?? "");

    var kategoriAdi = string.IsNullOrWhiteSpace(resim.Kategori) ? "Genel" : resim.Kategori;
}

<div class="page-title full-color">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="page-title-heading">
                    <h2 class="title">@resim.Baslik</h2>
                </div>
                <div class="breadcrumbs">
                    <ul>
                        <li class="home"><a href="/">Ana Sayfa </a></li>
                        <li><a href="@Model.GaleriResimListUrl">Galeri Resimleri</a></li>
                        <li>\ @resim.Baslik</li>
                    </ul>
                </div>
            </div><!-- /.col-md-12 -->
        </div><!-- /.row -->
    </div><!-- /.container -->
</div><!-- /page-title -->

<section class="flat-row padding-small-v1">
    <div class="container">
        <div class="flat-corporate">
            <div class="row">
                <div class="col-md-8">
                    <div class="post">
                        <div class="thumb-post">
                            @if (!string.IsNullOrWhiteSpace(resim.ResimUrl))
                            {
                                <a href="@resim.ResimUrl" class="fancybox" data-type="image" title="@resim.Baslik">
                                    <img src="@resim.ResimUrl" alt="@resim.Baslik">
                                </a>
                            }
                        </div>
                        <div class="text-post">
                            @if (!string.IsNullOrWhiteSpace(resim.IcerikMetni))
                            {
                                @Html.Raw(resim.IcerikMetni)
                            }
                            else if (!string.IsNullOrWhiteSpace(resim.KisaAciklama))
                            {
                                <p>@resim.KisaAciklama</p>
                            }
                            else
                            {
                                <p>Bu galeri resmi için açıklama girilmemiş.</p>
                            }
                        </div>
                    </div>
                </div>

                <div class="flat-project-post">
                    <div class="col-md-4">
                        <div class="simple-navigation project-navigation">
                            <div class="row">
                                <div class="simple-navigation-item col-md-6 col-sm-6 col-xs-6">
                                    @if (Model.OncekiResim is not null)
                                    {
                                        <a href="@BuildResimHref(Model.OncekiResim)" rel="prev" title="@Model.OncekiResim.Baslik"><i class="fa fa-angle-left"></i>Önceki</a>
                                    }
                                    else
                                    {
                                        <span><i class="fa fa-angle-left"></i>Önceki</span>
                                    }
                                </div>

                                <div class="simple-navigation-item col-md-6 col-sm-6 col-xs-6 text-right">
                                    @if (Model.SonrakiResim is not null)
                                    {
                                        <a href="@BuildResimHref(Model.SonrakiResim)" rel="next" title="@Model.SonrakiResim.Baslik"><i class="fa fa-angle-right pull-right"></i>Sonraki</a>
                                    }
                                    else
                                    {
                                        <span><i class="fa fa-angle-right pull-right"></i>Sonraki</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <h2 class="project-title">@resim.Baslik</h2>
                        @if (!string.IsNullOrWhiteSpace(resim.KisaAciklama))
                        {
                            <div class="project-content-text">
                                <p>@resim.KisaAciklama</p>
                            </div>
                        }

                        <div class="project-meta">
                            <div class="project-meta-item">
                                <div class="small-text">Kategori:</div>
                                <div class="item-meta-value">@kategoriAdi</div>
                            </div>
                            <div class="project-meta-item">
                                <div class="small-text">Yayım Tarihi:</div>
                                <div class="item-meta-value">@resim.YayimTarihi.ToString("dd.MM.yyyy")</div>
                            </div>
                            <div class="project-meta-item">
                                <div class="small-text">Görüntülenme:</div>
                                <div class="item-meta-value">@resim.GosterimSayisi</div>
                            </div>
                        </div>

                        <div class="project-tax small-text">
                            <a href="@Model.GaleriResimListUrl" class="cat-link">@kategoriAdi</a>
                        </div>

                        <ul class="social-list">
                            <li>
                                <a href="https://www.facebook.com/sharer/sharer.php?u=@encodedUrl" target="_blank" rel="noopener" class="social-icon" title="Facebook'ta paylaş">
                                    <i class="fa fa-facebook"></i>
                                </a>
                            </li>
                            <li>
                                <a href="https://twitter.com/intent/tweet?url=@encodedUrl&text=@encodedTitle" target="_blank" rel="noopener" class="social-icon" title="Twitter'da paylaş">
                                    <i class="fa fa-twitter"></i>
                                </a>
                            </li>
                            <li>
                                <a href="https://www.linkedin.com/sharing/share-offsite/?url=@encodedUrl" target="_blank" rel="noopener" class="social-icon" title="LinkedIn'de paylaş">
                                    <i class="fa fa-linkedin"></i>
                                </a>
                            </li>
                            <li>
                                <a href="https://www.pinterest.com/pin/create/button/?url=@encodedUrl&media=@Uri.EscapeDataString(resim.ResimUrl ?? "")&description=@encodedTitle" target="_blank" rel="noopener" class="social-icon" title="Pinterest'te paylaş">
                                    <i class="fa fa-pinterest"></i>
                                </a>
                            </li>
                            <li>
                                <a href="mailto:?subject=@encodedTitle&body=@encodedUrl" class="btn btn-default social-icon" title="E-posta ile gönder">
                                    <i class="fa fa-envelope"></i>
                                </a>
                            </li>
                        </ul>

                        <div class="content-pad calendar-import" style="margin-top:20px;">
                            <a class="flat-button" href="@Model.GaleriResimListUrl">
                                <i class="fa fa-angle-left"></i> TÜM GALERİ RESİMLERİ
                            </a>
                        </div>
                    </div><!-- /col-md-4 -->
                </div><!-- /flat-project-post -->

                @if (Model.IliskiliResimler.Any())
                {
                    <div class="col-md-12">
                        <div class="related-projects">
                            <div class="related-projects-inner">
                                <h4 class="title">İlişkili Resimler</h4>
                                <div class="project-listing">
                                    <div class="project-portfolio">
                                        @foreach (var ilgili in Model.IliskiliResimler)
                                        {
                                            var ilgiliHref = BuildResimHref(ilgili);

                                            <div class="item">
                                                <div class="project-item">
                                                    <div class="item-thumbnail">
                                                        <a href="@ilgiliHref"><img src="@ilgili.ResimUrl" alt="@ilgili.Baslik" loading="lazy"></a>
                                                        <div class="thumbnail-hoverlay main-color-1-bg"></div>
                                                        <div class="thumbnail-hoverlay-icon">
                                                            <a href="@ilgili.ResimUrl" class="fancybox" data-type="image" title="@ilgili.Baslik"><i class="fa fa-search"></i></a>
                                                            <a href="@ilgiliHref" title="@ilgili.Baslik"><i class="fa fa-link"></i></a>
                                                        </div>
                                                    </div><!-- /item-thumbnail -->

                                                    <div class="project-item-content">
                                                        <div class="project-item-title">
                                                            <div class="project-item-title-inner">
                                                                <h4 class="item-title"><a href="@ilgiliHref">@ilgili.Baslik</a></h4>
                                                                <div class="project-item-tax small-text">
                                                                    <a href="@ilgiliHref" class="cat-link">@(string.IsNullOrWhiteSpace(ilgili.Kategori) ? "Genel" : ilgili.Kategori)</a>
                                                                </div>
                                                            </div><!-- /project-item-title-inner -->
                                                        </div><!-- /project-item-title -->

                                                        @if (!string.IsNullOrWhiteSpace(ilgili.KisaAciklama))
                                                        {
                                                            <div class="project-item-excerpt">
                                                                <div class="exerpt-text">@ilgili.KisaAciklama</div>
                                                            </div><!-- /project-item-excerpt -->
                                                        }
                                                    </div><!-- /project-item -->
                                                </div><!-- /project-item -->
                                            </div><!-- /item -->
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div><!-- /row -->
        </div><!-- /flat-corporate -->
    </div><!-- /container -->
</section><!-- /flat-row -->
