@model Microservice.Web.ViewModels.GaleriResim.GaleriResimDetayPageViewModel
@{
    var resim = Model.GaleriResim;

    ViewData["Title"] = resim.SeoTitle ?? resim.Baslik ?? "Galeri Resmi";

    if (!string.IsNullOrWhiteSpace(resim.SeoDescription))
    {
        ViewData["MetaDescription"] = resim.SeoDescription;
    }

    // Detay linki: Link dolu ise dogrudan, bos ise /{dil}/{detay-pageType-slug}/{seoUrl}
    string BuildResimHref(Microservice.Web.ViewModels.GaleriResim.GetGaleriResimVm r)
    {
        if (!string.IsNullOrWhiteSpace(r.Link))
        {
            var link = r.Link.Trim();

            return link.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                ? link
                : "/" + link.Trim('/');
        }

        if (!string.IsNullOrWhiteSpace(r.SeoUrl) && r.PageType is not null)
        {
            return $"/{Model.LanguageCode}/{r.PageType.Slug}/{r.SeoUrl.Trim('/')}";
        }

        return "#";
    }

    // Paylasim linkleri icin mevcut sayfa adresi
    var currentPageUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
    var encodedUrl = Uri.EscapeDataString(currentPageUrl);
    var encodedTitle = Uri.EscapeDataString(resim.Baslik ?? "");

    var kategoriAdi = string.IsNullOrWhiteSpace(resim.Kategori) ? "Genel" : resim.Kategori;
}

@{
    var trCulture = new System.Globalization.CultureInfo("tr-TR");
    var yayinGun = resim.YayimTarihi.Day;
    var yayinAy = resim.YayimTarihi.ToString("MMMM", trCulture);
    var yayinYil = resim.YayimTarihi.Year;
}
<!-- START SECTION BREADCRUMB -->
<section class="page-title-light breadcrumb_section parallax_bg overlay_bg_50" data-parallax-bg-image="/template2/images/bg_altsayfa.jpg">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <div class="page-title">
                    <h1>@resim.Baslik</h1>
                </div>
            </div>
            <div class="col-sm-6">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb justify-content-sm-end">
                        <li class="breadcrumb-item"><a href="/">Ana Sayfa</a></li>
                        <li class="breadcrumb-item"><a href="@Model.GaleriResimListUrl">Galeri Resimleri</a></li>
                        <li class="breadcrumb-item active" aria-current="page">@resim.Baslik</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</section>
<!-- END SECTION BANNER -->

<!-- START SECTION NEW DETAIL -->
<section>
    <div class="container">
        <div class="row">
            <div class="col-lg-9">
                <div class="single_event">
                    <div class="content_img">
                        @if (!string.IsNullOrWhiteSpace(resim.ResimUrl))
                        {
                            <a href="@resim.ResimUrl" target="_blank" rel="noopener" title="Büyütmek için tıklayın">
                                <img src="@resim.ResimUrl" alt="@resim.Baslik">
                            </a>
                        }
                        else
                        {
                            <img src="/template2/images/course_img_big.jpg" alt="@resim.Baslik">
                        }
                        <div class="event_date radius_all_5">
                            <h5><span>@yayinGun</span> @yayinAy</h5>
                            <span class="event_time radius_lbrb_5 bg_default">@yayinYil</span>
                        </div>
                    </div>
                    <div class="event_title">
                        <div class="row align-items-end">
                            <div class="col-md-8">
                                <h2>@resim.Baslik</h2>
                                <ul class="list_none content_meta mt-2">
                                    <li><i class="ti-calendar"></i> <span class="text_default">@resim.YayimTarihi.ToString("dd MMMM yyyy", trCulture)</span></li>
                                    <li><i class="ti-tag"></i><span class="text_default">@kategoriAdi</span></li>
                                    <li><i class="ti-eye"></i><span class="text_default">@resim.GosterimSayisi görüntülenme</span></li>
                                </ul>
                            </div>
                            <div class="col-md-4">
                                <div class="text-md-right">
                                    <ul class="list_none social_icons">
                                        <li>
                                            <a target="_blank" rel="noopener"
                                               href="https://www.facebook.com/sharer/sharer.php?u=@encodedUrl"
                                               title="Facebook'ta paylaş"><i class="ion-social-facebook"></i></a>
                                        </li>
                                        <li>
                                            <a target="_blank" rel="noopener"
                                               href="https://twitter.com/intent/tweet?url=@encodedUrl&text=@encodedTitle"
                                               title="Twitter'da paylaş"><i class="ion-social-twitter"></i></a>
                                        </li>
                                        <li>
                                            <a target="_blank" rel="noopener"
                                               href="https://www.linkedin.com/sharing/share-offsite/?url=@encodedUrl"
                                               title="LinkedIn'de paylaş"><i class="ion-social-linkedin"></i></a>
                                        </li>
                                        <li>
                                            <a href="mailto:?subject=@encodedTitle&body=@encodedUrl"
                                               title="E-posta ile gönder"><i class="ion-email"></i></a>
                                        </li>
                                        <li>
                                            <a href="javascript:void(0)"
                                               id="copy-link-btn"
                                               data-url="@currentPageUrl"
                                               title="Bağlantıyı kopyala"><i class="ion-link"></i></a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="entry_content">
                        @if (!string.IsNullOrWhiteSpace(resim.IcerikMetni))
                        {
                            @Html.Raw(resim.IcerikMetni)
                        }
                        else if (!string.IsNullOrWhiteSpace(resim.KisaAciklama))
                        {
                            <p>@resim.KisaAciklama</p>
                        }
                        else
                        {
                            <p>Bu galeri resmi için açıklama girilmemiş.</p>
                        }
                    </div>

                    @* Onceki / Sonraki gezinme *@
                    <div class="row mt-4">
                        <div class="col-6">
                            @if (Model.OncekiResim is not null)
                            {
                                <a class="btn btn-default" href="@BuildResimHref(Model.OncekiResim)" rel="prev" title="@Model.OncekiResim.Baslik">
                                    <i class="fa fa-angle-left"></i> Önceki
                                </a>
                            }
                            else
                            {
                                <span class="btn btn-default disabled"><i class="fa fa-angle-left"></i> Önceki</span>
                            }
                        </div>
                        <div class="col-6 text-right">
                            @if (Model.SonrakiResim is not null)
                            {
                                <a class="btn btn-default" href="@BuildResimHref(Model.SonrakiResim)" rel="next" title="@Model.SonrakiResim.Baslik">
                                    Sonraki <i class="fa fa-angle-right"></i>
                                </a>
                            }
                            else
                            {
                                <span class="btn btn-default disabled">Sonraki <i class="fa fa-angle-right"></i></span>
                            }
                        </div>
                    </div>

                    <div class="mt-4">
                        <a class="btn btn-default" href="@Model.GaleriResimListUrl">
                            <i class="fa fa-angle-left"></i> TÜM GALERİ RESİMLERİ
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 mt-lg-0 mt-4 pt-3 pt-lg-0">
                <div class="sidebar">
                    <div class="widget widget_search">
                        <form class="search_form" role="search" method="get" action="@Model.GaleriResimListUrl">
                            <input required="" class="form-control" placeholder="Galeride ara..." name="q" type="text">
                            <button type="submit" title="Ara" name="submit" value="Submit">
                                <span class="ti-search"></span>
                            </button>
                        </form>
                    </div>

                    @if (Model.IliskiliResimler.Any())
                    {
                        <div class="widget widget_recent_post">
                            <h5 class="widget_title">İlişkili Resimler</h5>
                            <ul class="recent_post border_bottom_dash list_none">
                                @foreach (var ilgili in Model.IliskiliResimler)
                                {
                                    <li>
                                        <div class="post_footer">
                                            <div class="post_img">
                                                <a href="@BuildResimHref(ilgili)">
                                                    @if (!string.IsNullOrWhiteSpace(ilgili.ResimUrl))
                                                    {
                                                        <img src="@ilgili.ResimUrl" alt="@ilgili.Baslik" loading="lazy">
                                                    }
                                                    else
                                                    {
                                                        <img src="/template2/images/letest_post1.jpg" alt="@ilgili.Baslik" loading="lazy">
                                                    }
                                                </a>
                                            </div>
                                            <div class="post_content">
                                                <h6><a href="@BuildResimHref(ilgili)">@ilgili.Baslik</a></h6>
                                                <span class="post_date">@(string.IsNullOrWhiteSpace(ilgili.Kategori) ? "Genel" : ilgili.Kategori)</span>
                                            </div>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
<!-- END SECTION NEW DETAIL -->

@section Scripts {
    <script type="text/javascript">
        // Baglanti kopyalama butonu
        (function () {
            var btn = document.getElementById('copy-link-btn');
            if (!btn) return;

            btn.addEventListener('click', function () {
                var url = btn.getAttribute('data-url');
                var icon = btn.querySelector('i');
                var originalClass = icon ? icon.className : '';

                function done() {
                    if (icon) icon.className = 'ion-checkmark-round';
                    btn.title = 'Kopyalandı!';
                    setTimeout(function () {
                        if (icon) icon.className = originalClass;
                        btn.title = 'Bağlantıyı kopyala';
                    }, 2000);
                }

                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(url).then(done);
                } else {
                    // Eski tarayicilar icin fallback
                    var input = document.createElement('input');
                    input.value = url;
                    document.body.appendChild(input);
                    input.select();
                    document.execCommand('copy');
                    document.body.removeChild(input);
                    done();
                }
            });
        })();
    </script>
}
