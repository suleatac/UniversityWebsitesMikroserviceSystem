@model Microservice.Web.ViewModels.Template.TemplatePageViewModel
@{
    ViewData["Title"] = Model.Site.SiteAdi;
}

<section class="container py-5">
    <div class="border rounded-4 p-4">
        <h1 class="fw-bold">@Model.Site.SiteAdi</h1>
        <p class="text-secondary">Template 2</p>

        <div class="row g-2 mt-2">
            @foreach (var menu in Model.Menus.OrderBy(x => x.Sira))
            {
                var href = string.IsNullOrWhiteSpace(menu.Link) ? "#" : "/" + menu.Link.Trim('/');
                <div class="col-md-4">
                    <a class="btn btn-outline-dark w-100" href="@href">@menu.Ad</a>
                </div>
            }
        </div>

        @if (Model.Banners.Count > 0)
        {
            <div class="row g-3 mt-4">
                @foreach (var banner in Model.Banners)
                {
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm h-100">
                            @if (!string.IsNullOrWhiteSpace(banner.ResimUrl))
                            {
                                <img src="@banner.ResimUrl" class="card-img-top" alt="@banner.Baslik" />
                            }
                            <div class="card-body">
                                <h6 class="card-title">@banner.Baslik</h6>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <div class="row mt-4 g-4">
            <div class="col-md-6">
                <h5 class="fw-bold">Güncel Haberler</h5>
                <ul class="list-group list-group-flush">
                    @foreach (var haber in Model.Haberler)
                    {
                        <li class="list-group-item">@haber.Baslik</li>
                    }
                </ul>
            </div>
            <div class="col-md-6">
                <h5 class="fw-bold">Güncel Duyurular</h5>
                <ul class="list-group list-group-flush">
                    @foreach (var duyuru in Model.Duyurular)
                    {
                        <li class="list-group-item">@duyuru.Baslik</li>
                    }
                </ul>
            </div>
        </div>
    </div>
</section>