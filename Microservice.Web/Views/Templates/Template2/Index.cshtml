@if (etkinlikListesi != null && etkinlikListesi.Any()) // Null veya boş kontrolü
{
    Etkinlik firstEvent = etkinlikListesi.First();
    <!-- START SECTION ETKİNLİKLER -->
    <section>
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-xl-6 col-lg-8">
                    <div class="text-center">
                        <div class="heading_s1 text-center">
                            <h2>Yaklaşan Etkinlikler</h2>
                        </div>
                        <p>Yaklaşan etkinlikleri aşağıda görebilirsiniz.</p>
                    </div>
                </div>
            </div>
            <div class="row event_list justify-content-center">



                <div class="col-lg-6">
                    <div class="content_box event_box box_shadow1 mb-4 mb-lg-0">
                        <div class="content_img">
                            <a href="@firstEvent.getAdresEtkinlik()" target="@firstEvent.Hedef.tur"><img src="@firstEvent.image_path" alt="@firstEvent.title" /></a>
                        </div>
                        <div class="event_date">
                            <h5><span>@firstEvent.event_date.ToString("dd")</span> @firstEvent.event_date.ToString("MMM")</h5>
                            <span class="event_time bg_default">
                                @(firstEvent.start_time.HasValue && firstEvent.end_time.HasValue
        ? firstEvent.start_time.Value.ToString("dd MMMM HH:mm") + " - " + firstEvent.end_time.Value.ToString("dd MMMM HH:mm")
        : firstEvent.event_date.ToString("YYYY"))
                            </span>

                        </div>
                        <div class="content_desc bg-white">
                            <h4 class="content_title"><a href="@firstEvent.getAdresEtkinlik()" target="@firstEvent.Hedef.tur">@firstEvent.title</a></h4>
                            <ul class="list_none content_meta">
                                <li><i class="ti-location-pin"></i><span class="text_default">@firstEvent.location</span></li>
                            </ul>
                            <p>@firstEvent.description</p>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="row">
                        <div class="col-md-12">
                            @foreach (Etkinlik eventItem in etkinlikListesi.Skip(1))
                            {
                                <div class="content_box event_box box_shadow1">
                                    <div class="event_date">
                                        <h5><span>@eventItem.event_date.ToString("dd")</span> @eventItem.event_date.ToString("MMMM")</h5>
                                        <span class="event_time bg_default">
                                            @(eventItem.start_time.HasValue && eventItem.end_time.HasValue
        ? eventItem.start_time.Value.ToString("dd MMMM HH:mm") + " - " + eventItem.end_time.Value.ToString("dd MMMM HH:mm")
        : eventItem.event_date.ToString("YYYY"))
                                        </span>

                                    </div>
                                    <div class="content_desc bg-white">
                                        <h4 class="content_title"><a href="@eventItem.getAdresEtkinlik()" target="@eventItem.Hedef.tur">@eventItem.title</a></h4>
                                        <ul class="list_none content_meta">
                                            <li><i class="ti-location-pin"></i><span class="text_default">@eventItem.location</span></li>
                                        </ul>
                                        <p>@eventItem.description</p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>
}
