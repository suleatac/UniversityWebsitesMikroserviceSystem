                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 only_events">
                <div class="row justify-content-center">
                    <div class="col-xl-8 col-lg-10">
                        <div class="text-center animation" data-animation="fadeInUp" data-animation-delay="0.01s">
                            <div class="heading_s1 text-center">
                                <h2 class="py-3">@T("İlan Panosu", "For Knowledge")</h2>
                            </div>

                        </div>
                    </div>
                </div>

                <div class="col-lg-12 col-md-6 col-sm-6 animation" data-animation="fadeInUp" data-animation-delay="0.02s">
                    <div class="course_categories carousel_slider owl-carousel owl-theme nav_style1" data-margin="15" data-loop="true" data-nav="true" data-dots="true" data-autoplay="true" data-responsive='{"0":{"items": "1"}, "380":{"items": "1"}, "576":{"items": "1"}, "1000":{"items": "1"}, "1199":{"items": "1"}}'>

                        @foreach (var bilgi in ilanBilgileri)
                        {
                            var bilgiHref = BuildContentHref(bilgi.Link, bilgi.SeoUrl, bilgi.PageType?.Slug);

                            <div class="item">
                                <div class="content_box event_box box_shadow1 animation mb-4 " data-animation="fadeInUp" data-animation-delay="0.02s">
                                    @if (!string.IsNullOrWhiteSpace(bilgi.ResimUrl))
                                    {
                                        <div class="content_img">
                                            <a href="@bilgiHref"><img src="@bilgi.ResimUrl" alt="@bilgi.Baslik" /></a>
                                        </div>
                                    }
                                    <div class="event_date bg-secondary">
                                        <h5 class="text-white">
                                            <span>@bilgi.YayimTarihi.Day</span> @bilgi.YayimTarihi.ToString("MMMM")
                                        </h5>
                                    </div>
                                    <div class="content_desc bg-white">
                                        <h4 class="content_title"><a href="@bilgiHref">@bilgi.Baslik</a></h4>
                                        <hr />
                                        <p>@bilgi.KisaAciklama</p>
                                    </div>
                                </div>
                            </div>
                        }

                    </div>
                </div>

            </div>
        </div>

    </div>
</section>
