@section Scripts {
    @if (Model.Popup != null && !string.IsNullOrWhiteSpace(Model.Popup.ResimUrl))
    {
        <script>
            // Ana sayfa popup'i: CookieIleTekrarGosterme aciksa kapatildiktan sonra 1 gun boyunca gosterilmez.
            (function () {
                var popupEnabled = @Model.Popup.CookieIleTekrarGosterme.ToString().ToLower();
                var cookieName = 'site_popup_@Model.Popup.Id';
                var showSeconds = @Model.Popup.GosterimSuresiSaniye;

                function getCookie(name) {
                    var match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
                    return match ? match[2] : null;
                }

                function setCookie(name, value, days) {
                    var d = new Date();
                    d.setTime(d.getTime() + days * 24 * 60 * 60 * 1000);
                    document.cookie = name + '=' + value + '; expires=' + d.toUTCString() + '; path=/';
                }

                if (getCookie(cookieName)) {
                    return;
                }

                jQuery(function ($) {
                    $('#Login').modal('show');

                    $('#popupKapatmaButonu').on('click', function () {
                        if (popupEnabled) {
                            setCookie(cookieName, '1', 1);
                        }
                    });

                    @if (Model.Popup.GosterimSuresiSaniye > 0)
                    {
                        <text>
                        setTimeout(function () {
                            $('#Login').modal('hide');
                        }, showSeconds * 1000);
                        </text>
                    }
                });
            })();
        </script>
    }

    @if (sosyalMedyaVar && !string.IsNullOrWhiteSpace(facebookAdres))
    {
        <script async defer crossorigin="anonymous" src="https://connect.facebook.net/tr_TR/sdk.js#xfbml=1&version=v13.0"></script>
    }
}
