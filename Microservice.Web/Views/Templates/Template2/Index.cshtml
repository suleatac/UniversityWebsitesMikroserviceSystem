@model Microservice.Web.ViewModels.Template.TemplatePageViewModel
@{
    ViewData["Title"] = Model.Site.SiteAdi;
}

@{
    // Duyuru / Haber / Etkinlik icerikleri icin href uretimi:
    // - Link dolu ise dogrudan o link kullanilir.
    // - Link bos ise bagli oldugu sayfa tipine (PageType) yonlendirilir: /{dil}/{slug}/{seoUrl}


    string BuildContentHref(string? link, string? seoUrl, string? pageTypeSlug)
    {
        if (!string.IsNullOrWhiteSpace(link))
        {
            var trimmedLink = link.Trim();

            return trimmedLink.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                ? trimmedLink
                : "/" + trimmedLink.Trim('/');
        }

        if (!string.IsNullOrWhiteSpace(seoUrl) && !string.IsNullOrWhiteSpace(pageTypeSlug))
        {
            return $"/{Model.LanguageCode}/{pageTypeSlug}/{seoUrl.Trim('/')}";
        }

        return "#";
    }




}




@{
    ViewBag.Title = "Index";
    Layout = $"~/Views/Shared/{ViewBag.TemplateName}/_WebMainLayout.cshtml";
}



@{
    var etkinlikListesi = ViewBag.etkinlikListesi
        as List<DAL.Etkinlik>; // ViewBag'dan Liste'yi çek ve cast et
    Popup popupitem = ViewBag.popupItem as DAL.Popup;
}


<style>
    /* Modal içeriğini ortalamak için */
    .mfp-content {
        max-width: 600px;
    }

    .popup-content {
        text-align: center;
    }

        .popup-content img {
            max-width: 100%;
            cursor: pointer;
        }

    .banner_section .carousel-item {
        cursor: pointer;
    }
</style>
@if (popupitem != null)
{

    <div class="modal fade lr_popup" id="Login" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered " role="document">
            <div class="modal-content border-0">
                <div class="modal-body p-0">
                    <button type="button" id="popupKapatmaButonu" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>

                    <a href="@popupitem.link" class="logo" target="_blank">
                        <img id="popupImage" src="@popupitem.resim_url" alt="" class="img-fluid">
                    </a>

                </div>
            </div>
        </div>
    </div>



}


<div class="news_ticker " style="background-color:#ddd;">
    <div class="container">
        <marquee behavior="scroll" direction="left" onmouseover="this.stop();" onmouseout="this.start();">






            @foreach (Duyuru item in ViewBag.duyuruList)
            {
                <a href="@item.getAdresDuyuru()" target="_blank">@item.baslik</a> <span>||</span>
            }


        </marquee>
    </div>
</div>


<!-- START SECTION BANNER -->
<section class="banner_section p-0 full_screen">
    <div id="carouselExampleControls" class="banner_content_wrap carousel slide" data-ride="carousel">
        <div class="carousel-inner">
            @for (int i = 0; i < ViewBag.bannerListesi.Count; i++)
            {
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <a target="@ViewBag.bannerListesi[i].Hedef.tur" href="@ViewBag.bannerListesi[i].link">
                        <img src="@ViewBag.bannerListesi[i].resim_yol" class="d-block w-100 img-fluid banner-img" alt="Banner Image">
                    </a>
                    <div class="banner_slide_content">
                        <div class="container">
                            <div class="row justify-content-center">
                                <div class="col-lg-12 col-sm-12 text-center">
                                    <div class="banner_content animation text_white"
                                         data-animation="@ViewBag.bannerListesi[i].BannerYaziYon.css_yon"
                                         data-animation-delay="0.2s">
                                        <div class="font-weight-bold animation text-uppercase"
                                             data-animation="@ViewBag.bannerListesi[i].BannerYaziYon.css_yon"
                                             data-animation-delay="0.2s">
                                            @Html.Raw(ViewBag.bannerListesi[i].baslik)
                                        </div>
                                        <div class="animation"
                                             data-animation="@ViewBag.bannerListesi[i].BannerYaziYon.css_yon"
                                             data-animation-delay="1.5s">
                                            @Html.Raw(ViewBag.bannerListesi[i].kisa_aciklama)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <ol class="carousel-indicators">
            @for (int i = 0; i < ViewBag.bannerListesi.Count; i++)
            {
                <li data-target="#carouselExampleControls" data-slide-to="@i" class="@(i == 0 ? "active" : "")"></li>
            }
        </ol>

        <div class="carousel-nav">
            <a class="carousel-control-prev" href="#carouselExampleControls" role="button" data-slide="prev">
                <i class="ion-chevron-left"></i>
            </a>
            <a class="carousel-control-next" href="#carouselExampleControls" role="button" data-slide="next">
                <i class="ion-chevron-right"></i>
            </a>
        </div>
    </div>
</section>
<!-- END SECTION BANNER -->
