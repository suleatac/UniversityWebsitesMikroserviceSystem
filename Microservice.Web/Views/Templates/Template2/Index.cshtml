<!-- START SECTION GALLERY -->
<section>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-6 col-lg-8">
                <div class="text-center ">
                    <div class="heading_s1 text-center">
                        <h2>@(ViewBag.dilObj.id == (int)DilTuru.Ingilizce ? "Our Gallery" : "Galeri")</h2>
                    </div>
                    @if (ViewBag.galeriAciklama != null)
                    {
                        <p>@ViewBag.galeriAciklama</p>
                    }
                    <div class="small_divider"></div>
                </div>
            </div>
        </div>

        @if (ViewBag.galeriKategoriler != null)
        {
            <div class="row">
                <div class="col-md-12 text-center">
                    <ul class="list_none grid_filter ">
                        <li><a href="#" class="current" data-filter="*">@(ViewBag.dilObj.id == (int)DilTuru.Ingilizce ? "all" : "tümü")</a></li>
                        @foreach (var kategori in ViewBag.galeriKategoriler)
                        {
                            <li><a href="#" data-filter=".@kategori.css_sinif">@kategori.ad</a></li>
                        }
                    </ul>
                </div>
            </div>
        }

        @if (ViewBag.galeriItems != null)
        {
            <div class="row">
                <div class="col-md-12">
                    <ul class="grid_container gutter_medium grid_col3 ">
                        <li class="grid-sizer"></li>

                        @foreach (SiteGaleri item in ViewBag.galeriItems)
                        {
                            <li class="grid_item @item.SiteGaleriKategori.css_sinif">
                                <div class="gallery_item radius_all_10">
                                    @if (item.tip == "carousel")
                                    {
                                        <div class="carousel_slider owl-carousel owl-theme dots_white" data-autoplay="true" data-loop="true" data-autoplay-timeout="3000" data-items="1">
                                            @foreach (SiteGaleriResimleri resim in item.SiteGaleriResimleri)
                                            {
                                                <a href="#" class="image_link">
                                                    <img src="@resim.kucuk_resim_url" alt="@resim.alt_text">
                                                </a>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <a href="#" class="image_link">
                                            <img src="@item.galeri_kucuk_resim_url" alt="@item.alt_text">
                                        </a>
                                    }

                                    <div class="gallery_content">
                                        <div class="link_container">


                                            @if (item.tip == "carousel")
                                            {
                                                if (item.SiteGaleriResimleri.Any())
                                                {
                                                    var ilkResim = item.SiteGaleriResimleri.First();
                                                    <a href="@ilkResim.buyuk_resim_url" class="image_popup">
                                                        <span class="ripple"><i class="ion-image"></i></span>
                                                    </a>
                                                    <a href="@(string.IsNullOrEmpty(item.link) ? "javascript:void(0);" : item.link)" class="ml-3">
                                                        <span class="ripple"><i class="ion-link"></i></span>
                                                    </a>
                                                    foreach (SiteGaleriResimleri resim in item.SiteGaleriResimleri.Skip(1))
                                                    {
                                                        <a href="@resim.buyuk_resim_url" class="image_popup d-none"></a>
                                                    }
                                                }
                                            }
                                            else
                                            {

                                                <a href="@item.galeri_buyuk_resim_url" class="image_popup">
                                                    <span class="ripple"><i class="ion-image"></i></span>
                                                </a>
                                                <a href="@(string.IsNullOrEmpty(item.link) ? "javascript:void(0);" : item.link)" class="ml-3">
                                                    <span class="ripple"><i class="ion-link"></i></span>
                                                </a>
                                            }

                                        </div>
                                        <div class="text_holder text_white">
                                            <h5>@item.baslik</h5>
                                        </div>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
    </div>
</section>
<!-- END SECTION GALLERY -->
