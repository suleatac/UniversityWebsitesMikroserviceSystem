<!-- START SOCIAL MEDIA  -->
@if (sosyalMedyaVar)
{
    <style>
        .ScrollBar {
            overflow-y: scroll;
            max-height: 700px;
            text-align: center;
            background-color: #1c1e21;
        }
    </style>
    <section>
        <div class="container">
            <div class="row mb-5">
                <h2 class="mx-auto">@T("Sosyal Medya Paylaşımları", "Social Media Shares")</h2>
            </div>
            <div class="row">
                <div class="col-md-6">
                    @if (!string.IsNullOrWhiteSpace(facebookAdres))
                    {
                        <div class="fb-page" data-href="@facebookAdres" data-hide-cover="false" data-tabs="timeline" data-height="540" data-width="500" data-small-header="true" data-adapt-container-width="true" data-hide-cover="true" data-show-facepile="true"></div>
                        <div id="fb-root"></div>
                    }
                </div>

                <div class="col-md-6">
                    @if (!string.IsNullOrWhiteSpace(instagramAdres))
                    {
                        <div class="row ScrollBar">
                            <iframe class="instagram-media"
                                    src="@instagramAdres.TrimEnd('/')/embed"
                                    width="100%"
                                    height="700"
                                    frameborder="0"
                                    scrolling="no"
                                    allowtransparency="true">
                            </iframe>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
}
<!-- END SOCIAL MEDIA  -->
