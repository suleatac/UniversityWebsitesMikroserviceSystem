                                <div class="event_date bg_default">
                                    <h5 class="text-white"><span>@duyuru.YayimTarihi.Day</span> @duyuru.YayimTarihi.ToString("MMMM")</h5>
                                </div>
                                <div class="content_desc bg-white">
                                    <a href="@BuildContentHref(duyuru.Link, duyuru.SeoUrl, duyuru.PageType?.Slug)"><h4 class="content_title">@duyuru.Baslik</h4></a>
