@model Microservice.Web.ViewModels.Template.TemplatePageViewModel
@{
    ViewData["Title"] = Model.Site.SiteAdi;

    var isEnglish = string.Equals(Model.LanguageCode, "en", StringComparison.OrdinalIgnoreCase);
    string T(string tr, string en) => isEnglish ? en : tr;

    // Site icerik ozellikleri (Hakkimizda, tanitim videosu, sosyal medya adresleri).
    var ozellikler = Model.Site?.SiteOzellikleri;

    // Duyuru / Haber / Etkinlik / Bilgi icerikleri icin href uretimi:
    // - Link dolu ise dogrudan o link kullanilir.
    // - Link bos ise bagli oldugu sayfa tipine (PageType) yonlendirilir: /{dil}/{slug}/{seoUrl}
    string BuildContentHref(string? link, string? seoUrl, string? pageTypeSlug)
    {
        if (!string.IsNullOrWhiteSpace(link))
        {
            var trimmedLink = link.Trim();

            return trimmedLink.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                ? trimmedLink
                : "/" + trimmedLink.Trim('/');
        }

        if (!string.IsNullOrWhiteSpace(seoUrl) && !string.IsNullOrWhiteSpace(pageTypeSlug))
        {
            return $"/{Model.LanguageCode}/{pageTypeSlug}/{seoUrl.Trim('/')}";
        }

        if (!string.IsNullOrWhiteSpace(pageTypeSlug))
        {
            return $"/{Model.LanguageCode}/{pageTypeSlug}";
        }

        return "#";
    }

 

    // Duyurular iki kolona bolunur (eski sol/sag liste gorunumu).
    var solDuyurular = Model.Duyurular.Take((int)Math.Ceiling(Model.Duyurular.Count / 2.0)).ToList();
    var sagDuyurular = Model.Duyurular.Skip(solDuyurular.Count).ToList();

    // İlan Panosu "Bilgiler" icerik tipinden beslenir; BİLGİLER kart bolumu
    // ayni listenin devamini gosterir (gorsel tekrarini onlemek icin dilimlenir).
    var ilanBilgileri = Model.Bilgiler.Take(4).ToList();
    var bilgiKartlari = Model.Bilgiler.Skip(4).Take(3).ToList();

    // Galeri kategori filtrelari icin benzersiz kategoriler ve guvenli css sinifi.
    var galeriKategoriler = Model.GaleriResimler
        .Where(g => !string.IsNullOrWhiteSpace(g.Kategori))
        .Select(g => g.Kategori!)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(k => k)
        .ToList();

    string KategoriSinif(string? kategori)
    {
        var index = galeriKategoriler.FindIndex(
            k => string.Equals(k, kategori, StringComparison.OrdinalIgnoreCase));

        return index >= 0 ? $"galeri-cat-{index}" : "galeri-cat-genel";
    }

    var facebookAdres = ozellikler?.SiteFacebookAdress;
    var instagramAdres = ozellikler?.SiteInstagramAdress;
    var sosyalMedyaVar = !string.IsNullOrWhiteSpace(facebookAdres)
                         || !string.IsNullOrWhiteSpace(instagramAdres);
}

<style>
    /* Modal içeriğini ortalamak için */
    .mfp-content {
        max-width: 600px;
    }

    .popup-content {
        text-align: center;
    }

        .popup-content img {
            max-width: 100%;
            cursor: pointer;
        }

    .banner_section .carousel-item {
        cursor: pointer;
    }
</style>
@if (Model.Popup != null && !string.IsNullOrWhiteSpace(Model.Popup.ResimUrl))
{

    <div class="modal fade lr_popup" id="Login" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered " role="document">
            <div class="modal-content border-0">
                <div class="modal-body p-0">
                    <button type="button" id="popupKapatmaButonu" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>

                    <a href="@(string.IsNullOrWhiteSpace(Model.Popup.Link) ? "javascript:void(0);" : Model.Popup.Link)" class="logo" target="_blank">
                        <img id="popupImage" src="@Model.Popup.ResimUrl" alt="@Model.Popup.Baslik" class="img-fluid">
                    </a>

                </div>
            </div>
        </div>
    </div>

}


<div class="news_ticker " style="background-color:#ddd;">
    <div class="container">
        <marquee behavior="scroll" direction="left" onmouseover="this.stop();" onmouseout="this.start();">

            @foreach (var duyuru in Model.Duyurular)
            {
                <a href="@BuildContentHref(duyuru.Link, duyuru.SeoUrl, duyuru.PageType?.Slug)" target="_blank">@duyuru.Baslik</a> <span>||</span>
            }

        </marquee>
    </div>
</div>


<!-- START SECTION BANNER -->
<section class="banner_section p-0 full_screen">
    <div id="carouselExampleControls"
         class="banner_content_wrap carousel slide"
         data-ride="carousel">

        <div class="carousel-inner">
            @for (int i = 0; i < Model.Banners.Count; i++)
            {
                var banner = Model.Banners[i];

                <div class="carousel-item @(i == 0 ? "active" : "")">

                    <a target="_self"
                       href="@BuildContentHref(banner.Link, banner.SeoUrl, banner.PageType?.Slug)">

                        <img src="@banner.ResimUrl"
                             class="d-block w-100 img-fluid banner-img"
                             alt="@banner.Baslik" />
                    </a>

                    <div class="banner_slide_content">
                        <div class="container">
                            <div class="row justify-content-center">
                                <div class="col-lg-12 col-sm-12 text-center">

                                    <div class="banner_content animation text_white"
                                         data-animation="fadeInUp"
                                         data-animation-delay="0.2s">

                                        <div class="font-weight-bold animation text-uppercase"
                                             data-animation="fadeInUp"
                                             data-animation-delay="0.2s">
                                            @Html.Raw(banner.Baslik)
                                        </div>

                                        <div class="animation"
                                             data-animation="fadeInUp"
                                             data-animation-delay="1.5s">
                                            @Html.Raw(banner.KisaAciklama)
                                        </div>

                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            }
        </div>

        @if (Model.Banners.Count > 1)
        {
            <ol class="carousel-indicators">
                @for (int i = 0; i < Model.Banners.Count; i++)
                {
                    <li data-target="#carouselExampleControls"
                        data-slide-to="@i"
                        class="@(i == 0 ? "active" : "")">
                    </li>
                }
            </ol>

            <div class="carousel-nav">
                <a class="carousel-control-prev"
                   href="#carouselExampleControls"
                   role="button"
                   data-slide="prev">
                    <i class="ion-chevron-left"></i>
                </a>

                <a class="carousel-control-next"
                   href="#carouselExampleControls"
                   role="button"
                   data-slide="next">
                    <i class="ion-chevron-right"></i>
                </a>
            </div>
        }

    </div>
</section>
<!-- END SECTION BANNER -->
<!-- START SECTION CATEGORIES -->
<section class="small_pb">

    <div class="">
        <div class="row">
            <div class="col-12 ">
                <div class="course_categories carousel_slider owl-carousel owl-theme nav_style1" data-margin="15" data-loop="true" data-nav="true" data-dots="false" data-autoplay="true" data-responsive='{"0":{"items": "1"}, "380":{"items": "2"}, "576":{"items": "3"}, "1000":{"items": "5"}, "1199":{"items": "8"}}'>
                    @foreach (var item in Model.ShortcutButtons)
                    {
                        <div class="item">
                            <div class="single_categories">
                                <a href="@(string.IsNullOrWhiteSpace(item.Link) ? "#" : item.Link)">
                                    @if (item.IsIconImage == true)
                                    {
                                        <img class=" mx-auto" style="width:40px;" src="@item.ImageUrl" alt="icon image">
                                    }
                                    else
                                    {
                                        <i class="@item.IconUrl"></i>
                                    }

                                    @item.Ad
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
<!-- END SECTION CATEGORIES -->
<!-- START SECTION EVENT -->
