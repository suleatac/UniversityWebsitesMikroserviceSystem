@model Microservice.Web.ViewModels.Bilgi.BilgiDetayPageViewModel
@{
    var bilgi = Model.Bilgi;

    ViewData["Title"] = bilgi.SeoTitle ?? bilgi.Baslik ?? "Bilgi";

    if (!string.IsNullOrWhiteSpace(bilgi.SeoDescription))
    {
        ViewData["MetaDescription"] = bilgi.SeoDescription;
    }

    // Paylasim linkleri icin mevcut sayfa adresi
    var currentPageUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
    var encodedUrl = Uri.EscapeDataString(currentPageUrl);
    var encodedTitle = Uri.EscapeDataString(bilgi.Baslik ?? "");

    // Detay linki: Link dolu ise dogrudan, bos ise /{dil}/{bilgi-slug}/{seoUrl}
    string BuildBilgiHref(Microservice.Web.ViewModels.Bilgi.GetBilgiVm b)
    {
        if (!string.IsNullOrWhiteSpace(b.Link))
        {
            var link = b.Link.Trim();

            return link.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                ? link
                : "/" + link.Trim('/');
        }

        if (!string.IsNullOrWhiteSpace(b.SeoUrl))
        {
            return $"{Model.BilgiListUrl}/{b.SeoUrl.Trim('/')}";
        }

        return "#";
    }

    var siteOzellikleri = Model.Site?.SiteOzellikleri;
}

@{
    var trCulture = new System.Globalization.CultureInfo("tr-TR");
    var yayinGun = bilgi.YayimTarihi.Day;
    var yayinAy = bilgi.YayimTarihi.ToString("MMMM", trCulture);
    var yayinYil = bilgi.YayimTarihi.Year;
}
<!-- START SECTION BREADCRUMB -->
<section class="page-title-light breadcrumb_section parallax_bg overlay_bg_50" data-parallax-bg-image="/template2/images/bg_altsayfa.jpg">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <div class="page-title">
                    <h1>@bilgi.Baslik</h1>
                </div>
            </div>
            <div class="col-sm-6">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb justify-content-sm-end">
                        <li class="breadcrumb-item"><a href="/">Ana Sayfa</a></li>
                        <li class="breadcrumb-item"><a href="@Model.BilgiListUrl">Bilgiler</a></li>
                        <li class="breadcrumb-item active" aria-current="page">@bilgi.Baslik</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</section>
<!-- END SECTION BANNER -->

<!-- START SECTION NEW DETAIL -->
<section>
    <div class="container">
        <div class="row">
            <div class="col-lg-9">
                <div class="single_event">
                    <div class="content_img">
                        @if (!string.IsNullOrWhiteSpace(bilgi.ResimUrl))
                        {
                            <a href="@bilgi.ResimUrl" target="_blank" rel="noopener">
                                <img src="@bilgi.ResimUrl" alt="@bilgi.Baslik">
                            </a>
                        }
                        else
                        {
                            <img src="/template2/images/course_img_big.jpg" alt="@bilgi.Baslik">
                        }
                        <div class="event_date radius_all_5">
                            <h5><span>@yayinGun</span> @yayinAy</h5>
                            <span class="event_time radius_lbrb_5 bg_default">@yayinYil</span>
                        </div>
                    </div>
                    <div class="event_title">
                        <div class="row align-items-end">
                            <div class="col-md-8">
                                <h2>@bilgi.Baslik</h2>
                                <ul class="list_none content_meta mt-2">
                                    <li><i class="ti-calendar"></i> <span class="text_default">@bilgi.YayimTarihi.ToString("dd MMMM yyyy", trCulture)</span></li>
                                    @if (bilgi.PageType is not null)
                                    {
                                        <li><i class="ti-tag"></i><span class="text_default">@bilgi.PageType.PageTypeKind</span></li>
                                    }
                                    <li><i class="ti-eye"></i><span class="text_default">@bilgi.GosterimSayisi görüntülenme</span></li>
                                </ul>
                            </div>
                            <div class="col-md-4">
                                <div class="text-md-right">
                                    <ul class="list_none social_icons">
                                        <li>
                                            <a target="_blank" rel="noopener"
                                               href="https://www.facebook.com/sharer/sharer.php?u=@encodedUrl"
                                               title="Facebook'ta paylaş"><i class="ion-social-facebook"></i></a>
                                        </li>
                                        <li>
                                            <a target="_blank" rel="noopener"
                                               href="https://twitter.com/intent/tweet?url=@encodedUrl&text=@encodedTitle"
                                               title="Twitter'da paylaş"><i class="ion-social-twitter"></i></a>
                                        </li>
                                        <li>
                                            <a target="_blank" rel="noopener"
                                               href="https://www.linkedin.com/sharing/share-offsite/?url=@encodedUrl"
                                               title="LinkedIn'de paylaş"><i class="ion-social-linkedin"></i></a>
                                        </li>
                                        <li>
                                            <a href="mailto:?subject=@encodedTitle&body=@encodedUrl"
                                               title="E-posta ile gönder"><i class="ion-email"></i></a>
                                        </li>
                                        <li>
                                            <a href="javascript:void(0)"
                                               id="copy-link-btn"
                                               data-url="@currentPageUrl"
                                               title="Bağlantıyı kopyala"><i class="ion-link"></i></a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="entry_content">
                        @if (!string.IsNullOrWhiteSpace(bilgi.IcerikMetni))
                        {
                            @Html.Raw(bilgi.IcerikMetni)
                        }
                        else
                        {
                            <p>Bu bilgi için içerik girilmemiş.</p>
                        }
                    </div>

                    <div class="mt-4">
                        <a class="btn btn-default" href="@Model.BilgiListUrl">
                            <i class="fa fa-angle-left"></i> TÜM BİLGİLER
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 mt-lg-0 mt-4 pt-3 pt-lg-0">
                <div class="sidebar">
                    <div class="widget widget_search">
                        <form class="search_form" role="search" method="get" action="@Model.BilgiListUrl">
                            <input required="" class="form-control" placeholder="Bilgilerde ara..." name="q" type="text">
                            <button type="submit" title="Ara" name="submit" value="Submit">
                                <span class="ti-search"></span>
                            </button>
                        </form>
                    </div>

                    @if (Model.LatestBilgiler.Any())
                    {
                        <div class="widget widget_recent_post">
                            <h5 class="widget_title">Son Eklenenler</h5>
                            <ul class="recent_post border_bottom_dash list_none">
                                @foreach (var item in Model.LatestBilgiler)
                                {
                                    <li>
                                        <div class="post_footer">
                                            <div class="post_img">
                                                <a href="@BuildBilgiHref(item)">
                                                    @if (!string.IsNullOrWhiteSpace(item.ResimUrl))
                                                    {
                                                        <img src="@item.ResimUrl" alt="@item.Baslik" loading="lazy">
                                                    }
                                                    else
                                                    {
                                                        <img src="/template2/images/letest_post1.jpg" alt="@item.Baslik" loading="lazy">
                                                    }
                                                </a>
                                            </div>
                                            <div class="post_content">
                                                <h6><a href="@BuildBilgiHref(item)">@item.Baslik</a></h6>
                                                <span class="post_date">@item.YayimTarihi.ToString("dd MMMM yyyy", trCulture)</span>
                                            </div>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
<!-- END SECTION NEW DETAIL -->

@section Scripts {
    <script type="text/javascript">
        // Baglanti kopyalama butonu
        (function () {
            var btn = document.getElementById('copy-link-btn');
            if (!btn) return;

            btn.addEventListener('click', function () {
                var url = btn.getAttribute('data-url');
                var icon = btn.querySelector('i');
                var originalClass = icon ? icon.className : '';

                function done() {
                    if (icon) icon.className = 'ion-checkmark-round';
                    btn.title = 'Kopyalandı!';
                    setTimeout(function () {
                        if (icon) icon.className = originalClass;
                        btn.title = 'Bağlantıyı kopyala';
                    }, 2000);
                }

                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(url).then(done);
                } else {
                    // Eski tarayicilar icin fallback
                    var input = document.createElement('input');
                    input.value = url;
                    document.body.appendChild(input);
                    input.select();
                    document.execCommand('copy');
                    document.body.removeChild(input);
                    done();
                }
            });
        })();
    </script>
}
