@model Microservice.Web.ViewModels.Search.SearchPageViewModel
@{
    ViewData["Title"] = "Arama Sonuçları";

    // Arama sayfasinin kendi adresi: /{dil}/{search-slug}
    var searchPath = Context.Request.Path.ToString().TrimEnd('/');
    if (string.IsNullOrWhiteSpace(searchPath))
    {
        searchPath = $"/{Model.LanguageCode}/arama";
    }

    // Sayfalama ve tip filtresi icin query uretir.
    string BuildQuery(int pageNumber, int? tip)
    {
        var parts = new List<string>();

        if (Model.HasQuery)
        {
            parts.Add($"q={Uri.EscapeDataString(Model.Query!)}");
        }

        if (tip.HasValue)
        {
            parts.Add($"tip={tip.Value}");
        }

        if (pageNumber > 1)
        {
            parts.Add($"page={pageNumber}");
        }

        return parts.Count == 0 ? "" : "?" + string.Join("&", parts);
    }

    // Icerik detay linki: Link dolu ise dogrudan, bos ise /{dil}/{pageTypeSlug}/{seoUrl}
    string BuildContentHref(Microservice.Web.ViewModels.Icerik.IcerikSearchVm icerik)
    {
        if (!string.IsNullOrWhiteSpace(icerik.Link))
        {
            var link = icerik.Link.Trim();

            return link.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                ? link
                : "/" + link.Trim('/');
        }

        if (!string.IsNullOrWhiteSpace(icerik.SeoUrl) && icerik.PageType is not null)
        {
            return $"/{Model.LanguageCode}/{icerik.PageType.Slug}/{icerik.SeoUrl.Trim('/')}";
        }

        return "#";
    }

    // Filtre butonlari + sidebar secim kutusu icin ortak tip listesi
    var types = new[] {
        new { Value = (int?)null, Label = "Hepsi" },
        new { Value = (int?)1, Label = "Haberler" },
        new { Value = (int?)2, Label = "Duyurular" },
        new { Value = (int?)3, Label = "Bilgiler" },
        new { Value = (int?)4, Label = "Etkinlikler" },
        new { Value = (int?)5, Label = "Videolar" }
    };

    var latestPosts = Model.Results.Data.Take(3).ToList();
    var trCulture = new System.Globalization.CultureInfo("tr-TR");
}

<!-- START SECTION BREADCRUMB -->
<section class="page-title-light breadcrumb_section parallax_bg overlay_bg_50" data-parallax-bg-image="/template2/images/bg_altsayfa.jpg">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <div class="page-title">
                    <h1>Arama Sonuçları</h1>
                </div>
            </div>
            <div class="col-sm-6">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb justify-content-sm-end">
                        <li class="breadcrumb-item"><a href="/">Ana Sayfa</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Arama</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</section>
<!-- END SECTION BREADCRUMB -->

<!-- START SECTION EVENT -->
<section class="small_pt">
    <div class="container">
        <div class="row">
            <div class="col-lg-9">

                <div id="searchResults">

                <!-- KATEGORI/TIP FILTRESI -->
                <div class="text-center mb-4">
                    <ul class="list_none grid_filter">
                        @foreach (var type in types)
                        {
                            var isActive = Model.Tip == type.Value;

                            <li>
                                <a href="@searchPath@BuildQuery(1, type.Value)" data-ajax="true" class="@(isActive ? "current" : "")">@type.Label</a>
                            </li>
                        }
                    </ul>
                </div>

                <!-- SONUC OZETI -->
                @if (Model.HasQuery)
                {
                    <div class="mb-4">
                        <p class="text-default mb-0">
                            <strong>"@Model.Query"</strong> için @Model.Results.TotalCount sonuç bulundu.
                            <a href="@searchPath" data-ajax="true" class="text_default" style="margin-left:10px;text-decoration:underline;">Aramayı temizle</a>
                        </p>
                    </div>
                }

                @if (Model.Results.Data.Any())
                {
                    <div class="row justify-content-center">
                        @foreach (var icerik in Model.Results.Data)
                        {
                            <div class="col-lg-6 col-sm-6 mb-4">
                                <div class="content_box event_box radius_all_10 box_shadow1">
                                    <div class="content_img radius_ltrt_10">
                                        <a href="@BuildContentHref(icerik)">
                                            @if (!string.IsNullOrWhiteSpace(icerik.ResimUrl))
                                            {
                                                <img src="@icerik.ResimUrl" alt="@icerik.Baslik" loading="lazy" />
                                            }
                                            else
                                            {
                                                <img src="/template2/images/event_img1.jpg" alt="@icerik.Baslik" loading="lazy" />
                                            }
                                        </a>
                                        <div class="event_date radius_all_5">
                                            <h5><span>@icerik.YayimTarihi.Day</span> @icerik.YayimTarihi.ToString("MMM", trCulture)</h5>
                                            <span class="event_time radius_lbrb_5 bg_default">@Model.TypeLabel(icerik.Tip)</span>
                                        </div>
                                    </div>
                                    <div class="content_desc">
                                        <h4 class="content_title"><a href="@BuildContentHref(icerik)">@icerik.Baslik</a></h4>
                                        <ul class="list_none content_meta">
                                            <li><i class="ti-calendar"></i> <span class="text_default">@icerik.YayimTarihi.ToString("dd.MM.yyyy", trCulture)</span></li>
                                            <li><i class="ti-tag"></i><span class="text_default">@Model.TypeLabel(icerik.Tip)</span></li>
                                        </ul>
                                        @if (!string.IsNullOrWhiteSpace(icerik.KisaAciklama))
                                        {
                                            <p>@icerik.KisaAciklama</p>
                                        }
                                        <a href="@BuildContentHref(icerik)" class="btn btn-default mt-2">
                                            DETAYLAR <i class="fa fa-angle-right"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- SAYFALAMA -->
                    @if (Model.Results.TotalPages > 1)
                    {
                        // Cok sayfali sonuclarda dar aralik goster (mevcut sayfa etrafi)
                        var startPage = Math.Max(1, Model.Results.Page - 2);
                        var endPage = Math.Min(Model.Results.TotalPages, Model.Results.Page + 2);

                        <div class="row">
                            <div class="col-12">
                                <div class="medium_divider"></div>
                                <ul class="pagination justify-content-center">
                                    @if (Model.Results.HasPrevious)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" href="@searchPath@BuildQuery(Model.Results.Page - 1, Model.Tip)" data-ajax="true" rel="prev">
                                                <i class="ion-ios-arrow-thin-left"></i>
                                            </a>
                                        </li>
                                    }
                                    else
                                    {
                                        <li class="page-item disabled"><span class="page-link"><i class="ion-ios-arrow-thin-left"></i></span></li>
                                    }

                                    @if (startPage > 1)
                                    {
                                        <li class="page-item"><a class="page-link" href="@searchPath@BuildQuery(1, Model.Tip)" data-ajax="true">1</a></li>

                                        if (startPage > 2)
                                        {
                                            <li class="page-item disabled"><span class="page-link">...</span></li>
                                        }
                                    }

                                    @for (var i = startPage; i <= endPage; i++)
                                    {
                                        if (i == Model.Results.Page)
                                        {
                                            <li class="page-item active"><span class="page-link">@i</span></li>
                                        }
                                        else
                                        {
                                            <li class="page-item"><a class="page-link" href="@searchPath@BuildQuery(i, Model.Tip)" data-ajax="true">@i</a></li>
                                        }
                                    }

                                    @if (endPage < Model.Results.TotalPages)
                                    {
                                        if (endPage < Model.Results.TotalPages - 1)
                                        {
                                            <li class="page-item disabled"><span class="page-link">...</span></li>
                                        }

                                        <li class="page-item">
                                            <a class="page-link" href="@searchPath@BuildQuery(Model.Results.TotalPages, Model.Tip)" data-ajax="true">
                                                @Model.Results.TotalPages
                                            </a>
                                        </li>
                                    }

                                    @if (Model.Results.HasNext)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" href="@searchPath@BuildQuery(Model.Results.Page + 1, Model.Tip)" data-ajax="true" rel="next">
                                                <i class="ion-ios-arrow-thin-right"></i>
                                            </a>
                                        </li>
                                    }
                                    else
                                    {
                                        <li class="page-item disabled"><span class="page-link"><i class="ion-ios-arrow-thin-right"></i></span></li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="content_box radius_all_10 box_shadow1 p-4 text-center">
                        <h5 class="mb-2">
                            @if (Model.HasQuery)
                            {
                                <text>Aramanızla eşleşen sonuç bulunamadı.</text>
                            }
                            else
                            {
                                <text>Arama yapmak için bir kelime girin.</text>
                            }
                        </h5>
                        <p class="mb-0">
                            Farklı bir kelime deneyebilir veya yukarıdaki kategori filtrelerinden birini seçerek o türde arama yapabilirsiniz.
                        </p>
                    </div>
                }

                </div><!-- /searchResults -->
            </div>

            <div class="col-lg-3 mt-lg-0 mt-4 pt-3 pt-lg-0">
                <div class="sidebar">
                    <!-- WIDGET SEARCH (tip/kategori secmeli) -->
                    <div class="widget widget_search">
                        <h5 class="widget_title">Arama</h5>
                        <form class="search_form" id="searchForm" role="search" method="get" action="@searchPath">
                            <select class="form-select mb-2" id="searchTipSelect" name="tip" aria-label="Kategori seçin">
                                @foreach (var type in types)
                                {
                                    <option value="@type.Value" selected="@(Model.Tip == type.Value)">@type.Label</option>
                                }
                            </select>
                            <input class="form-control" id="searchQInput" placeholder="Kelime arayın..." name="q" value="@Model.Query" type="text">
                            <button type="submit" title="Ara" name="submit" value="Submit">
                                <span class="ti-search"></span>
                            </button>
                        </form>
                    </div>

                    <!-- WIDGET LATEST POST (mevcut arama sonuclarindan en yeni 3 kayit) -->
                    @if (latestPosts.Any())
                    {
                        <div class="widget widget_recent_post">
                            <h5 class="widget_title">En Son Sonuçlar</h5>
                            <ul class="recent_post border_bottom_dash list_none">
                                @foreach (var icerik in latestPosts)
                                {
                                    <li>
                                        <div class="post_footer">
                                            <div class="post_img">
                                                <a href="@BuildContentHref(icerik)">
                                                    @if (!string.IsNullOrWhiteSpace(icerik.ResimUrl))
                                                    {
                                                        <img src="@icerik.ResimUrl" alt="@icerik.Baslik" loading="lazy">
                                                    }
                                                    else
                                                    {
                                                        <img src="/template2/images/letest_post1.jpg" alt="@icerik.Baslik" loading="lazy">
                                                    }
                                                </a>
                                            </div>
                                            <div class="post_content">
                                                <h6><a href="@BuildContentHref(icerik)">@icerik.Baslik</a></h6>
                                                <span class="post_date">@Model.TypeLabel(icerik.Tip) &middot; @icerik.YayimTarihi.ToString("dd MMMM yyyy", trCulture)</span>
                                            </div>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
<!-- END SECTION EVENT -->

@section Scripts {
    <script type="text/javascript">
        // Kategori butonlari / sayfalama / arama: sayfayi yenilemeden AJAX ile guncellenir.
        (function ($) {
            if (!$) return;

            var $container = $('#searchResults');
            if (!$container.length) return;

            function syncForm(url) {
                try {
                    var u = new URL(url, window.location.origin);
                    $('#searchTipSelect').val(u.searchParams.get('tip') || '');
                    $('#searchQInput').val(u.searchParams.get('q') || '');
                } catch (e) { }
            }

            function loadUrl(url, pushState) {
                $container.css('opacity', 0.45);

                $.get(url)
                    .done(function (html) {
                        var doc = new DOMParser().parseFromString(html, 'text/html');
                        var fresh = doc.querySelector('#searchResults');

                        if (!fresh) {
                            // Kapsayici bulunamazsa normal yonlendirme
                            window.location.href = url;
                            return;
                        }

                        $container.html($(fresh).html()).css('opacity', 1);
                        syncForm(url);

                        if (pushState) {
                            history.pushState({ url: url }, '', url);
                        }
                    })
                    .fail(function () {
                        // Istek hata verirse normal yonlendirme (graceful fallback)
                        window.location.href = url;
                    });
            }

            // data-ajax="true" linkleri: kategori butonlari + sayfalama + aramayi temizle
            $(document).on('click', '#searchResults a[data-ajax]', function (e) {
                var href = $(this).attr('href');
                if (!href || href === '#') return;

                e.preventDefault();
                loadUrl(href, true);
            });

            // Sidebar arama formu
            $('#searchForm').on('submit', function (e) {
                e.preventDefault();

                loadUrl($(this).attr('action') + '?' + $(this).serialize(), true);
            });

            // Tarayici geri/ileri
            $(window).on('popstate', function (ev) {
                var state = ev.originalEvent && ev.originalEvent.state;
                if (state && state.url) {
                    loadUrl(state.url, false);
                }
            });
        })(jQuery);
    </script>
}
