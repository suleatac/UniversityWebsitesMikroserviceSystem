@model Microservice.Web.ViewModels.Content.ContentPageViewModel
@{
    ViewData["Title"] =  Model.Content.Baslik;
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="bg-light border rounded-4 p-4 p-md-5">
                <span class="badge text-bg-secondary mb-3">@Model.ContentType</span>
                <h1 class="mb-3">@Model.Content.Baslik</h1>
                <p class="text-secondary">@Model.Content.KisaAciklama</p>
                <hr />
                <div class="lh-lg">@Html.Raw(Model.Content.IcerikMetni)</div>
                @if (!string.IsNullOrWhiteSpace(Model.Content.VideoUrl))
                {
                    <div class="ratio ratio-16x9 mt-4">
                        <video controls src="@Model.Content.VideoUrl"></video>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
