@model Microservice.Web.ViewModels.Template.TemplatePageViewModel
@{
    ViewData["Title"] = Model.CurrentMenu?.Ad ?? "Menu";
}

<section class="container py-5">
    <div class="p-4 bg-light border rounded-4">
        <h2 class="mb-3">@(Model.CurrentMenu?.Ad ?? "Menu")</h2>
        <p class="small text-muted mb-4">Template 2</p>

        @if (!string.IsNullOrWhiteSpace(Model.CurrentMenu?.Icerik))
        {
            <div>@Model.CurrentMenu!.Icerik</div>
        }
        else
        {
            <p>Bu menü için içerik yok.</p>
        }
    </div>
</section>