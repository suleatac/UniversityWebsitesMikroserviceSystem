@model Microservice.Web.ViewModels.Iletisim.IletisimPageViewModel
@{
    var site = Model.Site;
    var ozellikler = site.SiteOzellikleri;

    ViewData["Title"] = "İletişim";

    // Harita: SiteOzellikleri.SiteHaritaAdress google maps "embed" linki icerir.
    var haritaUrl = ozellikler?.SiteHaritaAdress;
    var haritaVar = !string.IsNullOrWhiteSpace(haritaUrl);

    // Form gonderim adresi ve gonderim sonrasi donus adresi
    var gonderUrl = Url.Action("Gonder", "Iletisim") ?? "/Iletisim/Gonder";
    var returnUrl = Context.Request.Path.ToString() + Context.Request.QueryString;

    string BuildHaberHref(Microservice.Web.ViewModels.Haber.GetHaberVm haber)
    {
        if (!string.IsNullOrWhiteSpace(haber.Link))
        {
            var link = haber.Link.Trim();

            return link.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                ? link
                : "/" + link.Trim('/');
        }

        if (!string.IsNullOrWhiteSpace(haber.SeoUrl) && haber.PageType is not null)
        {
            return $"/{Model.LanguageCode}/{haber.PageType.Slug}/{haber.SeoUrl.Trim('/')}";
        }

        return "#";
    }

    var trCulture = new System.Globalization.CultureInfo("tr-TR");
}

<!-- START SECTION BREADCRUMB -->
<section class="page-title-light breadcrumb_section parallax_bg overlay_bg_50" data-parallax-bg-image="/template2/images/bg_altsayfa.jpg">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <div class="page-title">
                    <h1>İletişim</h1>
                </div>
            </div>
            <div class="col-sm-6">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb justify-content-sm-end">
                        <li class="breadcrumb-item"><a href="/">Ana Sayfa</a></li>
                        <li class="breadcrumb-item active" aria-current="page">İletişim</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</section>
<!-- END SECTION BREADCRUMB -->

<!-- alert mesajlari -->
@if (TempData["IletisimBasari"] is string basariMesaji)
{
    <div class="container" style="margin-top:20px;">
        <div class="alert alert-success" role="alert">
            <i class="fa fa-check-circle"></i> @basariMesaji
        </div>
    </div>
}
@if (TempData["IletisimHata"] is string hataMesaji)
{
    <div class="container" style="margin-top:20px;">
        <div class="alert alert-danger" role="alert">
            <i class="fa fa-exclamation-circle"></i> @hataMesaji
        </div>
    </div>
}

<!-- START SECTION CONTACT -->
<section class="small_pt small_pb">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-6 col-lg-8">
                <div class="text-center animation" data-animation="fadeInUp" data-animation-delay="0.01s">
                    <div class="heading_s1 text-center">
                        <h2>Bize Ulaşın</h2>
                    </div>
                    <p>
                        @if (!string.IsNullOrWhiteSpace(ozellikler?.SiteBaslangicHakkimizda))
                        {
                            @ozellikler.SiteBaslangicHakkimizda
                        }
                        else
                        {
                            <text>Sorularınız ve önerileriniz için aşağıdaki formu doldurarak bize ulaşabilirsiniz.</text>
                        }
                    </p>
                    <div class="small_divider"></div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-9">
                <div class="box_shadow1 radius_all_10">
                    <div class="row no-gutters">
                        <div class="col-md-6 animation" data-animation="fadeInLeft" data-animation-delay="0.02s">
                            <div class="padding_eight_all">
                                <div class="field_form">
                                    <form asp-action="Gonder"
                                          asp-controller="Iletisim"
                                          asp-route-returnUrl="@returnUrl"
                                          method="post"
                                          name="enq"
                                          id="contactform">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden" asp-for="Form.SiteId" />

                                        <div class="row">
                                            <div class="form-group col-12">
                                                <input asp-for="Form.AdSoyad"
                                                       required="required"
                                                       placeholder="Adınız Soyadınız"
                                                       id="first-name"
                                                       class="form-control"
                                                       type="text">
                                                <span asp-validation-for="Form.AdSoyad" class="text-danger small"></span>
                                            </div>
                                            <div class="form-group col-12">
                                                <input asp-for="Form.Eposta"
                                                       required="required"
                                                       placeholder="E-posta Adresiniz"
                                                       id="email"
                                                       class="form-control"
                                                       type="email">
                                                <span asp-validation-for="Form.Eposta" class="text-danger small"></span>
                                            </div>
                                            <div class="form-group col-12">
                                                <input asp-for="Form.Telefon"
                                                       placeholder="Telefon Numaranız (isteğe bağlı)"
                                                       id="phone"
                                                       class="form-control"
                                                       type="tel">
                                                <span asp-validation-for="Form.Telefon" class="text-danger small"></span>
                                            </div>
                                            <div class="form-group col-12">
                                                <input asp-for="Form.Konu"
                                                       required="required"
                                                       placeholder="Konu"
                                                       id="subject"
                                                       class="form-control"
                                                       type="text">
                                                <span asp-validation-for="Form.Konu" class="text-danger small"></span>
                                            </div>
                                            <div class="form-group col-lg-12">
                                                <textarea asp-for="Form.Mesaj"
                                                          required="required"
                                                          placeholder="Mesajınız"
                                                          id="description"
                                                          class="form-control"
                                                          rows="3"></textarea>
                                                <span asp-validation-for="Form.Mesaj" class="text-danger small"></span>
                                            </div>
                                            <div class="col-lg-12">
                                                <button type="submit" title="Mesajınızı Gönderin!" class="btn btn-default" id="submitButton" name="submit" value="Submit">Gönder</button>
                                            </div>
                                            <div class="col-lg-12 text-center">
                                                <div id="alert-msg" class="alert-msg text-center"></div>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 animation" data-animation="fadeInRight" data-animation-delay="0.4s">
                            <div class="contact_map map_radius_rtrb overflow-hidden h-100">
                                @if (haritaVar)
                                {
                                    <iframe src="@haritaUrl"
                                            allowfullscreen=""
                                            loading="lazy"
                                            referrerpolicy="no-referrer-when-downgrade"
                                            title="@site.SiteAdi konumu"></iframe>
                                }
                                else
                                {
                                    <div class="p-5 text-center">
                                        <i class="ion-ios-location-outline display-4 text-muted"></i>
                                        <p class="text-muted mt-3 mb-0">Harita bilgisi tanımlanmamıştır.</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 mt-lg-0 mt-4 pt-3 pt-lg-0">
                <div class="sidebar">
                    <div class="widget widget_search">
                        <form class="search_form" role="search" method="get" action="@Model.SearchUrl">
                            <input class="form-control" placeholder="Arama yap..." name="q" type="text">
                            <button type="submit" title="Ara" name="submit" value="Submit">
                                <span class="ti-search"></span>
                            </button>
                        </form>
                    </div>

                    @if (Model.LatestHabers.Any())
                    {
                        <div class="widget widget_recent_post">
                            <h5 class="widget_title">Son Eklenenler</h5>
                            <ul class="recent_post border_bottom_dash list_none">
                                @foreach (var haber in Model.LatestHabers)
                                {
                                    var haberHref = BuildHaberHref(haber);

                                    <li>
                                        <div class="post_footer">
                                            <div class="post_img">
                                                <a href="@haberHref">
                                                    @if (!string.IsNullOrWhiteSpace(haber.ResimUrl))
                                                    {
                                                        <img src="@haber.ResimUrl" alt="@haber.Baslik" loading="lazy">
                                                    }
                                                    else
                                                    {
                                                        <img src="/template2/images/letest_post1.jpg" alt="@haber.Baslik" loading="lazy">
                                                    }
                                                </a>
                                            </div>
                                            <div class="post_content">
                                                <h6><a href="@haberHref">@haber.Baslik</a></h6>
                                                <span class="post_date">@haber.YayimTarihi.ToString("dd MMMM yyyy", trCulture)</span>
                                            </div>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
<!-- END SECTION CONTACT -->

<!-- START SECTION CONTACT INFO -->
<section class="small_pt">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-6 col-lg-8">
                <div class="text-center animation" data-animation="fadeInUp" data-animation-delay="0.01s">
                    <div class="heading_s1 text-center">
                        <h2>İletişim Bilgileri</h2>
                    </div>
                    <p>@site.SiteAdi</p>
                </div>
            </div>
        </div>
        <div class="row">
            @if (!string.IsNullOrWhiteSpace(ozellikler?.SiteAdress))
            {
                <div class="col-md-4">
                    <div class="overlay_bg_danger_90 icon_box text-center text_white radius_all_10 background_bg animation" data-img-src="/template2/images/address_img.jpg" data-animation="fadeInUp" data-animation-delay="0.02s">
                        <div class="box_icon mb-3">
                            <img src="/template2/images/map_icon.png" alt="map_icon">
                        </div>
                        <div class="intro_desc">
                            <h5>Adres</h5>
                            <p>@ozellikler.SiteAdress</p>
                        </div>
                    </div>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(ozellikler?.SiteTelNo))
            {
                <div class="col-md-4">
                    <div class="overlay_bg_light_green_90 icon_box text-center text_white radius_all_10 background_bg animation" data-img-src="/template2/images/call_img.jpg" data-animation="fadeInUp" data-animation-delay="0.03s">
                        <div class="box_icon mb-3">
                            <img src="/template2/images/phone_icon.png" alt="phone_icon">
                        </div>
                        <div class="intro_desc">
                            <h5>Telefon</h5>
                            <p>
                                <a href="tel:@ozellikler.SiteTelNo.Replace(" ", string.Empty)" class="text-white">@ozellikler.SiteTelNo</a>
                            </p>
                        </div>
                    </div>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(site.SiteEPosta))
            {
                <div class="col-md-4">
                    <div class="overlay_bg_default_90 icon_box text-center text_white radius_all_10 background_bg animation" data-img-src="/template2/images/email_img.jpg" data-animation="fadeInUp" data-animation-delay="0.04s">
                        <div class="box_icon mb-3">
                            <img src="/template2/images/email_icon.png" alt="email_icon">
                        </div>
                        <div class="intro_desc">
                            <h5>E-posta</h5>
                            <p>
                                <a href="mailto:@site.SiteEPosta" class="text-white">@site.SiteEPosta</a>
                            </p>
                        </div>
                    </div>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(ozellikler?.SiteFaxNo))
            {
                <div class="col-md-4">
                    <div class="overlay_bg_danger_90 icon_box text-center text_white radius_all_10 background_bg animation" data-img-src="/template2/images/call_img.jpg" data-animation="fadeInUp" data-animation-delay="0.05s">
                        <div class="box_icon mb-3">
                            <img src="/template2/images/phone_icon.png" alt="fax_icon">
                        </div>
                        <div class="intro_desc">
                            <h5>Faks</h5>
                            <p>@ozellikler.SiteFaxNo</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
<!-- END SECTION CONTACT INFO -->
