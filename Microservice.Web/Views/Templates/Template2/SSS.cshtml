@{
    ViewBag.Title = "sss";
    Layout = $"~/Views/Shared/{ViewBag.TemplateName}/_WebMainLayout.cshtml";
}
@using AnaWebsite.Utility
<!-- START SECTION BREADCRUMB -->
<section class="page-title-light breadcrumb_section parallax_bg overlay_bg_50" data-parallax-bg-image="@setting.getRandomResimYolu(ViewBag.siteobj)">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <div class="page-title">
                    <h1>@(ViewBag.dilObj.id == (int)DilTuru.Ingilizce ? "FAQ" : "Sıkça Sorulan Sorular")</h1>
                </div>
            </div>
            <div class="col-sm-6">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb justify-content-sm-end">
                        <li class="breadcrumb-item"><a href="@(ViewBag.dilObj.id == (int)DilTuru.Ingilizce ? "/en" : "/")"> @(ViewBag.dilObj.id == (int)DilTuru.Ingilizce ? "Main Page" : "Anasayfa")</a></li>

                        <li class="breadcrumb-item active" aria-current="page">@(ViewBag.dilObj.id == (int)DilTuru.Ingilizce ? "FAQ" : "Sıkça Sorulan Sorular")</li>

                    </ol>
                </nav>
            </div>
        </div>
    </div>
</section>
<!-- END SECTION BANNER -->
<!-- START FAQ-->
<section>
    <div class="container">
        <div class="row">
            <div class="col-lg-3 mt-lg-0 mt-4 pt-3 pt-lg-0">
                <div class="sidebar">
                    <div class="widget widget_categories">
                        <h5 class="widget_title"> @(ViewBag.dilObj.id == (int)DilTuru.Ingilizce ? "Categories" : "Soru Kategorileri")</h5>
                        <ul id="kategoriListesi">
                            @foreach (SSSKategori kategori in Model)
                            {
                                <li>
                                    <a href="#" class="kategori-link" data-id="@kategori.id">
                                        <span class="categories_name">@kategori.name</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                </div>
            </div>
            <div class="col-lg-9 col-md-6">
                <div id="sssListe">

                    @*@Html.Partial("GetSssByKategori", new List<SikcaSorulanSorular>())*@
                </div>
            </div>
        </div>
    </div>
</section>
<!-- END FAQ -->
@section scripts {


    <script>
        $(document).ready(function() {
            var firstKategori = $("#kategoriListesi li:first-child a"); // İlk kategoriyi seç
            console.log(firstKategori);

            if (firstKategori.length > 0) {
                var firstKategoriId = firstKategori.data("id");

                // İlk kategoriye ait soruları yükle
                loadSss(firstKategoriId);

                // İlk kategoriyi aktif yap (isteğe bağlı, CSS için)
                firstKategori.addClass("active");
            }

            $(".kategori-link").click(function(e) {
                e.preventDefault();
                var kategoriId = $(this).data("id");

                // AJAX ile kategoriye ait SSS'leri getir
                loadSss(kategoriId);

                // Seçilen kategoriye aktif class ekle (isteğe bağlı)
                $(".kategori-link").removeClass("active");
                $(this).addClass("active");
            });
            var currentDil = '@ViewBag.dilObj?.dil_kisa_adi ?? "tr"';
            function loadSss(kategoriId) {
                $.ajax({
                    url: '@Url.Action("GetSssByKategori")',
                    type: 'GET',
                    data: { kategoriId: kategoriId },
                    success: function(data) {
                        $("#sssListe").html(data);
                    }
                });
            }
        });
    </script>
}


