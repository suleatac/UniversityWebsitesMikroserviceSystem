@model Microservice.Web.ViewModels.Template.TemplatePageViewModel
@{
    ViewData["Title"] = Model.Site.SiteAdi;
}
<!-- START SECTION BANNER AND DUYURULAR -->
<section class="tp-banner-container">
    <!-- START BANNER -->
    <div class="tp-banner">
        <ul>

            @foreach (var banner in Model.Banners)
            {

                <li data-transition="slidedown" data-slotamount="7" data-masterspeed="100" data-saveperformance="on">
                    <img src="@banner.ResimUrl" alt="slider-image">

                    <div class="tp-caption sft desc-slide center color-white color-full" data-x="770" data-y="479" data-speed="100" data-start="100" data-easing="Power3.easeInOut">
                        <div class="title main-color-1 font-2">@banner.Baslik</div>
                        <div class="content">@banner.KisaAciklama</div>
                    </div>

                </li>

            
            }

        </ul>
    </div>
    <!-- END BANNER -->
    <!-- START DUYURULAR -->
    <div class="header-overlay-content header-overlay-scroller">
        <div class="container">
            <div class="row">
                <div class="col-md-5">

                    <section class="un-post-scroller un-post-scroller-2901"
                             data-delay="0">

                        <div class="section-inner-no-padding">

                            <div class="post-scroller-wrap verticalCarousel">
                                <h4 class="title">Duyurular</h4>
                                <div class="post-scroller-carousel">

                                    <div class="post-scroller-carousel-inner verticalCarouselGroup vc_list">

                                        @if (Model.Duyurular != null && Model.Duyurular.Any())
                                        {
                                            var index = 0;

                                            foreach (var duyuru in Model.Duyurular)
                                            {
                                                <div class="item post-scroller-item @(index == 0 ? "active" : "")">

                                                    <div class="scroller-item-inner">

                                                        <div class="scroller-item-content post-item-mini">

                                                            <div class="row">

                                                                <!-- Resim -->
                                                                <div class="col-md-3 col-sm-4 col-xs-4 post-thumbnail-mini">

                                                                    <div class="item-thumbnail">

                                                                        <a href="/duyurular/@duyuru.SeoUrl"
                                                                           title="@duyuru.Baslik">

                                                                            <img src="@duyuru.ResimUrl"
                                                                                 alt="@duyuru.Baslik"
                                                                                 loading="lazy">

                                                                            <div class="thumbnail-hoverlay main-color-1-bg"></div>
                                                                            <div class="thumbnail-hoverlay-cross"></div>

                                                                        </a>

                                                                    </div>

                                                                </div>

                                                                <!-- İçerik -->
                                                                <div class="col-md-9 col-sm-8 col-xs-8 post-content-mini">

                                                                    <h4>
                                                                        <a class="post-title-mini main-color-1-hover"
                                                                           href="/duyurular/@duyuru.SeoUrl"
                                                                           title="@duyuru.Baslik">

                                                                            @duyuru.Baslik

                                                                        </a>
                                                                    </h4>

                                                                    @if (!string.IsNullOrWhiteSpace(duyuru.KisaAciklama))
                                                                    {
                                                                        <div class="post-excerpt-mini">
                                                                            @duyuru.KisaAciklama
                                                                        </div>
                                                                    }

                                                                </div>

                                                            </div>

                                                        </div>

                                                    </div>

                                                </div>

                                                index++;
                                            }
                                        }
                                        else
                                        {
                                            <div class="item post-scroller-item active">
                                                <div class="scroller-item-inner">
                                                    <div class="scroller-item-content post-item-mini">
                                                        <div class="post-content-mini">
                                                            <div class="post-excerpt-mini">
                                                                Henüz duyuru bulunmamaktadır.
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }

                                    </div>

                                </div>

                                <!-- Carousel Kontrolleri -->
                                <div class="verticalCarouselHeader">

                                    <a href="#"
                                       class="vc_goDown btn btn-primary post-scroller-button post-scroller-down">
                                        <i class="fa fa-angle-down"></i>
                                    </a>

                                    <a href="#"
                                       class="vc_goUp btn btn-primary post-scroller-button post-scroller-up">
                                        <i class="fa fa-angle-up"></i>
                                    </a>
                                    <a href="#"
                                       style="float:right;font-weight:600;text-decoration:underline;">
                                        Tümü
                                    </a>
                                </div>

                            </div>

                        </div>

                    </section>

                </div>
            </div>
        </div>
    </div>
    <!-- END DUYURULAR -->
</section>
<!-- END SECTION BANNER AND DUYURULAR -->
<!-- START SECTION SHORTCUT BUTTONS -->
<section class="flat-row padding-top">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="flat-icon">

                    @if (Model.ShortcutButtons != null && Model.ShortcutButtons.Any())
                    {
                        @foreach (var shortcutButton in Model.ShortcutButtons)
                        {
                            <div class="iconbox left v1">
                                <div class="box-header v1">
                                    <i class="@shortcutButton.IconUrl"></i>
                                </div>
                                <div class="icon-post">
                                    <div class="box-title">
                                        <a href="@shortcutButton.Link">@shortcutButton.Ad</a>
                                    </div>
                                    <div class="box-content">
                                        <a href="@shortcutButton.Link">@shortcutButton.KisaAciklama</a>
                                    </div>
                                </div>
                            </div><!-- /.iconbox -->
                        }
                    }




                

                   
                </div><!-- /flat-icon -->
            </div>
        </div>
    </div><!-- /.container -->
</section><!--/flat-row -->
<!-- END SECTION SHORTCUT BUTTONS -->
<!-- START SECTION HAKKINDA -->
@{
    var siteOzellikleri = Model.Site.SiteOzellikleri;
}
<section class="flat-row no-padding">
    <div class="flat-fluid">
        <div class="container">
            <div class="flat-information">
                <div class="row">
                    <div class="col-md-6">
                        <h4 class="title">Sivas Teknoloji ve Transfer Ofisi Hakkında</h4>
                        <p>@siteOzellikleri?.SiteBaslangicHakkimizda</p>
                        <a class="flat-button" href="@siteOzellikleri?.SiteHakkindaLink"><i class="fa fa-leaf"></i>DETAYLARI GÖRÜN</a>
                    </div>

                    <div class="col-md-6">
                        <div class="thumb-information">
                            <img src="@siteOzellikleri?.SiteHakkindaResim" alt="image">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- END SECTION HAKKINDA -->
<!-- START SECTION HABERLER VE ETKİNLİKLER -->
<section class="flat-row flat-ev-carousel">
    <div class="container">
        <div class="row">

            <div class="col-md-9 margin-small">
                <div class="row">
                    <h1 class="title haber">
                        Haberler <a href="#"
                                style="float:right;font-size:15px;text-decoration:underline;padding-top:10px;">
                        Tümü
                    </a>
                </h1>
            </div>

            <div class="flat-carousel v1 style-margin">
                <div class="post-wrap">
                    <div class="posts-carousel v1 v2">
                        <div class="flat-event">
                            <div class="flat-blog-carousel" data-item="3" data-nav="true" data-dots="false" data-auto="true">

                                    
                                @if (Model.Haberler != null && Model.Haberler.Any())
                                {
                                    @foreach (var haber in Model.Haberler)
                                    {

                                        <div class="grid-item">
                                            <div class="grid-item-inner">
                                                <div class="event-item">
                                                    <div class="event-thumbnail">
                                                        <a href="/haberler/@haber.SeoUrl">
                                                            <img src="@haber.ResimUrl" alt="image">
                                                        </a>
                                                    </div><!-- /event-thumbnail -->

                                                    <div class="date-block">
                                                        <div class="month">@haber.YayimTarihi.ToString("MMM")</div>
                                                        <div class="day">@haber.YayimTarihi.ToString("dd")</div>
                                                    </div><!-- /date-block -->

                                                    <div class="event-overlay">
                                                        <div class="cs-post-header">
                                                            <div class="cs-category-links">
                                                                <a class="overlay-top" href="/haberler/@haber.SeoUrl">
                                                                    <h4>@haber.Baslik</h4>
                                                                </a>

                                                                <div class="overlay-footer">
                                                                    <div>@haber.YayimTarihi.ToString("dd.MM.yyyy")</div>
                                                                    <div>@haber.KisaAciklama</div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div><!-- /event-overlay -->
                                                </div>
                                            </div>
                                        </div>


                                    }

                                }

                                    
                                    
                                 





                            </div><!-- /flat-blog-carousel -->
                        </div><!-- /flat-event -->
                    </div><!-- /posts-carousel -->
                </div><!-- /post-wrap -->
            </div><!-- /flat-carousel -->

           
        </div><!-- /col-md-9 -->

        <div class="col-md-3">
            <h4 class="title etkinlik">Etkinlikler</h4>
            <div class="flat-carousel v3">
                <div class="post-wrap">
                    <div class="posts-carousel v1 v4">
                        <div class="flat-event">
                            <div class="flat-blog-carousel" data-item="3" data-nav="true" data-dots="false" data-auto="true">


                                    
                                @if (Model.Etkinlikler != null && Model.Etkinlikler.Any())
                                {
                                    @foreach (var etkinlik in Model.Etkinlikler)
                                    {

                                        <div class="grid-item">
                                            <div class="grid-item-inner">
                                                <div class="event-item">
                                                    <div class="event-thumbnail">
                                                        <a href="@(string.IsNullOrWhiteSpace(etkinlik.SeoUrl) ? "#" : $"/etkinlikler/{etkinlik.SeoUrl}")">
                                                            <img src="@etkinlik.ResimUrl" alt="image">
                                                        </a>
                                                    </div><!-- /event-thumbnail -->

                                                    <div class="date-block">
                                                        <div class="month">@etkinlik.YayimTarihi.ToString("MMM")</div>
                                                        <div class="day">@etkinlik.YayimTarihi.ToString("dd")</div>
                                                    </div><!-- /date-block -->

                                                    <div class="event-overlay">
                                                        <div class="cs-post-header">
                                                            <div class="cs-category-links">
                                                                <a class="overlay-top" href="@(string.IsNullOrWhiteSpace(etkinlik.SeoUrl) ? "#" : $"/etkinlikler/{etkinlik.SeoUrl}")">
                                                                    <h4>@etkinlik.Baslik</h4>
                                                                </a>

                                                                <div class="overlay-footer">
                                                                    <div>At @etkinlik.YayimTarihi.ToString("dd.MM.yyyy")</div>
                                                                    <div>@etkinlik.KisaAciklama</div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div><!-- /event-overlay -->
                                                </div>
                                            </div>
                                        </div>


                                    }

                                }




                                  



                            </div><!-- /flat-blog-carousel -->
                        </div><!-- /flat-event -->
                    </div><!-- /posts-carousel -->
                </div><!-- /post-wrap -->
            </div><!-- /flat-carousel v2 -->
        </div>
    </div><!-- /row -->
</div><!-- /container -->
</section><!-- /page-title -->
<!-- END SECTION HABERLER VE ETKİNLİKLER -->
<!-- START SECTION BİLGİLER -->
<section class="flat-row no-padding">
    <div class="flat-fluid">
        <div class="container">
            <div class="row">



                @if (Model.Bilgiler != null && Model.Bilgiler.Any())
                {
                    @foreach (var bilgi in Model.Bilgiler)
                    {

                        <div class="col-md-4">
                            <div class="post">
                                <h1 class="title">@bilgi.Baslik</h1>
                                <p>@bilgi.KisaAciklama</p>

                                <a class="flat-button button-button_30 btn-default" href="@(string.IsNullOrWhiteSpace(bilgi.Link) ? "#" : bilgi.Link)" data-delay="0">Detayları Görün <i class="fa fa-angle-right"></i></a>
                            </div>
                        </div>


                    }

                }


               
            </div><!--/row-->
        </div><!--/flat-fluid-->
    </div><!--/container-->
</section><!--/flat-row -->
<!-- END SECTION BİLGİLER -->
<!-- START SOSYAL MEDYA PAYLAŞIMLARI -->
<section class="flat-row flat-ev-carousel">

    <div class="container">


        <h4 class="title">Sosyal Medya Paylaşımları</h4>

        <div class="row pt-1">

            <div class="col-md-6">
                <!-- FACEBOOK -->
                <div class="fb-page" data-href="https://www.facebook.com/sivastto" data-hide-cover="false" data-tabs="timeline" data-height="540" data-width="500" data-small-header="true" data-adapt-container-width="true" data-hide-cover="true" data-show-facepile="true"></div>
                <div id="fb-root"></div>
                <!-- END FACEBOOK -->
            </div>

            <div class="col-md-6">
                <!-- INSTAGRAM-->
                <div class="row ScrollBar">
                    <!-- Instagram Embed -->
                    <script async src="//www.instagram.com/embed.js"></script>
                    <iframe class="instagram-media"
                            src="https://www.instagram.com/sivastto/embed"
                            width="100%"
                            height="500"
                            frameborder="0"
                            scrolling="no"
                            allowtransparency="true">
                    </iframe>
                </div>
            </div>
        </div>


    </div>

    <script async defer crossorigin="anonymous" src="https://connect.facebook.net/tr_TR/sdk.js#xfbml=1&version=v13.0" nonce="OPTJJ8lo"></script>';
</section>
<!-- END SOSYAL MEDYA PAYLAŞIMLARI -->
<!-- START SECTION PARALLAX VİDEO-->
<div class="page-title parallax parallax7">
    <div class="flat-video-fancybox">
        <a class="fancybox overlay" data-type="iframe" href="@siteOzellikleri?.SiteBaslangicVideoLink">
            <div class="overlay-inner">
                <i class="fa fa-play"></i>
                <h3 class="title">Üniversitemizde gezinti yapın.</h3>
            </div>
        </a>
    </div>
</div>
<!-- END SECTION PARALLAX VİDEO-->