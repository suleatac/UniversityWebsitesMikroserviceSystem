@model Microservice.Web.ViewModels.Template.TemplatePageViewModel
@{
    ViewData["Title"] = Model.Site.SiteAdi;
}

<div class="container py-4">
    <h1 class="mb-2">@Model.Site.SiteAdi</h1>
    <p class="text-muted mb-4">Template 1</p>

    <h4>Menuler</h4>
    @if (Model.Menus.Count == 0)
    {
        <p>Bu site için menü bulunamadı.</p>
    }
    else
    {
        <ul>
            @foreach (var menu in Model.Menus.OrderBy(x => x.Sira))
            {
                var href = string.IsNullOrWhiteSpace(menu.Link) ? "#" : "/" + menu.Link.Trim('/');
                <li><a href="@href">@menu.Ad</a></li>
            }
        </ul>
    }

    @if (Model.Banners.Count > 0)
    {
        <h4 class="mt-4">Bannerlar</h4>
        <div class="row g-3">
            @foreach (var banner in Model.Banners)
            {
                <div class="col-md-4">
                    <div class="card h-100">
                        @if (!string.IsNullOrWhiteSpace(banner.ResimUrl))
                        {
                            <img src="@banner.ResimUrl" class="card-img-top" alt="@banner.Baslik" />
                        }
                        <div class="card-body">
                            <h5 class="card-title">@banner.Baslik</h5>
                            <p class="card-text small">@banner.KisaAciklama</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="row mt-4">
        <div class="col-md-6">
            <h4>Güncel Haberler</h4>
            @if (Model.Haberler.Count == 0)
            {
                <p>Haber bulunamadı.</p>
            }
            else
            {
                <ul class="list-unstyled">
                    @foreach (var haber in Model.Haberler)
                    {
                        <li class="mb-2">
                            <strong>@haber.Baslik</strong>
                            <div class="text-muted small">@haber.YayimTarihi.ToString("dd.MM.yyyy")</div>
                        </li>
                    }
                </ul>
            }
        </div>
        <div class="col-md-6">
            <h4>Güncel Duyurular</h4>
            @if (Model.Duyurular.Count == 0)
            {
                <p>Duyuru bulunamadı.</p>
            }
            else
            {
                <ul class="list-unstyled">
                    @foreach (var duyuru in Model.Duyurular)
                    {
                        <li class="mb-2">
                            <strong>@duyuru.Baslik</strong>
                            <div class="text-muted small">@duyuru.YayimTarihi.ToString("dd.MM.yyyy")</div>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>