@model Microservice.Web.ViewModels.Search.SearchPageViewModel
@{
    ViewData["Title"] = "Arama Sonuçları";

    // Arama sayfasinin kendi adresi: /{dil}/{search-slug}
    var searchPath = Context.Request.Path.ToString().TrimEnd('/');
    if (string.IsNullOrWhiteSpace(searchPath))
    {
        searchPath = $"/{Model.LanguageCode}/arama";
    }

    // Sayfalama ve tip filtresi icin query uretir.
    string BuildQuery(int pageNumber, int? tip)
    {
        var parts = new List<string>();

        if (Model.HasQuery)
        {
            parts.Add($"q={Uri.EscapeDataString(Model.Query!)}");
        }

        if (tip.HasValue)
        {
            parts.Add($"tip={tip.Value}");
        }

        if (pageNumber > 1)
        {
            parts.Add($"page={pageNumber}");
        }

        return parts.Count == 0 ? "" : "?" + string.Join("&", parts);
    }

    // Icerik detay linki: Link dolu ise dogrudan, bos ise /{dil}/{pageTypeSlug}/{seoUrl}
    string BuildContentHref(Microservice.Web.ViewModels.Icerik.IcerikSearchVm icerik)
    {
        if (!string.IsNullOrWhiteSpace(icerik.Link))
        {
            var link = icerik.Link.Trim();

            return link.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                ? link
                : "/" + link.Trim('/');
        }

        if (!string.IsNullOrWhiteSpace(icerik.SeoUrl) && icerik.PageType is not null)
        {
            return $"/{Model.LanguageCode}/{icerik.PageType.Slug}/{icerik.SeoUrl.Trim('/')}";
        }

        return "#";
    }

    // Filtre butonlari + sidebar dropdown icin ortak tip listesi
    var types = new[] {
        new { Value = (int?)null, Label = "Hepsi" },
        new { Value = (int?)1, Label = "Haberler" },
        new { Value = (int?)2, Label = "Duyurular" },
        new { Value = (int?)3, Label = "Bilgiler" },
        new { Value = (int?)4, Label = "Etkinlikler" },
        new { Value = (int?)5, Label = "Videolar" }
    };

    var latestPosts = Model.Results.Data.Take(3).ToList();
}
<div class="page-title full-color">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="page-title-heading">
                    <h2 class="title">Arama Yap</h2>
                </div>
                <div class="breadcrumbs">
                    <ul>
                        <li class="home"><a href="/">Ana Sayfa </a></li>
                        <li>\ Arama Yap</li>
                    </ul>
                </div>
            </div><!-- /.col-md-12 -->
        </div><!-- /.row -->
    </div><!-- /.container -->
</div><!-- /page-title -->
<section class="flat-row padding-v1">
    <div class="container">
        <div class="row">
            <div id="content" class="col-md-9">

                <!-- FILTER CAT -->
                <div class="project-listing">
                    <div class="filter-cat">
                        @foreach (var type in types)
                        {
                            var isActive = Model.Tip == type.Value;

                            <a href="@searchPath@BuildQuery(1, type.Value)"
                               class="flat-button @(isActive ? "active main-color-1-bg" : "")">
                                @type.Label
                            </a>
                        }
                    </div>
                </div>

                <!-- SONUC OZETI -->
                @if (Model.HasQuery)
                {
                    <div class="item-content" style="margin-bottom:20px;">
                        <p class="main-color-1" style="font-weight:600;margin:0;">
                            "@Model.Query" için @Model.Results.TotalCount sonuç bulundu.
                        </p>
                    </div>
                }

                <!-- SONUCLAR -->
                @if (Model.Results.Data.Any())
                {
                    @foreach (var icerik in Model.Results.Data)
                    {
                        var hasImage = !string.IsNullOrWhiteSpace(icerik.ResimUrl);

                        <div class="event-listing event-listing-classic">
                            <article class="post-item row event-classic-item">
                                @if (hasImage)
                                {
                                    <div class="col-md-4 col-sm-5">
                                        <div class="content-pad">
                                            <div class="item-thumbnail">
                                                <a href="@BuildContentHref(icerik)">
                                                    <img src="@icerik.ResimUrl" alt="@icerik.Baslik" loading="lazy">
                                                    <div class="date-block">
                                                        <div class="month">@icerik.YayimTarihi.ToString("MMM")</div>
                                                        <div class="day">@icerik.YayimTarihi.ToString("dd")</div>
                                                    </div>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                }

                                <div class="@(hasImage ? "col-md-8" : "col-md-12") col-sm-7">
                                    <div class="content-pad">
                                        <div class="item-content">
                                            <h3 class="item-title">
                                                <a href="@BuildContentHref(icerik)" class="main-color-1-hover">@icerik.Baslik</a>
                                            </h3>

                                            <div class="price main-color-1">@Model.TypeLabel(icerik.Tip)</div>

                                            @if (!string.IsNullOrWhiteSpace(icerik.KisaAciklama))
                                            {
                                                <p>@icerik.KisaAciklama</p>
                                            }

                                            <div class="event-time">@icerik.YayimTarihi.ToString("dd.MM.yyyy")</div>
                                        </div>
                                        <div class="item-meta">
                                            <a class="flat-button" href="@BuildContentHref(icerik)">
                                                DETAYLAR <i class="fa fa-angle-right"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </article>
                        </div><!--/event-listing-->
                    }

                    <!-- SAYFALAMA -->
                    @if (Model.Results.TotalPages > 1)
                    {
                        // Cok sayfali sonuclarda dar aralik goster (mevcut sayfa etrafi)
                        var startPage = Math.Max(1, Model.Results.Page - 2);
                        var endPage = Math.Min(Model.Results.TotalPages, Model.Results.Page + 2);

                        <div class="flat-pagination">
                            <ul class="page-numbers clearfix">
                                @if (Model.Results.HasPrevious)
                                {
                                    <li>
                                        <a class="prev page-numbers" href="@searchPath@BuildQuery(Model.Results.Page - 1, Model.Tip)">
                                            <i class="fa fa-angle-left"></i> Önceki
                                        </a>
                                    </li>
                                }

                                @if (startPage > 1)
                                {
                                    <li><a class="page-numbers" href="@searchPath@BuildQuery(1, Model.Tip)">1</a></li>

                                    if (startPage > 2)
                                    {
                                        <li><span class="page-numbers">...</span></li>
                                    }
                                }

                                @for (var i = startPage; i <= endPage; i++)
                                {
                                    if (i == Model.Results.Page)
                                    {
                                        <li><span class="page-numbers current">@i</span></li>
                                    }
                                    else
                                    {
                                        <li><a class="page-numbers" href="@searchPath@BuildQuery(i, Model.Tip)">@i</a></li>
                                    }
                                }

                                @if (endPage < Model.Results.TotalPages)
                                {
                                    if (endPage < Model.Results.TotalPages - 1)
                                    {
                                        <li><span class="page-numbers">...</span></li>
                                    }

                                    <li>
                                        <a class="page-numbers" href="@searchPath@BuildQuery(Model.Results.TotalPages, Model.Tip)">
                                            @Model.Results.TotalPages
                                        </a>
                                    </li>
                                }

                                @if (Model.Results.HasNext)
                                {
                                    <li>
                                        <a class="next page-numbers" href="@searchPath@BuildQuery(Model.Results.Page + 1, Model.Tip)">
                                            Sonraki <i class="fa fa-angle-right"></i>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div><!--/flat-pagination -->
                    }
                }
                else
                {
                    <div class="event-listing event-listing-classic">
                        <article class="post-item row event-classic-item">
                            <div class="col-md-12 col-sm-12">
                                <div class="content-pad">
                                    <div class="item-content">
                                        <h3 class="item-title">
                                            @if (Model.HasQuery)
                                            {
                                                <text>Aramanızla eşleşen sonuç bulunamadı.</text>
                                            }
                                            else
                                            {
                                                <text>Arama yapmak için bir kelime girin.</text>
                                            }
                                        </h3>
                                        <p>
                                            Farklı bir kelime deneyebilir veya yukarıdaki kategori filtrelerinden birini seçerek o türde arama yapabilirsiniz.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </article>
                    </div><!--/event-listing-->
                }
            </div><!-- /col-md-9 -->

            <div class="col-md-3">
                <div class="sidebar">

                    <!-- WIDGET SEARCH -->
                    <div class="widget widget-search">
                        <h2 class="widget-title">SEARCH</h2>
                        <form role="search" method="get" id="searchform" class="u-course-search-form" action="@searchPath">
                            <div class="input-group">
                                <div class="input-group-btn u-course-search-dropdown">
                                    <button type="button"
                                            class="btn btn-default dropdown-toggle u-course-search-dropdown-button"
                                            data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        <span class="button-label">@(types.FirstOrDefault(t => t.Value == Model.Tip)?.Label ?? "Hepsi")</span>
                                        <span class="fa fa-angle-down"></span>
                                    </button>
                                    <ul class="dropdown-menu">
                                        @foreach (var type in types)
                                        {
                                            <li>
                                                <a href="#" data-value="@type.Value?.ToString()">@type.Label</a>
                                            </li>
                                        }
                                    </ul>
                                </div><!-- /btn-group -->

                                <input type="text" value="@Model.Query" name="q" id="s" placeholder="SEARCH" class="form-control">
                                <input type="hidden" name="tip" class="u-course-search-cat" value="@Model.Tip">
                                <span class="input-group-btn">
                                    <button type="submit" id="searchsubmit" class="btn btn-default u-course-search-submit">
                                        <i class="fa fa-search"></i>
                                    </button>
                                </span>
                            </div>
                        </form>
                    </div><!-- /widget-search -->

                    <!-- WIDGET LATEST POST (mevcut arama sonuclarindan en yeni 3 kayit) -->
                    @if (latestPosts.Any())
                    {
                        <div class="widget widget-posts">
                            <div class="blog-box">
                                <h2 class="widget-title">LATEST POST</h2>
                                <ul class="recent-posts clearfix">
                                    @foreach (var icerik in latestPosts)
                                    {
                                        <li>
                                            <div class="thumb item-thumbnail">
                                                <a href="@BuildContentHref(icerik)">
                                                    <img src="@icerik.ResimUrl" alt="@icerik.Baslik" loading="lazy">
                                                    <div class="thumbnail-hoverlay main-color-1-bg"></div>
                                                    <div class="thumbnail-hoverlay-cross"></div>
                                                </a>
                                            </div>
                                            <div class="text">
                                                <a href="@BuildContentHref(icerik)">@icerik.Baslik</a>
                                                <p>@icerik.YayimTarihi.ToString("dd.MM.yyyy")</p>
                                            </div>
                                        </li>
                                    }
                                </ul><!-- /recent-posts -->
                            </div>
                        </div><!-- /widget-posts -->
                    }

                </div><!-- /sidebar -->
            </div><!-- /col-md-3 -->
        </div><!-- /row -->
    </div><!-- /container -->
</section><!-- /flat-row -->

@section Scripts {
    <script type="text/javascript">
        // Sidebar arama widget'indaki tip dropdown'u gizli "tip" alanina baglar.
        (function ($) {
            if (!$) return;

            $('#searchform .u-course-search-dropdown .dropdown-menu a').on('click', function (e) {
                e.preventDefault();

                var value = $(this).data('value');
                var label = $.trim($(this).text());

                $('#searchform .u-course-search-cat').val(value === '' || value === undefined ? '' : value);
                $('#searchform .button-label').text(label);
            });
        })(jQuery);
    </script>
}
