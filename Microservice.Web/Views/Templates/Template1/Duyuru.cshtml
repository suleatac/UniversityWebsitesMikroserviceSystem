@model Microservice.Web.ViewModels.Duyuru.DuyuruDetailVm
@{
    ViewData["Title"] = Model.Baslik ?? "Duyuru";
}

<div class="page-title parallax parallax1">
    <div class="container">
        <div class="flat-university">
            <div class="post">
                <h1 class="title">@(Model.Baslik ?? "Duyuru")</h1>
            </div><!--/post -->
        </div><!--/flat-university -->
    </div><!--/container -->
</div><!--/page-title -->

<section class="flat-row">
    <div class="container">
        @if (!string.IsNullOrWhiteSpace(Model.IcerikMetni))
        {
            <div>@Html.Raw(Model.IcerikMetni)</div>
        }
        else
        {
            <p>Bu duyuru için içerik girilmemiş.</p>
        }
    </div>
</section>