@model Microservice.Web.ViewModels.Content.ContentPageViewModel
@{
    ViewData["Title"] =  Model.Content.Baslik;
}

<main class="container py-5">
    <article class="border-start border-4 border-primary ps-4">
        <p class="text-uppercase text-muted small mb-2">@Model.ContentType</p>
        <h1 class="display-5">@Model.Content.Baslik</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Content.KisaAciklama))
        {
            <p class="lead">@Model.Content.KisaAciklama</p>
        }
        <time class="text-muted" datetime="@Model.Content.YayimTarihi.ToString("O")">
            @Model.Content.YayimTarihi.ToString("dd.MM.yyyy")
        </time>
        <div class="mt-4">@Html.Raw(Model.Content.IcerikMetni)</div>
        @if (!string.IsNullOrWhiteSpace(Model.Content.VideoUrl))
        {
            <video class="w-100 mt-4" controls src="@Model.Content.VideoUrl"></video>
        }
    </article>
</main>
