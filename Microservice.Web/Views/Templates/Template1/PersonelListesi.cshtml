@model Microservice.Web.ViewModels.SitePersonel.PersonelListPageViewModel
@{
    ViewData["Title"] = "Akademik Kadro";

    // Sayfanin kendi adresi: /{dil}/{personeller-slug}
    var listPath = Context.Request.Path.ToString().TrimEnd('/');
    if (string.IsNullOrWhiteSpace(listPath))
    {
        listPath = $"/{Model.LanguageCode}/personeller";
    }

    // Detay linki: /{dil}/{personel-liste-slug}/{seoUrl}
    string BuildPersonelHref(Microservice.Web.ViewModels.SitePersonel.GetPersonelVm d)
    {
    

        if (!string.IsNullOrWhiteSpace(d.SeoUrl) && d.PageType is not null)
        {
            return $"/{Model.LanguageCode}/{d.PageType.Slug}/{d.SeoUrl.Trim('/')}";
        }

        return "#";
    }






    // T.C. harflerini karsiliksiz bas harfe cevir (isotope class'i icin: .a, .b, ...)
    static string FirstLetterClass(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "diger";
        }

        var c = char.ToUpperInvariant(value.Trim()[0]);

        return c switch {
            'Ç' => "c",
            'Ğ' => "g",
            'I' or 'İ' => "i",
            'Ö' => "o",
            'Ş' => "s",
            'Ü' => "u",
            >= 'A' and <= 'Z' => char.ToLowerInvariant(c).ToString(),
            _ => "diger"
        };
    }

    // Listede gercekten bulunan harfler (A-Z filtresi icin)
    var letters = Model.Personeller
        .Select(p => FirstLetterClass(p.Soyadi ?? p.Adi))
        .Distinct()
        .Where(l => l != "diger")
        .OrderBy(l => l)
        .ToList();

    var latestPersoneller = Model.Personeller.Take(3).ToList();
}

<div class="page-title full-color">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="page-title-heading">
                    <h2 class="title">Akademik Kadro</h2>
                </div>
                <div class="breadcrumbs">
                    <ul>
                        <li class="home"><a href="/">Anasayfa</a></li>
                        <li> \ Kadro</li>
                    </ul>
                </div>
            </div><!-- /.col-md-12 -->
        </div><!-- /.row -->
    </div><!-- /.container -->
</div><!-- /page-title -->

<section class="flat-row padding-small-v1">
    <div class="container">
        <div class="row">
            <div class="col-md-9">
                <div class="project-listing">

                    <!-- A-Z HARF FILTRELERI (tema isotope) -->
                    <ul class="filter-cat v2">
                        <li class="active"><a data-filter="*" href="#">All</a></li>
                        @foreach (var letter in letters)
                        {
                            <li><a data-filter=".@letter" href="#">@letter.ToUpper()</a></li>
                        }
                        @if (Model.Personeller.Any(p => FirstLetterClass(p.Soyadi ?? p.Adi) == "diger"))
                        {
                            <li><a data-filter=".diger" href="#">#</a></li>
                        }
                    </ul>

                    <div class="project-portfolio v1">
                        @foreach (var personel in Model.Personeller)
                        {
                            var harf = FirstLetterClass(personel.Soyadi ?? personel.Adi);
                            var adSoyad = $"{personel.Adi} {personel.Soyadi}".Trim();

                            <div class="item @harf arama-es"
                                 data-name="@adSoyad.ToLowerInvariant()">
                                <div class="thumb-item">
                                    <div class="item-thumbnail">
                                        <a href="@BuildPersonelHref(personel)">
                                            <img src="@personel.ResimUrl" alt="@adSoyad" loading="lazy">
                                        </a>
                                    </div><!-- /item-thumbnail -->

                                    <div class="item-content">
                                        <h3 class="item-title">
                                            <a href="@BuildPersonelHref(personel)">@adSoyad</a>
                                        </h3>
                                        <h4 class="small-text">
                                            @personel.UnvanAd@(string.IsNullOrWhiteSpace(personel.PersonelTipAd) ? "" : $" - {personel.PersonelTipAd}")
                                        </h4>
                                        @if (!string.IsNullOrWhiteSpace(personel.Hakkinda))
                                        {
                                            <p>@personel.Hakkinda</p>
                                        }
                                    </div><!-- /item-content -->
                                </div><!-- /thumb-item -->
                            </div><!-- /item -->
                        }
                    </div>

                    <!-- ARAMA SONUCU YOK -->
                    @if (!Model.Personeller.Any())
                    {
                        <p style="padding:20px 0;">Bu sitede görüntülenecek personel bulunmamaktadır.</p>
                    }
                </div>
            </div><!-- /col-md-9 -->

            <div class="col-md-3">
                <div class="sidebar">

                    <!-- WIDGET SEARCH (sayfa ici, client-side filtreleme) -->
                    <div class="widget widget-search">
                        <h2 class="widget-title">Kadro Arama</h2>
                        <form role="search" method="get" id="searchform" class="u-course-search-form" action="@listPath">
                            <div class="input-group">
                                <input type="text" value="@Model.Query" name="q" id="s" placeholder="Ad veya soyad..." class="form-control">
                                <span class="input-group-btn">
                                    <button type="submit" id="searchsubmit" class="btn btn-default u-course-search-submit">
                                        <i class="fa fa-search"></i>
                                    </button>
                                </span>
                            </div>
                        </form>
                    </div><!-- /widget-search -->

                    <!-- WIDGET SON EKLENENLER -->
                    @if (latestPersoneller.Any())
                    {
                        <div class="widget widget-posts">
                            <div class="blog-box">
                                <h2 class="widget-title">SON EKLENENLER</h2>
                                <ul class="recent-posts clearfix">
                                    @foreach (var personel in latestPersoneller)
                                    {
                                        var adSoyad = $"{personel.Adi} {personel.Soyadi}".Trim();

                                        <li>
                                            <div class="thumb item-thumbnail">
                                                <a href="@BuildPersonelHref(personel)">
                                                    <img src="@personel.ResimUrl" alt="@adSoyad" loading="lazy">
                                                    <div class="thumbnail-hoverlay main-color-1-bg"></div>
                                                    <div class="thumbnail-hoverlay-cross"></div>
                                                </a>
                                            </div>
                                            <div class="text">
                                                <a href="@BuildPersonelHref(personel)">@adSoyad</a>
                                                <p>@personel.UnvanAd</p>
                                            </div>
                                        </li>
                                    }
                                </ul><!-- /recent-posts -->
                            </div>
                        </div><!-- /widget-posts -->
                    }

                </div><!-- sidebar -->
            </div><!-- /col-md-3 -->
        </div>
    </div>
</section>

@section Scripts {
    <script type="text/javascript">
        // Sayfa ici arama: ?q=... gelirse veya kutuya yazilirken kartlari isimle filtreler.
        (function ($) {
            if (!$) return;

            var $items = $('.project-portfolio .item');

            function applyFilter(term) {
                term = (term || '').trim().toLocaleLowerCase('tr-TR');

                $items.each(function () {
                    var name = $(this).data('name') || '';
                    $(this).toggle(term === '' || name.indexOf(term) > -1);
                });

                // Isotope varsa yeniden duzenle
                var $container = $('.project-portfolio');
                if ($container.data('isotope')) {
                    $container.isotope();
                }
            }

            // Baslangic filtresi (sunucudan gelen q)
            applyFilter($('#searchform input[name="q"]').val());

            // Yazarken anlik filtreleme
            $('#searchform input[name="q"]').on('input', function () {
                applyFilter($(this).val());
            });
        })(jQuery);
    </script>
}
