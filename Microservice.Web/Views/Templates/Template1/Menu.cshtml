@model Microservice.Web.ViewModels.Template.TemplatePageViewModel
@{
    ViewData["Title"] = Model.CurrentMenu?.Ad ?? "Menu";
}

<div class="page-title parallax parallax1">
    <div class="container">
        <div class="flat-university">
            <div class="post">
                <h1 class="title">@(Model.CurrentMenu?.Ad ?? "Menu")</h1>
            </div><!--/post -->
        </div><!--/flat-university -->
    </div><!--/container -->
</div><!--/page-title -->

<section class="flat-row">
    <div class="container">
        @if (!string.IsNullOrWhiteSpace(Model.CurrentMenu?.Icerik))
        {
            <div>@Html.Raw(Model.CurrentMenu!.Icerik)</div>
        }
        else
        {
            <p>Bu menü için içerik girilmemiş.</p>
        }
    </div>
</section>
