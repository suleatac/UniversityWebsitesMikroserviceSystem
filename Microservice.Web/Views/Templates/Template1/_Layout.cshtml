@using Microservice.Web.ViewModels.BandLogo
@using Microservice.Web.ViewModels.Menu
@using Microservice.Web.ViewModels.Site
<!DOCTYPE html>
<html lang="@(ViewData["LanguageCode"] ?? "tr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" content="Sivas Bilim ve Teknoloji Üniversitesi">
    <title>@ViewData["Title"]</title>

    <!-- Smidge css bundle: tüm template1 css dosyalari Program.cs icinde tanimli -->
    <environment names="Development">
        <link href="template1-css-bundle" rel="stylesheet" debug="true" />
    </environment>
    <environment names="Production">
        <link href="template1-css-bundle" rel="stylesheet" />
    </environment>


    <!-- Colors: switcher.js bu linkin href'ini dinamik olarak degistirdigi icin bundle DISINDA tutuldu -->
    <link id="colors" href="~/template1/css/colors/color1.css" rel="stylesheet" />

    <!-- Favicon and touch icons  -->
    <link href="~/template1/images/sbtu.ico" rel="shortcut icon">
</head>
<body>
    <div class="boxed">
        @await Component.InvokeAsync("MenuTemplate1",
        new {
            siteId = (int)(ViewData["SiteId"] ?? 0),
            dilId = (int)(ViewData["DilId"] ?? 0),
            preloadedMenus = ViewData["Menus"] as List<GetMenuVm>,
            preloadedSite = ViewData["Site"] as SiteDetailGetVm,
            languageCode = ViewData["LanguageCode"] as string,
            searchPageSlug = ViewData["SearchPageSlug"] as string
        })

        
        @RenderBody()



        @await Component.InvokeAsync("FooterTemplate1", new {
            siteId = (int)(ViewData["SiteId"] ?? 0),
            dilId = (int)(ViewData["DilId"] ?? 0),
            preloadedSite = ViewData["Site"] as SiteDetailGetVm,
            languageCode = ViewData["LanguageCode"] as string
        })


        <!-- Javascript: Smidge js bundle (tum template1 js dosyalari Program.cs icinde tanimli) -->
        <environment names="Development">
            <script src="template1-js-bundle" debug="true"></script>
        </environment>
        <environment names="Production">
            <script src="template1-js-bundle"></script>
        </environment>



        <!-- Language translate -->

        <script>
            function googleTranslateElementInit() {
                new google.translate.TranslateElement({
                    pageLanguage: 'tr',
                    includedLanguages: 'en,tr,fr,es,de,ru,el,zh-CN',
                    layout: google.translate.TranslateElement.InlineLayout.SIMPLE,
                    autoDisplay: false
                }, 'google_translate_element');
            }
        </script>

        <script src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

        @await RenderSectionAsync("Scripts", required: false)
    </div>
</body>
</html>
