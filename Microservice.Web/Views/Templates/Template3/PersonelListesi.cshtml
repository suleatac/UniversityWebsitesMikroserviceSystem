@model Microservice.Web.ViewModels.SitePersonel.PersonelListPageViewModel
@{
    ViewData["Title"] = "Akademik Kadro";

    // Sayfanin kendi adresi: /{dil}/{personeller-slug}
    var listPath = Context.Request.Path.ToString().TrimEnd('/');
    if (string.IsNullOrWhiteSpace(listPath))
    {
        listPath = $"/{Model.LanguageCode}/personeller";
    }

    // Detay linki: /{dil}/{personel-liste-slug}/{seoUrl}
    string BuildPersonelHref(Microservice.Web.ViewModels.SitePersonel.GetPersonelVm d)
    {
        if (!string.IsNullOrWhiteSpace(d.SeoUrl) && d.PageType is not null)
        {
            return $"/{Model.LanguageCode}/{d.PageType.Slug}/{d.SeoUrl.Trim('/')}";
        }

        return "#";
    }

    // T.C. harflerini karsiliksiz bas harfe cevir (isotope class'i icin: .a, .b, ...)
    static string FirstLetterClass(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "diger";
        }

        var c = char.ToUpperInvariant(value.Trim()[0]);

        return c switch {
            'Ç' => "c",
            'Ğ' => "g",
            'I' or 'İ' => "i",
            'Ö' => "o",
            'Ş' => "s",
            'Ü' => "u",
            >= 'A' and <= 'Z' => char.ToLowerInvariant(c).ToString(),
            _ => "diger"
        };
    }

    // Listede gercekten bulunan harfler (A-Z filtresi icin)
    var letters = Model.Personeller
        .Select(p => FirstLetterClass(p.Soyadi ?? p.Adi))
        .Distinct()
        .Where(l => l != "diger")
        .OrderBy(l => l)
        .ToList();

    var latestPersoneller = Model.Personeller.Take(3).ToList();
}

<!-- START SECTION BREADCRUMB -->
<section class="page-title-light breadcrumb_section parallax_bg overlay_bg_50" data-parallax-bg-image="/template2/images/bg_altsayfa.jpg">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <div class="page-title">
                    <h1>Akademik Kadro</h1>
                </div>
            </div>
            <div class="col-sm-6">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb justify-content-sm-end">
                        <li class="breadcrumb-item"><a href="/">Ana Sayfa</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Kadro</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</section>
<!-- END SECTION BREADCRUMB -->
<!-- START SECTION TEACHER -->
<section class="small_pt">
    <div class="container">

        <!-- A-Z HARF FILTRELERI + SAYFA ICI ARAMA -->
        <div class="row">
            <div class="col-lg-7 text-center text-lg-left">
                <ul class="list_none grid_filter mb-2">
                    <li><a href="javascript:void(0)" data-letter="*" class="current">Tümü</a></li>
                    @foreach (var letter in letters)
                    {
                        <li><a href="javascript:void(0)" data-letter=".@letter">@letter.ToUpper()</a></li>
                    }
                    @if (Model.Personeller.Any(p => FirstLetterClass(p.Soyadi ?? p.Adi) == "diger"))
                    {
                        <li><a href="javascript:void(0)" data-letter=".diger">#</a></li>
                    }
                </ul>
            </div>
            <div class="col-lg-5">
                <form class="search_form" role="search" method="get" action="@listPath" id="searchform">
                    <input class="form-control" placeholder="Ad veya soyad..." name="q" value="@Model.Query" type="text">
                    <button type="submit" title="Ara" name="submit" value="Submit">
                        <span class="ti-search"></span>
                    </button>
                </form>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-9">
                @if (Model.Personeller.Any())
                {
          


                    <div class="row justify-content-center" id="kadroGrid">
                        @{ var kartNo = 1; }
                        @foreach (var personel in Model.Personeller)
                        {
                            var harf = FirstLetterClass(personel.Soyadi ?? personel.Adi);
                            var adSoyad = $"{personel.Adi} {personel.Soyadi}".Trim();
                            var href = BuildPersonelHref(personel);

                            <div class="col-lg-4 col-sm-6 kadro-kart @harf"
                                 data-harf="@harf"
                                 data-name="@adSoyad.ToLowerInvariant()">
                                <div class="team_box team_style1 box_shadow1 animation" data-animation="fadeInUp" data-animation-delay="@($"{0.01 * kartNo:0.00}s")">
                                    <div class="team_img">
                                        <a href="@href">
                                            <img person-src="@personel.ResimUrl" person-name="@adSoyad" alt="@adSoyad" loading="lazy" />
                                        </a>
                                        <ul class="list_none social_icons social_white">
                                            <li>
                                                <a href="@href" title="@adSoyad profilini görüntüle"><i class="ion-android-contact"></i></a>
                                            </li>
                                            @if (!string.IsNullOrWhiteSpace(personel.UnvanAd))
                                            {
                                                <li>
                                                    <a href="@($"{listPath}?q={Uri.EscapeDataString(personel.UnvanAd)}")" title="@personel.UnvanAd kadrosunda ara"><i class="ion-ios-filing-outline"></i></a>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                    <div class="team_title radius_lbrb_10 text-center">
                                        <h5><a href="@href">@adSoyad</a></h5>
                                        <span>@personel.UnvanAd@(string.IsNullOrWhiteSpace(personel.PersonelTipAd) ? "" : $" - {personel.PersonelTipAd}")</span>
                                    </div>
                                </div>
                            </div>

                            kartNo++;
                        }
                    </div>

                    <p class="text-muted text-center" id="kadroSonucSayisi" style="display:none;"></p>
















                }
                else
                {
                    <div class="content_box radius_all_10 box_shadow1 p-4 text-center">
                        <p class="mb-0">Bu sitede görüntülenecek personel bulunmamaktadır.</p>
                    </div>
                }
            </div>

            <div class="col-lg-3 mt-lg-0 mt-4 pt-3 pt-lg-0">
                <div class="sidebar">
                    @if (latestPersoneller.Any())
                    {
                        <div class="widget widget_recent_post">
                            <h5 class="widget_title">Son Eklenenler</h5>
                            <ul class="recent_post border_bottom_dash list_none">
                                @foreach (var personel in latestPersoneller)
                                {
                                    var adSoyad = $"{personel.Adi} {personel.Soyadi}".Trim();

                                    <li>
                                        <div class="post_footer">
                                            <div class="post_img">
                                                <a href="@BuildPersonelHref(personel)">
                                                    <img person-src="@personel.ResimUrl" person-name="@adSoyad" alt="@adSoyad" loading="lazy" />
                                                </a>
                                            </div>
                                            <div class="post_content">
                                                <h6><a href="@BuildPersonelHref(personel)">@adSoyad</a></h6>
                                                <span class="post_date">@personel.UnvanAd</span>
                                            </div>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
<!-- END SECTION TEACHER -->
@section Scripts {
    <script type="text/javascript">
        // A-Z harf filtresi + ad/soyad aramasi: Bootstrap kartlarini sayfayi yenilemeden filtreler.
        (function($) {
            if (!$) return;

            var $items = $('#kadroGrid .kadro-kart');
            if (!$items.length) return;

            var letterFilter = '*';

            // Filtre sonrasi gosterilen kayit sayisi ozeti
            function updateCount(visible) {
                var $counter = $('#kadroSonucSayisi');
                if (!$counter.length) return;

                if (visible < $items.length) {
                    $counter.text(visible + ' kişi listeleniyor.').show();
                } else {
                    $counter.hide();
                }
            }

            function applyFilters() {
                var term = ($('#searchform input[name="q"]').val() || '').trim().toLocaleLowerCase('tr-TR');
                var letterClass = letterFilter === '*' ? null : letterFilter.replace('.', '');

                var visible = 0;
                $items.each(function() {
                    var $this = $(this);

                    var matchesLetter = letterClass === null || $this.hasClass(letterClass);
                    var name = ($this.attr('data-name') || '').toLocaleLowerCase('tr-TR');
                    var matchesName = term === '' || name.indexOf(term) > -1;

                    var show = matchesLetter && matchesName;
                    $this.toggleClass('d-none', !show);
                    if (show) visible++;
                });

                updateCount(visible);
            }

            // Harf butonlari
            $(document).on('click', '.grid_filter a[data-letter]', function(e) {
                e.preventDefault();

                $('.grid_filter a[data-letter]').removeClass('current');
                $(this).addClass('current');

                letterFilter = $(this).data('letter') || '*';
                applyFilters();
            });

            // Yazarken anlik ad/soyad filtresi
            $('#searchform input[name="q"]').on('input', applyFilters);

            // Baslangic filtresi: sunucudan gelen ?q= degeriyle
            applyFilters();
        })(jQuery);
    </script>
}
