@using Microservice.Web.ViewModels.Menu
@using Microservice.Web.ViewModels.Site
<!DOCTYPE html>
<html lang="@(ViewData["LanguageCode"] ?? "tr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" content="Sivas Bilim ve Teknoloji Üniversitesi">
    <meta name="description" content="Sivas Bilim ve Teknoloji Üniversitesi">
    <meta name="keywords" content="
       academy,
       course,
       university,
       student,
       education,
       elearning,
       learning">

    <title>@ViewData["Title"]</title>
    <!-- Favicon and touch icons  -->
    <link rel="shortcut icon" type="image/x-icon" href="~/template2/images/sbtu.ico" >


    <!-- Animation CSS -->
    <link rel="stylesheet" href="~/template2/css/animate.css">
    <!-- Latest Bootstrap min CSS -->
    <link rel="stylesheet" href="~/template2/bootstrap/css/bootstrap.min.css">
    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css?family=Rubik:300,400,500,700,900" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Roboto:100,100i,300,300i,400,400i,500,500i,700,700i,900,900i" rel="stylesheet">
    <!-- Icon Font CSS -->
    <link rel="stylesheet" href="~/template2/css/ionicons.min.css">
    <link rel="stylesheet" href="~/template2/css/themify-icons.css">
    <!-- FontAwesome CSS -->
    <link rel="stylesheet" href="~/template2/css/all.min.css">
    <!--- owl carousel CSS-->
    <link rel="stylesheet" href="~/template2/owlcarousel/css/owl.carousel.min.css">
    <link rel="stylesheet" href="~/template2/owlcarousel/css/owl.theme.css">
    <link rel="stylesheet" href="~/template2/owlcarousel/css/owl.theme.default.min.css">
    <!-- Magnific Popup CSS -->
    <link rel="stylesheet" href="~/template2/css/magnific-popup.css">
    <!-- Style CSS -->
    <link rel="stylesheet" href="~/template2/css/style.css">
    <link rel="stylesheet" href="~/template2/css/responsive.css">
    <link rel="stylesheet" id="layoutstyle" href="~/template2/color/theme-red.css">




</head>
<body>
    <!-- LOADER -->
    <div id="preloader">
        <span class="spinner"></span>
        <div class="loader-section section-left"></div>
        <div class="loader-section section-right"></div>
    </div>
    <!-- END LOADER -->


        @await Component.InvokeAsync("MenuTemplate2",
        new {
            siteId = (int)(ViewData["SiteId"] ?? 0),
            dilId = (int)(ViewData["DilId"] ?? 0),
            preloadedMenus = ViewData["Menus"] as List<GetMenuVm>,
            preloadedSite = ViewData["Site"] as SiteDetailGetVm,
            languageCode = ViewData["LanguageCode"] as string,
            searchPageSlug = ViewData["SearchPageSlug"] as string
        })

        
        @RenderBody()



        @await Component.InvokeAsync("FooterTemplate2", new {
            siteId = (int)(ViewData["SiteId"] ?? 0),
            dilId = (int)(ViewData["DilId"] ?? 0),
            preloadedSite = ViewData["Site"] as SiteDetailGetVm,
            languageCode = ViewData["LanguageCode"] as string
        })





    <!-- Latest jQuery -->
    <script src="~/template2/js/jquery-1.12.4.min.js"></script>
    <!-- jquery-ui -->
    <script src="~/template2/js/jquery-ui.js"></script>
    <!-- popper min js -->
    <script src="~/template2/js/popper.min.js"></script>
    <!-- Latest compiled and minified Bootstrap -->
    <script src="~/template2/bootstrap/js/bootstrap.min.js"></script>
    <!-- owl-carousel min js  -->
    <script src="~/template2/owlcarousel/js/owl.carousel.min.js"></script>
    <!-- magnific-popup min js  -->
    <script src="~/template2/js/magnific-popup.min.js"></script>
    <!-- waypoints min js  -->
    <script src="~/template2/js/waypoints.min.js"></script>
    <!-- parallax js  -->
    <script src="~/template2/js/parallax.js"></script>
    <!-- countdown js  -->
    <script src="~/template2/js/jquery.countdown.min.js"></script>
    <!-- jquery.counterup.min js -->
    <script src="~/template2/js/jquery.counterup.min.js"></script>
    <!-- imagesloaded js -->
    <script src="~/template2/js/imagesloaded.pkgd.min.js"></script>
    <!-- isotope min js -->
    <script src="~/template2/js/isotope.min.js"></script>
    <!-- jquery.parallax-scroll js -->
    <script src="~/template2/js/jquery.parallax-scroll.js"></script>

    <!-- scripts js -->
    <script src="~/template2/js/scripts.js"></script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-3CP7SPV3PL"></script>




        <!-- Language translate -->

        <script>
                    function googleTranslateElementInit() {
                        new google.translate.TranslateElement({
                            pageLanguage: 'tr',
                            includedLanguages: 'en,tr,fr,es,de,ru,el,zh-CN',
                            layout: google.translate.TranslateElement.InlineLayout.SIMPLE,
                            autoDisplay: false
                        }, 'google_translate_element');
                    }
        </script>

        <script src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

    <script src='https://www.google.com/recaptcha/api.js'></script>





        @await RenderSectionAsync("Scripts", required: false)
 
</body>
</html>
