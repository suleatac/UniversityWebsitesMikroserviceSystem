@model AdayOgrenciBlock


<div class="col-lg-@Model.column_size " style="padding-left:5px;padding-right:5px;min-height:150px; ">
    @if (Model.content_type == "carousel")
    {
        <div class="animation adayOgrenciCarousel" style="padding:5px;" data-animation="@Model.animation" data-animation-delay="0.01s">

            <div class="carousel_slider owl-carousel owl-theme dots_white"
                 data-autoplay="true" data-loop="true" data-autoplay-timeout="3000" data-items="1">
                @foreach (var media in Model.AdayOgrenciBlockMedia)
                {
                    <div class="content_img">
                        <img src="@media.resim_url" alt="carousel_img" loading="lazy" />
                        @if (media.video_url != "")
                        {
                            <a href="@media.video_url" class="video_popup video_play">
                                <span class="ripple"><i class="ion-play ml-1"></i></span>
                            </a>
                        }
                    </div>
                }
            </div>

        </div>
    }
    else if (Model.content_type == "video")
    {

        <div class="icon_box text-start  background_bg animation" data-animation="@Model.animation" data-animation-delay="0.01s">
            <div class="intro_desc" style="background-image: url('@Model.background_resim_url'); background-color: @Model.background_color; background-size: cover; background-position: center;">
                <a href="@Model.video_url" class="video_popup video_play ">
                    <span class="ripple "><i class="ion-play ml-1 text_danger"></i></span>
                </a>
            </div>
        </div>

    }
    else if (Model.content_type == "text")
    {

        <div class="icon_box text-start background_bg animation"
             data-animation="@Model.animation" data-animation-delay="0.01s">
            <div class="intro_desc" style="background-image: url('@Model.background_resim_url'); background-color: @Model.background_color; background-size: cover; background-position: center;">

                @Html.Raw(Model.metin)
            </div>
        </div>

    }
    else if (Model.content_type == "image")
    {

        <div class="icon_box text-start background_bg animation"
             data-animation="@Model.animation" data-animation-delay="0.01s">
            <div class="intro_desc" style="background-image: url('@Model.background_resim_url'); background-color: @Model.background_color; background-size: cover; background-position: center;">

                @Html.Raw(Model.metin)
            </div>
        </div>

    }
    else
    {



    }

    @if (Model.AdayOgrenciBlock1.Any())
    {
        <div class="row">
            @foreach (AdayOgrenciBlock child in Model.AdayOgrenciBlock1.OrderBy(s => s.row_number).ToList())
            {
                @Html.Partial("_AlumniBlockPartial", child)
            }
        </div>
    }

</div>





