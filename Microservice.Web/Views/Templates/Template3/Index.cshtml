@model Microservice.Web.ViewModels.Template.TemplatePageViewModel
@{
    ViewData["Title"] = Model.Site.SiteAdi;
}

<main class="container py-5">
    <div class="p-5 bg-dark text-white rounded-3">
        <p class="text-uppercase small opacity-75">Template 3</p>
        <h1 class="display-4">@Model.Site.SiteAdi</h1>
        <p class="lead">Üniversitenizin güncel içeriklerine ve duyurularına buradan ulaşın.</p>
    </div>

    @if (Model.Banners.Count > 0)
    {
        <div class="row g-3 mt-4">
            @foreach (var banner in Model.Banners)
            {
                <div class="col-md-4">
                    <div class="card bg-secondary bg-opacity-25 text-white border-0 h-100">
                        @if (!string.IsNullOrWhiteSpace(banner.ResimUrl))
                        {
                            <img src="@banner.ResimUrl" class="card-img-top" alt="@banner.Baslik" />
                        }
                        <div class="card-body">
                            <h6 class="card-title">@banner.Baslik</h6>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="row mt-4 g-4">
        <div class="col-md-6">
            <h5>Güncel Haberler</h5>
            <ul class="list-unstyled">
                @foreach (var haber in Model.Haberler)
                {
                    <li class="mb-2 border-bottom border-secondary pb-2">@haber.Baslik</li>
                }
            </ul>
        </div>
        <div class="col-md-6">
            <h5>Güncel Duyurular</h5>
            <ul class="list-unstyled">
                @foreach (var duyuru in Model.Duyurular)
                {
                    <li class="mb-2 border-bottom border-secondary pb-2">@duyuru.Baslik</li>
                }
            </ul>
        </div>
    </div>
</main>
