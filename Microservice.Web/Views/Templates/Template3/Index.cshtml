<!-- END SECTION Akademik Bilgiler -->
<!-- START SECTION TANITIM VİDEOLARI -->
<section class="small_pt">
    <div class="container">

        <div class="row">
            @foreach (Video item in ViewBag.videoList)
            {
                <div class="col-lg-4 col-sm-6">
                    <div class="content_box radius_all_10 box_shadow1 ">
                        <div class="content_img radius_ltrt_10">
                            <div class="">
                                <div class="overlay_bg_30 about_img ">
                                    <img class="w-100" src="@item.image_url" alt="about_img" />
                                </div>
                                @if (item.video_link != null)
                                {
                                    <a href="#" class="video_popup video_play">
                                        <span class="ripple"><i class="ion-play ml-1"></i></span>
                                    </a>
                                }

                            </div>
                        </div>
                        <div class="content_desc">
                            <h4 class="content_title"><a href="#">@item.baslik</a></h4>
                            <hr />
                            <p>@item.video_aciklama</p>
                        </div>
                        <div class="content_footer">
                            <div class="price">
                                <div class="">
                                    <a href="@item.video_link" class="">
                                        <span class="alert alert-success">@(ViewBag.dilObj.id == (int)DilTuru.Ingilizce ? "Detail" : "Detaylı Gör ")<i class="fa fa-arrow-circle-right"></i></span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
<!-- END SECTION TANITIM VİDEOLARI -->
<!-- START SECTION Dinamik Bölümler -->
@if (bolumListesi != null && bolumListesi.Count() > 2)
{
    foreach (var bolum in bolumListesi.Skip(2)) // İlk iki elemanı atla
    {
        if (bolum.AdayOgrenciBlock != null && bolum.AdayOgrenciBlock.Any())
        {
            var hasBackgroundImage = !string.IsNullOrEmpty(bolum.background_image);
            var sectionClass = hasBackgroundImage ? "parallax_bg overlay_bg_blue_70" : "";
            var dataParallaxAttr = hasBackgroundImage ? $"data-parallax-bg-image=\"{bolum.background_image}\"" : "";

            <section class="@sectionClass" style="background-color:@bolum.backgroud_color" @Html.Raw(dataParallaxAttr)>
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-xl-12 col-lg-12">
                            <div class="animation" data-animation="fadeInUp" data-animation-delay="0.2s">
                                <div class="heading_s1">
                                    <h2 class="@(hasBackgroundImage ? "text-white" : "")">@bolum.baslik</h2>
                                </div>
                                <hr style="@(hasBackgroundImage ? "height: 2px; background-color: white;" : "")" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        @foreach (var block in bolum.AdayOgrenciBlock
                            .Where(s => s.parent_id == null)
                            .OrderBy(x => x.row_number))
                        {
                            @Html.Partial("_AlumniBlockPartial", block)
                        }
                    </div>
                </div>
            </section>
        }
    }
}
<!-- END SECTION Dinamik Bölümler -->
<!-- END SECTION Mezunlar ve Öğrencilerimiz -->
<!-- START SECTION Bölümler -->
