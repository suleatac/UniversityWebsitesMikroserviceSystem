@{
    ViewBag.Title = "Index";
    Layout = $"~/Views/Shared/{ViewBag.TemplateName}/_WebMainLayout.cshtml";
}



@using AnaWebsite.Utility


@{
    var bolumListesi = ViewBag.BlockBolumleri
       as List<DAL.AdayOgrenciBlockBolumleri>; // ViewBag'dan Liste'yi çek ve cast et
    var etkinlikListesi = ViewBag.etkinlikListesi
as List<DAL.Etkinlik>; // ViewBag'dan Liste'yi çek ve cast et
    Popup popupitem = ViewBag.popupItem as DAL.Popup;
}


<style>
    /* Modal içeriğini ortalamak için */
    .mfp-content {
        max-width: 600px;
    }

    .popup-content {
        text-align: center;
    }

        .popup-content img {
            max-width: 100%;
            cursor: pointer;
        }

    .banner_section .carousel-item {
        cursor: pointer;
    }
</style>
@if (popupitem != null)
{

    <div class="modal fade lr_popup" id="Login" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered " role="document">
            <div class="modal-content border-0">
                <div class="modal-body p-0">
                    <button type="button" id="popupKapatmaButonu" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>

                    <a href="@popupitem.link" class="logo" target="_blank">
                        <img id="popupImage" src="@popupitem.resim_url" alt="" class="img-fluid">
                    </a>

                </div>
            </div>
        </div>
    </div>



}


<!-- START SECTION VIDEO -->
<section class="banner_section p-0 full_screen_aday_ogrenci position-relative">

    <div class="video-wrapper">
        @if (ViewBag.siteObj.video_type == "YouTube")
        {
            <iframe id="videoIframe"
                    src="@($"https://www.youtube.com/embed/{ViewBag.siteObj.baslangic_video_link}?enablejsapi=1&disablekb=1&controls=0&rel=0&iv_load_policy=3&cc_load_policy=0&playsinline=1&showinfo=0&modestbranding=1&fs=0&mute=1&autoplay=1&loop=1&playlist={ViewBag.siteObj.baslangic_video_link}")"
                    frameborder="0"
                    allow="autoplay;"
                    allowfullscreen
                    class="video-iframe">
            </iframe>
        }
        else
        {
            <video id="localVideo" class="video-iframe" autoplay="true" loop="true" muted="true">
                <source src="@ViewBag.siteObj.baslangic_video_link" type="video/mp4">
                Tarayıcınız video etiketini desteklemiyor.
            </video>
        }
    </div>

    <!-- Butonlar -->
    <div class="video-buttons">
        @if (ViewBag.siteObj.video_type == "YouTube")
        {
            <button id="watchOnYoutube" class="video-btn">🎥 YouTube'da İzle</button>
        }
        <button id="toggleSoundButton" class="video-btn">🔊 Sesi Aç</button>
    </div>

    <a href="#hizli_erisim" class="down down_white page-scroll">
        <span class="mouse"><span></span></span>
    </a>
</section>
<!-- END SECTION VIDEO -->
<!-- START SECTION Hızlı erişim -->
@if (bolumListesi != null && bolumListesi.Any())
{
    AdayOgrenciBlockBolumleri firstBolum = bolumListesi.First();
    if (firstBolum.AdayOgrenciBlock.Any())
    {
        var hasBackgroundImage = !string.IsNullOrEmpty(firstBolum.background_image);
        var sectionClass = hasBackgroundImage ? "parallax_bg overlay_bg_blue_70" : "";
        var dataParallaxAttr = hasBackgroundImage ? $"data-parallax-bg-image=\"{firstBolum.background_image}\"" : "";

        <section class="@sectionClass" style="background-color:@firstBolum.backgroud_color" @Html.Raw(dataParallaxAttr) id="hizli_erisim">

            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-xl-12 col-lg-12">
                        <div class=" animation" data-animation="fadeInUp" data-animation-delay="0.2s">
                            <div class="heading_s1 ">
                                <h2>@firstBolum.baslik</h2>
                            </div>
                            <hr />
                        </div>
                    </div>
                </div>
                <div class="row">
                    @foreach (var block in firstBolum.AdayOgrenciBlock.Where(s => s.parent_id == null).OrderBy(x => x.row_number).ToList()) // Ana satırları çek
                    {
                        @Html.Partial("_AlumniBlockPartial", block)
                    }
                </div>

            </div>
        </section>
    }
}
<!-- END SECTION Hızlı erişim -->
<!-- START SECTION ABOUT -->
<section>
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-5">
                <div class="animation  " data-animation="fadeInLeft" data-animation-delay="0.01s">
                    <img src="@ViewBag.siteObj.hakkinda_resim" alt="about_img2">
                </div>
            </div>
            <div class="col-md-7">
                <div class="padding_eight_all animation fancy_box  " data-animation="fadeInRight" data-animation-delay="0.01s">
                    <div class="heading_s1">
                        <h2>@(ViewBag.dilObj.id == (int)DilTuru.Ingilizce ? "About Us" : "Hakkımızda")</h2>
                    </div>

                    @Html.Raw(ViewBag.siteObj.baslangic_hakkimizda)
                    <a href="@ViewBag.siteObj.hakkinda_link" class="btn btn-outline-black rounded-0 my-2">@(ViewBag.dilObj.id == (int)DilTuru.Ingilizce ? "More" : "Daha Fazla")</a>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- END SECTION ABOUT -->
<!-- START SECTION Akademik Bilgiler -->
@if (bolumListesi != null && bolumListesi.Count() > 1)
{



    var secondBolum = bolumListesi.ElementAt(1); // İkinci elemanı güvenle al
                                                 <!-- START SECTION Akademik Bilgiler -->
    if (secondBolum.AdayOgrenciBlock != null && secondBolum.AdayOgrenciBlock.Any())
    {
        var hasBackgroundImage = !string.IsNullOrEmpty(secondBolum.background_image);
        var sectionClass = hasBackgroundImage ? "parallax_bg overlay_bg_blue_70" : "";
        var dataParallaxAttr = hasBackgroundImage ? $"data-parallax-bg-image=\"{secondBolum.background_image}\"" : "";

        <section class="@sectionClass" style="background-color:@secondBolum.backgroud_color" @Html.Raw(dataParallaxAttr)>
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-xl-12 col-lg-12">
                        <div class=" animation" data-animation="fadeInUp" data-animation-delay="0.2s">
                            <div class="heading_s1 ">
                                <h2 class="text-white"> @secondBolum.baslik</h2>
                            </div>
                            <hr style="height: 2px;  background-color: white; " />
                        </div>
                    </div>
                </div>
                <div class="row">
                    @foreach (AdayOgrenciBlock block in secondBolum.AdayOgrenciBlock.Where(s => s.parent_id == null).OrderBy(x => x.row_number).ToList()) // Ana satırları çek
