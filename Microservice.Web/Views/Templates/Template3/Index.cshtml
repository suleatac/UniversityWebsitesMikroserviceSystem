@model Microservice.Web.ViewModels.Template.TemplatePageViewModel
@{
    ViewData["Title"] = Model.Site.SiteAdi;

    var isEnglish = string.Equals(Model.LanguageCode, "en", StringComparison.OrdinalIgnoreCase);
    string T(string tr, string en) => isEnglish ? en : tr;

    // Site icerik ozellikleri (Hakkimizda, tanitim videosu).
    var ozellikler = Model.Site?.SiteOzellikleri;

    // Dinamik bolumler: ilk bolum eski yapidaki gibi "Hızlı Erişim" anchor'i ile
    // About'on ustunde; kalan bolumlar About/Tanitim videolari arasinda siralanir.
    var ilkBolum = Model.Sections.FirstOrDefault();
    var digerBolumler = Model.Sections.Skip(ilkBolum is null ? 0 : 1).ToList();

    // Galeri kategori filtrelari icin benzersiz kategoriler ve guvenli css sinifi.
    var galeriKategoriler = Model.GaleriResimler
        .Where(g => !string.IsNullOrWhiteSpace(g.Kategori))
        .Select(g => g.Kategori!)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(k => k)
        .ToList();

    string KategoriSinif(string? kategori)
    {
        var index = galeriKategoriler.FindIndex(
            k => string.Equals(k, kategori, StringComparison.OrdinalIgnoreCase));

        return index >= 0 ? $"galeri-cat-{index}" : "galeri-cat-genel";
    }

    // Duyuru / Bilgi icerikleri icin href uretimi:
    // - Link dolu ise dogrudan o link kullanilir.
    // - Link bos ise bagli oldugu sayfa tipine (PageType) yonlendirilir: /{dil}/{slug}/{seoUrl}
    string BuildContentHref(string? link, string? seoUrl, string? pageTypeSlug)
    {
        if (!string.IsNullOrWhiteSpace(link))
        {
            var trimmedLink = link.Trim();

            return trimmedLink.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                ? trimmedLink
                : "/" + trimmedLink.Trim('/');
        }

        if (!string.IsNullOrWhiteSpace(seoUrl) && !string.IsNullOrWhiteSpace(pageTypeSlug))
        {
            return $"/{Model.LanguageCode}/{pageTypeSlug}/{seoUrl.Trim('/')}";
        }

        if (!string.IsNullOrWhiteSpace(pageTypeSlug))
        {
            return $"/{Model.LanguageCode}/{pageTypeSlug}";
        }

        return "#";
    }

    // Tema JS'i (magnific-popup) popup linklerinde yalnizca watch?v= / youtu.be
    // formatlarini tanir; embed formatli linkler popup'ta acilmiyor.
    // Bu yuzden YouTube ID'yi her formattan (ID, embed/, shorts/, youtu.be/)
    // cikarip temanin sorunsuz acabildigi canonical watch?v={id} adresine ceviriyoruz.
    // ID bulunamazsa (mp4 vb.) adres oldugu gibi birakilir.
    string NormalizeVideoUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            return url ?? string.Empty;
        }

        // Zaten watch?v= ya da youtu.be formatinda ise dokunma.
        if (url.Contains("watch?v", StringComparison.OrdinalIgnoreCase)
            || url.Contains("youtu.be/", StringComparison.OrdinalIgnoreCase))
        {
            return url;
        }

        var id = ExtractYouTubeId(url);
        return id is not null ? $"https://www.youtube.com/watch?v={id}" : url;
    }

    string? ExtractYouTubeId(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            return null;
        }

        var match = System.Text.RegularExpressions.Regex.Match(
            url,
            @"(?:youtube\.com/(?:watch\?v=|embed/|shorts/|v/)|youtu\.be/)([A-Za-z0-9_-]{11})");

        if (match.Success)
        {
            return match.Groups[1].Value;
        }

        // Bare video ID (orn: _0LwxUBOUjY)
        var trimmed = url.Trim();
        return System.Text.RegularExpressions.Regex.IsMatch(trimmed, @"^[A-Za-z0-9_-]{11}$")
            ? trimmed
            : null;
    }

    // Hero banner: SiteOzellikleri'ndeki alan tam URL veya ID olabilir; her ikisinden ID cikar.
    var heroVideoId = ExtractYouTubeId(ozellikler?.SiteBaslangicVideoLink);
    var heroVideoIsYouTube = string.Equals(ozellikler?.SiteVideoType, "YouTube", StringComparison.OrdinalIgnoreCase)
                             || heroVideoId is not null;
    var heroSrc = heroVideoIsYouTube && heroVideoId is not null
        ? $"https://www.youtube.com/embed/{heroVideoId}?enablejsapi=1&disablekb=1&controls=0&rel=0&iv_load_policy=3&cc_load_policy=0&playsinline=1&showinfo=0&modestbranding=1&fs=0&mute=1&autoplay=1&loop=1&playlist={heroVideoId}"
        : null;
}

<style>
    /* Modal içeriğini ortalamak için */
    .mfp-content {
        max-width: 600px;
    }

    .popup-content {
        text-align: center;
    }

        .popup-content img {
            max-width: 100%;
            cursor: pointer;
        }

    .banner_section .carousel-item {
        cursor: pointer;
    }
</style>

@if (Model.Popup != null && !string.IsNullOrWhiteSpace(Model.Popup.ResimUrl))
{
    <div class="modal fade lr_popup" id="Login" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered " role="document">
            <div class="modal-content border-0">
                <div class="modal-body p-0">
                    <button type="button" id="popupKapatmaButonu" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>

                    <a href="@(string.IsNullOrWhiteSpace(Model.Popup.Link) ? "javascript:void(0);" : Model.Popup.Link)" class="logo" target="_blank">
                        <img id="popupImage" src="@Model.Popup.ResimUrl" alt="@Model.Popup.Baslik" class="img-fluid">
                    </a>

                </div>
            </div>
        </div>
    </div>
}

<!-- START SECTION VIDEO -->
<section class="banner_section p-0 full_screen_aday_ogrenci position-relative">

    <div class="video-wrapper">
        @if (heroSrc is not null)
        {
            <iframe id="videoIframe"
                    src="@heroSrc"
                    frameborder="0"
                    allow="autoplay;"
                    allowfullscreen
                    class="video-iframe">
            </iframe>
        }
        else
        {
            <video id="localVideo" class="video-iframe" autoplay="true" loop="true" muted="true">
                <source src="@ozellikler?.SiteBaslangicVideoLink" type="video/mp4">
                Tarayıcınız video etiketini desteklemiyor.
            </video>
        }
    </div>

    <!-- Butonlar -->
    <div class="video-buttons">
        @if (heroSrc is not null)
        {
            <button id="watchOnYoutube" class="video-btn">🎥 YouTube'da İzle</button>
        }
        <button id="toggleSoundButton" class="video-btn">🔊 Sesi Aç</button>
    </div>

    <a href="#hizli_erisim" class="down down_white page-scroll">
        <span class="mouse"><span></span></span>
    </a>
</section>
<!-- END SECTION VIDEO -->

<!-- START SECTION Dinamik Bölümler (İlk bölüm: Hızlı Erişim) -->
@if (ilkBolum != null && ilkBolum.Blocks.Count > 0)
{
    var hasBgImage = !string.IsNullOrEmpty(ilkBolum.BackgroundImageUrl);
    var sectionClass = hasBgImage ? "parallax_bg overlay_bg_blue_70" : "";
    var parallaxAttr = hasBgImage ? $"data-parallax-bg-image=\"{ilkBolum.BackgroundImageUrl}\"" : "";

    <section class="@sectionClass" style="background-color:@(ilkBolum.BackgroundColor ?? "transparent")" @Html.Raw(parallaxAttr) id="hizli_erisim">

        <div class="container">
            <div class="row justify-content-center">
                <div class="col-xl-12 col-lg-12">
                    <div class=" animation" data-animation="fadeInUp" data-animation-delay="0.2s">
                        <div class="heading_s1 ">
                            <h2>@ilkBolum.Baslik</h2>
                        </div>
                        <hr />
                    </div>
                </div>
            </div>
            <div class="row">
                @foreach (var block in ilkBolum.Blocks.Where(b => b.ParentId == null).OrderBy(b => b.RowNumber))
                {
                    <partial name="~/Views/Templates/Template3/_PageBlockPartial.cshtml" model="block" />
                }
            </div>

        </div>
    </section>
}
<!-- END SECTION Dinamik Bölümler (İlk bölüm) -->

<!-- START SECTION ABOUT -->
<section>
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-5">
                <div class="animation  " data-animation="fadeInLeft" data-animation-delay="0.01s">
                    <img src="@ozellikler?.SiteHakkindaResim" alt="about_img2">
                </div>
            </div>
            <div class="col-md-7">
                <div class="padding_eight_all animation fancy_box  " data-animation="fadeInRight" data-animation-delay="0.01s">
                    <div class="heading_s1">
                        <h2>@T("Hakkımızda", "About Us")</h2>
                    </div>

                    @Html.Raw(isEnglish ? ozellikler?.SiteBaslangicHakkimizdaEng : ozellikler?.SiteBaslangicHakkimizda)
                    <a href="@ozellikler?.SiteHakkindaLink" class="btn btn-outline-black rounded-0 my-2">@T("Daha Fazla", "More")</a>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- END SECTION ABOUT -->

<!-- START SECTION Tanıtım Videoları -->
@if (Model.Videolar.Any())
{
    <section class="small_pt">
        <div class="container">

            <div class="row">
                @foreach (var item in Model.Videolar)
                {
                    <div class="col-lg-4 col-sm-6">
                        <div class="content_box radius_all_10 box_shadow1 ">
                            <div class="content_img radius_ltrt_10">
                                <div class="">
                                    <div class="overlay_bg_30 about_img ">
                                        <img class="w-100" src="@item.ResimUrl" alt="@item.Baslik" />
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(item.VideoUrl))
                                    {
                                        <a href="@NormalizeVideoUrl(item.VideoUrl)" class="video_popup video_play">
                                            <span class="ripple"><i class="ion-play ml-1"></i></span>
                                        </a>
                                    }

                                </div>
                            </div>
                            <div class="content_desc">
                                <h4 class="content_title">
                                    <a href="@BuildContentHref(item.Link, item.SeoUrl, item.PageType?.Slug)">@item.Baslik</a>
                                </h4>
                                <hr />
                                <p>@item.KisaAciklama</p>
                            </div>
                            <div class="content_footer">
                                <div class="price">
                                    <div class="">
                                        <a href="@BuildContentHref(item.Link, item.SeoUrl, item.PageType?.Slug)" class="">
                                            <span class="alert alert-success">@T("Detaylı Gör", "Detail") <i class="fa fa-arrow-circle-right"></i></span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}
<!-- END SECTION Tanıtım Videoları -->

<!-- START SECTION Dinamik Bölümler (Kalan bölümler) -->
@foreach (var bolum in digerBolumler)
{
    if (bolum.Blocks.Count == 0)
    {
        continue;
    }

    var hasBgImage = !string.IsNullOrEmpty(bolum.BackgroundImageUrl);
    var sectionClass = hasBgImage ? "parallax_bg overlay_bg_blue_70" : "";
    var parallaxAttr = hasBgImage ? $"data-parallax-bg-image=\"{bolum.BackgroundImageUrl}\"" : "";

    <section class="@sectionClass" style="background-color:@(bolum.BackgroundColor ?? "transparent")" @Html.Raw(parallaxAttr)>
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-xl-12 col-lg-12">
                    <div class="animation" data-animation="fadeInUp" data-animation-delay="0.2s">
                        <div class="heading_s1">
                            <h2 class="@(hasBgImage ? "text-white" : "")">@bolum.Baslik</h2>
                        </div>
                        <hr style="@(hasBgImage ? "height: 2px; background-color: white;" : "")" />
                    </div>
                </div>
            </div>
            <div class="row">
                @foreach (var block in bolum.Blocks.Where(b => b.ParentId == null).OrderBy(b => b.RowNumber))
                {
                    <partial name="~/Views/Templates/Template3/_PageBlockPartial.cshtml" model="block" />
                }
            </div>
        </div>

    </section>
}
<!-- END SECTION Dinamik Bölümler (Kalan bölümler) -->

<!-- START SECTION Bölümler -->
@if (Model.Bilgiler.Any())
{
    <section class="bg_gray parallax_bg overlay_bg_blue_70" data-parallax-bg-image="/template2/images/counter_bg.jpg">
        <div class="container">

            <div class="row news_list">

                <div class=" course_categories carousel_slider owl-carousel owl-theme nav_style1" data-margin="15" data-nav="true" data-dots="true" data-loop="false" data-autoplay="false" data-responsive='{"0":{"items": "1"}, "380":{"items": "1"}, "576":{"items": "3"}, "1000":{"items": "3"}, "1199":{"items": "3"}}'>

                    @foreach (var item in Model.Bilgiler)
                    {
                        var href = BuildContentHref(item.Link, item.SeoUrl, item.PageType?.Slug);

                        <div class="item">
                            <div class="content_box radius_all_10 box_shadow1">
                                <div class="content_img radius_ltrt_10">
                                    <div class="overlay_bg_30 about_img">
                                        <img class="w-100" src="@item.ResimUrl" alt="@item.Baslik" />
                                    </div>

                                    @if (!string.IsNullOrEmpty(item.VideoUrl))
                                    {
                                        <a href="@NormalizeVideoUrl(item.VideoUrl)" class="video_popup video_play">
                                            <span class="ripple"><i class="ion-play ml-1"></i></span>
                                        </a>
                                    }
                                </div>

                                <div class="content_desc">
                                    <a href="@href">
                                        <h4 class="content_title">@item.Baslik</h4>
                                    </a>
                                    <hr />
                                    <p>@item.KisaAciklama</p>
                                </div>

                                <div class="content_footer">
                                    <div class="price">
                                        <div class="">
                                            <a href="@href" class="">
                                                <span class="alert alert-success">
                                                    @T("Detaylı Gör", "Detail")
                                                    <i class="fa fa-arrow-circle-right"></i>
                                                </span>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                </div>

            </div>

        </div>
    </section>
}
<!-- END SECTION Bölümler-->

<!-- START SECTION GALLERY -->
@if (Model.GaleriResimler.Any())
{
    <section>
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-xl-6 col-lg-8">
                    <div class="text-center ">
                        <div class="heading_s1 text-center">
                            <h2>@T("Galeri", "Our Gallery")</h2>
                        </div>
                        <div class="small_divider"></div>
                    </div>
                </div>
            </div>

            @if (galeriKategoriler.Count > 0)
            {
                <div class="row">
                    <div class="col-md-12 text-center">
                        <ul class="list_none grid_filter ">
                            <li><a href="#" class="current" data-filter="*">@T("tümü", "all")</a></li>
                            @foreach (var kategori in galeriKategoriler)
                            {
                                <li><a href="#" data-filter=".galeri-cat-@galeriKategoriler.IndexOf(kategori)">@kategori</a></li>
                            }
                        </ul>
                    </div>
                </div>
            }

            <div class="row">
                <div class="col-md-12">
                    <ul class="grid_container gutter_medium grid_col3 ">
                        <li class="grid-sizer"></li>

                        @foreach (var item in Model.GaleriResimler)
                        {
                            <li class="grid_item @KategoriSinif(item.Kategori)">
                                <div class="gallery_item radius_all_10">
                                    <a href="#" class="image_link">
                                        <img src="@item.ResimUrl" alt="@item.Baslik">
                                    </a>

                                    <div class="gallery_content">
                                        <div class="link_container">
                                            <a href="@item.ResimUrl" class="image_popup">
                                                <span class="ripple"><i class="ion-image"></i></span>
                                            </a>
                                            <a href="@(string.IsNullOrEmpty(item.Link) ? "javascript:void(0);" : item.Link)" class="ml-3">
                                                <span class="ripple"><i class="ion-link"></i></span>
                                            </a>
                                        </div>
                                        <div class="text_holder text_white">
                                            <h5>@item.Baslik</h5>
                                        </div>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </section>
}
<!-- END SECTION GALLERY -->
<a href="#" class="scrollup" style="display: none;"><i class="ion-ios-arrow-up"></i></a>


@section scripts {
    <script>
        var player;
        var isYouTube = @(heroVideoIsYouTube && heroVideoId is not null ? "true" : "false");
        var localVideo = document.getElementById("localVideo");

        function onYouTubeIframeAPIReady() {
            if (isYouTube) {
                player = new YT.Player('videoIframe', {
                    events: {
                        'onReady': function (event) {
                            event.target.playVideo();
                        }
                    }
                });
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            var toggleSoundButton = document.getElementById("toggleSoundButton");
            var watchOnYoutubeButton = document.getElementById("watchOnYoutube");

            var videoUrl = "@(heroVideoId ?? "")";

            // YouTube'da İzle Butonu
            if (videoUrl && isYouTube && watchOnYoutubeButton) {
                watchOnYoutubeButton.addEventListener("click", function () {
                    window.open("https://www.youtube.com/watch?v=" + videoUrl, "_blank");
                });
            }

            // SES AÇ/KAPAT Butonu
            if (toggleSoundButton) {
                toggleSoundButton.addEventListener("click", function () {
                    if (isYouTube && player) {
                        // YouTube Videosu İçin Ses Kontrolü
                        if (player.isMuted()) {
                            player.unMute();
                            toggleSoundButton.textContent = "🔇 Sesi Kapat";
                        } else {
                            player.mute();
                            toggleSoundButton.textContent = "🔊 Sesi Aç";
                        }
                    } else if (localVideo) {
                        // Lokal Video İçin Ses Kontrolü
                        if (localVideo.muted) {
                            localVideo.muted = false;
                            toggleSoundButton.textContent = "🔇 Sesi Kapat";
                        } else {
                            localVideo.muted = true;
                            toggleSoundButton.textContent = "🔊 Sesi Aç";
                        }
                    }
                });
            }

            // YouTube API'yi sayfaya ekleyelim (YouTube videosu varsa)
            if (isYouTube) {
                var tag = document.createElement('script');
                tag.src = "https://www.youtube.com/iframe_api";
                var firstScriptTag = document.getElementsByTagName('script')[0];
                firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);
            }
        });
    </script>
}
