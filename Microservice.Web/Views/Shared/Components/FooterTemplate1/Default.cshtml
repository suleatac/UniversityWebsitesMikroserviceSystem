@using Microservice.Web.ViewModels.Menu
@model Microservice.Web.ViewModels.Footer.FooterTemplate1Vm

@{
    // Link dolu ise dogrudan o link kullanilir.
    // Link bos ise menu, bagli oldugu sayfa tipine (PageType) yonlendirilir: /{dil}/{slug}
    string BuildHref(MenuGetVm menu)
    {
        if (!string.IsNullOrWhiteSpace(menu.Link))
        {
            return menu.Link.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                ? menu.Link
                : "/" + menu.Link.Trim('/');
        }

        if (!string.IsNullOrWhiteSpace(menu.SeoUrl))
        {
            var langCode = Model.DilId == 2 ? "en" : "tr";
            return $"/{langCode}/{menu.SeoUrl.Trim('/')}";
        }

        return "#";
    }

    var ozellikler = Model.Site?.SiteOzellikleri;
    var isEnglish = Model.DilId == 2;
    var footerAddress = isEnglish ? ozellikler?.SiteAdressEng : ozellikler?.SiteAdress;
    var haberBasligi = isEnglish ? "RECENT POSTS" : "SON HABERLER";
    var iletisimBasligi = isEnglish ? "CONTACT" : "İLETİŞİM";
    var hizliErisimBasligi = isEnglish ? "QUICK ACCESS" : "HIZLI ERİŞİM";
    var siteAdi = isEnglish ? Model.Site?.SiteAdiEng : Model.Site?.SiteAdi;
}

<footer class="footer full-color">
    <section id="bottom">
        <div class="section-inner">
            <div class="container">
                <div class="row normal-sidebar">
                    @if (Model.BandLogos.Any())
                    {
                        <div class="widget widget-text">
                            <div class="row">
                                @foreach (var bandLogo in Model.BandLogos)
                                {
                                    <div class="col-md-3">
                                        <div class=" widget-inner">
                                            <div class="textwidget">
                                                <div class="media un-icon-box" data-delay="0">
                                                    <div class="pull-left">
                                                        <div class="un-icon">
                                                            <img src="@bandLogo.ImgUrl"
                                                                 alt="@bandLogo.Ad"
                                                                 loading="lazy">
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (Model.FooterColumns.Any())
                    {
                        <div class=" widget divider-widget">
                            <div class=" widget-inner">
                                <div class="un-heading un-separator">
                                    <div class="un-heading-wrap">
                                        <span class="un-heading-line un-heading-before">
                                            <span></span>
                                        </span>
                                        <button class="flat-button style1">
                                            @hizliErisimBasligi <i class="fa fa-angle-right"></i>
                                        </button>
                                        <span class="un-heading-line un-heading-after">
                                            <span></span>
                                        </span>
                                    </div>
                                    <div class="clearfix"></div>
                                </div>
                            </div>
                        </div>

                        @foreach (var column in Model.FooterColumns)
                        {
                            <div class="col-md-3  widget widget-nav-menu">
                                <div class=" widget-inner">
                                    <h2 class="widget-title maincolor1">@column.Baslik</h2>
                                    <ul class="menu">
                                        @foreach (var link in column.Children)
                                        {
                                            <li class="menu-item menu-item-type-custom menu-item-object-custom">
                                                <a href="@BuildHref(link)">@link.Baslik</a>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        }
                    }

                   

                    @if (Model.LatestHaberler.Any())
                    {
                        <div class=" col-md-3  widget widget-recent-entries">
                            <div class=" widget-inner">
                                <h2 class="widget-title maincolor1">@haberBasligi</h2>
                                <ul>
                                    @foreach (var haber in Model.LatestHaberler)
                                    {
                                        <li>
                                            <a href="/haberler/@haber.SeoUrl">@haber.Baslik</a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }
                    <div class=" col-md-3 border widget widget-text">
                        <div class=" widget-inner">
                            <h2 class="widget-title maincolor1">@iletisimBasligi</h2>
                            <div class="textwidget">
                                <p>
                                    @if (!string.IsNullOrWhiteSpace(Model.Site?.SiteEPosta))
                                    {
                                        @:Email: @Model.Site.SiteEPosta<br>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(ozellikler?.SiteTelNo))
                                    {
                                        @:Telephone: @ozellikler.SiteTelNo<br>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(ozellikler?.SiteFaxNo))
                                    {
                                        @:Fax: @ozellikler.SiteFaxNo<br>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(footerAddress))
                                    {
                                        @:Adress: @footerAddress
                                    }
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class=" col-md-3  widget divider-widget">
                        <div class=" widget-inner">
                            <div class="un-heading un-separator">
                                <div class="un-heading-wrap">
                                    <span class="un-heading-line un-heading-before">
                                        <span>
                                        </span>
                                    </span>
                                    <span class="un-heading-line un-heading-after">
                                        <span></span>
                                    </span>
                                </div>
                                <div class="clearfix"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div id="bottom-nav">
        <div class="container">
            <div class="link-center">
                <div class="line-under"></div>
                <a class="flat-button go-top-v1 style1" href="#top">En Başa Dönün</a>
            </div>
            <div class="row footer-content">
                <div class="copyright col-md-6">
                    © @DateTime.Now.Year @siteAdi - Tüm hakları saklıdır.
                </div>
                <nav class="col-md-6 footer-social">
                    <ul class="social-list">
                        @if (!string.IsNullOrWhiteSpace(ozellikler?.SiteFacebookAdress))
                        {
                            <li>
                                <a href="@ozellikler.SiteFacebookAdress" target="_blank" rel="noopener" class="btn btn-default social-icon">
                                    <i class="fa fa-facebook"></i>
                                </a>
                            </li>
                        }
                        @if (!string.IsNullOrWhiteSpace(ozellikler?.SiteTwitterAdress))
                        {
                            <li>
                                <a href="@ozellikler.SiteTwitterAdress" target="_blank" rel="noopener" class="btn btn-default social-icon">
                                    <i class="fa fa-twitter"></i>
                                </a>
                            </li>
                        }
                        @if (!string.IsNullOrWhiteSpace(ozellikler?.SiteInstagramAdress))
                        {
                            <li>
                                <a href="@ozellikler.SiteInstagramAdress" target="_blank" rel="noopener" class="btn btn-default social-icon">
                                    <i class="fa fa-instagram"></i>
                                </a>
                            </li>
                        }
                        @if (!string.IsNullOrWhiteSpace(ozellikler?.SiteLinkedinAdress))
                        {
                            <li>
                                <a href="@ozellikler.SiteLinkedinAdress" target="_blank" rel="noopener" class="btn btn-default social-icon">
                                    <i class="fa fa-linkedin"></i>
                                </a>
                            </li>
                        }
                        @if (!string.IsNullOrWhiteSpace(ozellikler?.SiteYoutubeAdress))
                        {
                            <li>
                                <a href="@ozellikler.SiteYoutubeAdress" target="_blank" rel="noopener" class="btn btn-default social-icon">
                                    <i class="fa fa-youtube"></i>
                                </a>
                            </li>
                        }
                        @if (!string.IsNullOrWhiteSpace(ozellikler?.SiteWatsappAdress))
                        {
                            <li>
                                <a href="@ozellikler.SiteWatsappAdress" target="_blank" rel="noopener" class="btn btn-default social-icon">
                                    <i class="fa fa-whatsapp"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div><!--/row-->
        </div><!--/container-->
    </div>
</footer>
