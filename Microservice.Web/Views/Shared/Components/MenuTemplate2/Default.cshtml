@functions {
    string RenderMenu(List<Menu> menuList)
    {
        var result = "";
        var sortedMenuList = menuList.OrderBy(m => m.sira).ToList();

        foreach (var item in sortedMenuList)
        {
            var altMenuList = item.Menu1.Where(m => m.aktif).OrderBy(m => m.sira).ToList();

            var isMegaMenu = item.mega_menu; // mega_menu: bool property

            result += "<li class=\"" + (altMenuList.Count > 0 ? (isMegaMenu ? "dropdown dropdown-mega-menu" : "dropdown") : "") + "\">";
            result += $"<a class=\"" + (altMenuList.Count > 0 ? "dropdown-toggle" : "") + " nav-link\" href=\"" + item.getAdresMenu() + "\" data-toggle=\"" + (altMenuList.Count > 0 ? "dropdown" : "") + "\">" + item.adi + "</a>";

            if (altMenuList.Count > 0)
            {
                if (isMegaMenu)
                {
                    result += "<div class=\"dropdown-menu\"><ul class=\"mega-menu\">";

                    // Mega menüde her alt menüyü bir kolon olarak gösteriyoruz
                    foreach (var sub in altMenuList)
                    {
                        var nestedSubList = sub.Menu1.Where(m => m.aktif).OrderBy(m => m.sira).ToList();

                        result += "<li class=\"mega-menu-col\">";
                        result += $"<a class=\"dropdown-item nav-link nav_item mega-menu-column-title\" href=\"{sub.getAdresMenu()}\">{sub.adi}</a>";
                        result += "<div><ul>";
                        foreach (var nested in nestedSubList)
                        {
                            result += $"<li><a class=\"dropdown-item nav-link nav_item\" href=\"{nested.getAdresMenu()}\">{nested.adi}</a></li>";
                        }
                        result += "</ul></div></li>";
                    }

                    result += "</ul></div>";
                }
                else
                {
                    result += "<div class=\"dropdown-menu\">";
                    result += RenderSubMenu(altMenuList);
                    result += "</div>";
                }
            }

            result += "</li>";
        }

        return result;
    }


    string RenderSubMenu(List<Menu> subMenuList)
    {
        var result = "<ul>";

        // Alt menü listesini 'sira' özelliğine göre sırala
        var sortedSubMenuList = subMenuList.OrderBy(m => m.sira).ToList();

        foreach (var subItem in sortedSubMenuList)
        {
            result += "<li>";
            result += $"<a class=\"dropdown-item " + (subItem.Menu1.Any(m => m.aktif) ? "menu-link dropdown-toggler" : "nav-link nav_item") + "\" href=\"" + subItem.getAdresMenu() + "\">" + subItem.adi + "</a>";

            if (subItem.Menu1.Any(m => m.aktif))
            {
                var nestedSubMenuList = subItem.Menu1.Where(m => m.aktif).OrderBy(m => m.sira).ToList();
                result += "<div class=\"dropdown-menu\">";
                result += RenderSubMenu(nestedSubMenuList);
                result += "</div>";
            }

            result += "</li>";
        }

        result += "</ul>";
        return result;
    }
}

