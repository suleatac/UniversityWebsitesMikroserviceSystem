@using Microservice.Web.ViewModels.Menu
@model Microservice.Web.ViewModels.Menu.MenuGetIndexVm
@functions {
    // Link dolu ise dogrudan o link kullanilir.
    // Link bos ise menu, bagli oldugu sayfa tipine (PageType) yonlendirilir: /{dil}/{slug}[/{seoUrl}]
    string BuildHref(GetMenuVm menu)
    {
        if (!string.IsNullOrWhiteSpace(menu.Link))
        {
            var link = menu.Link.Trim();

            return link.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                ? link
                : "/" + link.Trim('/');
        }

        if (menu.PageType is not null && !string.IsNullOrWhiteSpace(menu.PageType.Slug))
        {
            return string.IsNullOrWhiteSpace(menu.SeoUrl)
                ? $"/{Model.LanguageCode}/{menu.PageType.Slug}"
                : $"/{Model.LanguageCode}/{menu.PageType.Slug}/{menu.SeoUrl.Trim('/')}";
        }

        return "#";
    }

    string RenderMenu(List<GetMenuVm> menuList)
    {
        var result = "";
        var sortedMenuList = menuList.OrderBy(m => m.Sira).ToList();

        foreach (var item in sortedMenuList)
        {
            var altMenuList = item.Children.Where(m => m.IsVisible).OrderBy(m => m.Sira).ToList();

            var isMegaMenu = item.MegaMenu;

            result += "<li class=\"" + (altMenuList.Count > 0 ? (isMegaMenu ? "dropdown dropdown-mega-menu" : "dropdown") : "") + "\">";
            result += $"<a class=\"" + (altMenuList.Count > 0 ? "dropdown-toggle" : "") + " nav-link\" href=\"" + BuildHref(item) + "\" data-toggle=\"" + (altMenuList.Count > 0 ? "dropdown" : "") + "\">" + item.Ad + "</a>";

            if (altMenuList.Count > 0)
            {
                if (isMegaMenu)
                {
                    result += "<div class=\"dropdown-menu\"><ul class=\"mega-menu\">";

                    // Mega menüde her alt menüyü bir kolon olarak gösteriyoruz
                    foreach (var sub in altMenuList)
                    {
                        var nestedSubList = sub.Children.Where(m => m.IsVisible).OrderBy(m => m.Sira).ToList();

                        result += "<li class=\"mega-menu-col\">";
                        result += $"<a class=\"dropdown-item nav-link nav_item mega-menu-column-title\" href=\"{BuildHref(sub)}\">{sub.Ad}</a>";
                        result += "<div><ul>";
                        foreach (var nested in nestedSubList)
                        {
                            result += $"<li><a class=\"dropdown-item nav-link nav_item\" href=\"{BuildHref(nested)}\">{nested.Ad}</a></li>";
                        }
                        result += "</ul></div></li>";
                    }

                    result += "</ul></div>";
                }
                else
                {
                    result += "<div class=\"dropdown-menu\">";
                    result += RenderSubMenu(altMenuList);
                    result += "</div>";
                }
            }

            result += "</li>";
        }

        return result;
    }


    string RenderSubMenu(List<GetMenuVm> subMenuList)
    {
        var result = "<ul>";

        // Alt menü listesini 'sira' özelliğine göre sırala
        var sortedSubMenuList = subMenuList.OrderBy(m => m.Sira).ToList();

        foreach (var subItem in sortedSubMenuList)
        {
            result += "<li>";
            result += $"<a class=\"dropdown-item " + (subItem.Children.Any(m => m.IsVisible) ? "menu-link dropdown-toggler" : "nav-link nav_item") + "\" href=\"" + BuildHref(subItem) + "\">" + subItem.Ad + "</a>";

            if (subItem.Children.Any(m => m.IsVisible))
            {
                var nestedSubMenuList = subItem.Children.Where(m => m.IsVisible).OrderBy(m => m.Sira).ToList();
                result += "<div class=\"dropdown-menu\">";
                result += RenderSubMenu(nestedSubMenuList);
                result += "</div>";
            }

            result += "</li>";
        }

        result += "</ul>";
        return result;
    }
}

@{
    var ozellikler = Model.Site?.SiteOzellikleri;
    var isEnglish = string.Equals(Model.LanguageCode, "en", StringComparison.OrdinalIgnoreCase);
    var otherLanguageCode = isEnglish ? "tr" : "en";
    var searchAction = string.IsNullOrWhiteSpace(Model.SearchPageSlug)
        ? "#"
        : $"/{Model.LanguageCode}/{Model.SearchPageSlug}";
    var logoUrl = !string.IsNullOrWhiteSpace(ozellikler?.SiteTopbarLogo)
        ? ozellikler!.SiteTopbarLogo
        : Url.Content("~/template2/images/logo_dark.png");
}

<style>
    #languageButton:hover {
        background-color: indianred;
    }
</style>

<header class="header_wrap dark_skin">
    <div class="top-header bg_blue_dark2 light_skin">
        <div class="container">
            <div class="row align-items-center">

                <div class="col-md-6">

                    <ul class="contact_detail list_none text-center text-md-left">
                        @if (!string.IsNullOrWhiteSpace(ozellikler?.SiteTelNo))
                        {
                            <li><a href="tel:@ozellikler.SiteTelNo"><i class="ti-mobile"></i>@ozellikler.SiteTelNo</a></li>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Site?.SiteEPosta))
                        {
                            <li><a href="mailto:@Model.Site.SiteEPosta"><i class="ti-email"></i> @(isEnglish ? "Reach via EMail" : "Mail ile Ulaş") </a></li>
                        }
                        <li>

                            <!-- Burası translate butonları kısmı-->
                            <div class="text-wrapper ml-3">
                                <div class="btn-group">
                                    <div id="google_translate_element"></div>
                                </div>
                            </div>
                        </li>

                    </ul>
                </div>

                <div class="col-md-6">
                    <div class="d-flex flex-wrap align-items-center justify-content-md-end justify-content-center mt-2 mt-md-0">
                        <ul class="list_none social_icons social_white text-center text-md-right mr-5">
                            @if (!string.IsNullOrWhiteSpace(ozellikler?.SiteFacebookAdress))
                            {
                                <li><a href="@ozellikler.SiteFacebookAdress" target="_blank" rel="noopener"><i class="ion-social-facebook"></i></a></li>
                            }
                            @if (!string.IsNullOrWhiteSpace(ozellikler?.SiteTwitterAdress))
                            {
                                <li><a href="@ozellikler.SiteTwitterAdress" target="_blank" rel="noopener"><i class="ion-social-twitter"></i></a></li>
                            }
                            @if (!string.IsNullOrWhiteSpace(ozellikler?.SiteWatsappAdress))
                            {
                                <li><a href="https://api.whatsapp.com/send?phone=@ozellikler.SiteWatsappAdress" target="_blank" rel="noopener"><i class="ion-social-whatsapp-outline"></i></a></li>
                            }
                            @if (!string.IsNullOrWhiteSpace(ozellikler?.SiteYoutubeAdress))
                            {
                                <li><a href="@ozellikler.SiteYoutubeAdress" target="_blank" rel="noopener"><i class="ion-social-youtube-outline"></i></a></li>
                            }
                            @if (!string.IsNullOrWhiteSpace(ozellikler?.SiteInstagramAdress))
                            {
                                <li><a href="@ozellikler.SiteInstagramAdress" target="_blank" rel="noopener"><i class="ion-social-instagram-outline"></i></a></li>
                            }
                        </ul>

                        <a href="/@otherLanguageCode" id="languageButton" style="border:1px solid white; padding:3px; ">
                            @if (isEnglish)
                            {
                                <img class="" src="~/template2/images/flags/turkey.jpg" alt="türkçe sayfaya geçiş" height="16"> <span class="text-white">TR</span>
                            }
                            else
                            {
                                <img class="" src="~/template2/images/flags/us.jpg" alt="ingilizce sayfaya geçiş" height="16"> <span class="text-white">EN</span>
                            }
                        </a>

                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="container">
        <nav class="navbar navbar-expand-lg">
            <a class="navbar-brand" href="/">
                <img class="logo_dark" src="@logoUrl" alt="logo"  />
            </a>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation"> <span class="ion-android-menu"></span> </button>
            <div class="collapse navbar-collapse justify-content-end" id="navbarSupportedContent">
                <ul class="navbar-nav">
                    <li><a class="nav-link" href="/@Model.LanguageCode">Anasayfa</a></li>
                    @Html.Raw(RenderMenu(Model.Menus))
                </ul>
            </div>
            <ul class="navbar-nav attr-nav align-items-center ml-3">
                <li>
                    <a href="javascript:void(0);" class="nav-link search_trigger"><i class="ion-ios-search-strong"></i></a>
                    <div class="search-overlay">
                        <div class="search_wrap">
                            <form action='@searchAction' method="get">
                                <input type="text" placeholder="Ara..." class="form-control" id="search_input" name="q">
                                <button type="submit" class="search_icon"><i class="ion-ios-search-strong"></i></button>
                            </form>
                        </div>
                    </div>
                </li>
            </ul>
        </nav>
    </div>
</header>
<!-- END HEADER -->
