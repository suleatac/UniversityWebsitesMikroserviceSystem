@model List<Microservice.Web.ViewModels.Menu.MenuGetVm>

<ul class="navbar-nav flex-grow-1">
    @if (Model.Count == 0)
    {
        <li class="nav-item"><span class="nav-link text-muted">Menü bulunamadı</span></li>
    }
    else
    {
        @foreach (var menu in Model)
        {
            var href = string.IsNullOrWhiteSpace(menu.Link) ? "#" : "/" + menu.Link.Trim('/');

            if (menu.Children.Count == 0)
            {
                <li class="nav-item">
                    <a class="nav-link" href="@href">@menu.Ad</a>
                </li>
            }
            else
            {
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="@href" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        @menu.Ad
                    </a>
                    <ul class="dropdown-menu">
                        @foreach (var child in menu.Children.OrderBy(c => c.Sira))
                        {
                            var childHref = string.IsNullOrWhiteSpace(child.Link) ? "#" : "/" + child.Link.Trim('/');
                            <li><a class="dropdown-item" href="@childHref">@child.Ad</a></li>
                        }
                    </ul>
                </li>
            }
        }
    }
</ul>
