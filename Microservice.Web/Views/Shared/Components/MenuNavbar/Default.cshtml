@model Microservice.Web.ViewModels.Menu.MenuGetIndexVm

@{
    string BuildHref(string? link) => string.IsNullOrWhiteSpace(link) ? "#" : "/" + link.Trim('/');
}






<div class="menu-hover">
    <div class="btn-menu">
        <span></span>
    </div><!-- //mobile menu button -->
</div>

<div class="header-inner-pages">
    <div class="top">
        <div class="container">
            <div class="row">
                <div class="col-md-12">
                    <nav class="navbar menu-top">
                        <ul class="menu clearfix">
                          @*   <li class="home">
                                <a href="blog.html">Blog</a>
                                <ul class="submenu">
                                    <li><a href="blog-single.html">Blog Single</a></li>
                                </ul><!-- /.submenu -->
                            </li>
                            <li>
                                <a href="portfolio.html">Portfolio</a>
                                <ul class="submenu">
                                    <li><a href="portfolio-single.html">Portfolio Single</a></li>
                                </ul><!-- /.submenu -->
                            </li> *@
                            <!-- Burası translate butonları kısmı-->
                          
                            <li style="position: relative !important;">
                                <div class="text-wrapper mr-3">
                                    <div class="btn-group">
                                        <div id="google_translate_element"></div>
                                    </div>
                                </div>
                            </li>
                            <li>
                                <a href="member.html">İletişim</a>
                                <ul class="submenu">
                                    <li><a href="mailto:@Model.Site.SiteEPosta">Email</a></li>
                                    @if (!string.IsNullOrWhiteSpace(Model.Site?.SiteOzellikleri?.SiteWatsappAdress))
                                    {
                                        <li><a href="https://api.whatsapp.com/send?phone=@Model.Site.SiteOzellikleri.SiteWatsappAdress">Whatsapp</a></li>  
                                    }
                                    @if (!string.IsNullOrWhiteSpace(Model.Site?.SiteOzellikleri?.SiteTelNo))
                                    {
                                        <li><a href="https://api.whatsapp.com/send?phone=@Model.Site.SiteOzellikleri.SiteTelNo">Telefon</a></li>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(Model.Site?.SiteOzellikleri?.SiteFaxNo))
                                    {
                                        <li><a href="https://api.whatsapp.com/send?phone=@Model.Site.SiteOzellikleri.SiteFaxNo">Fax</a></li>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(Model.Site?.SiteOzellikleri?.SiteWatsappAdress))
                                    {
                                        <li><a href="https://api.whatsapp.com/send?phone=@Model.Site.SiteOzellikleri.SiteWatsappAdress">Instagram</a></li>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(Model.Site?.SiteOzellikleri?.SiteWatsappAdress))
                                    {
                                        <li><a href="https://api.whatsapp.com/send?phone=@Model.Site.SiteOzellikleri.SiteWatsappAdress">Whatsapp</a></li>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(Model.Site?.SiteOzellikleri?.SiteLinkedinAdress))
                                    {
                                        <li><a href="https://api.whatsapp.com/send?phone=@Model.Site.SiteOzellikleri.SiteLinkedinAdress">Linkedin</a></li>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(Model.Site?.SiteOzellikleri?.SiteTwitterAdress))
                                    {
                                        <li><a href="https://api.whatsapp.com/send?phone=@Model.Site.SiteOzellikleri.SiteTwitterAdress">Twitter</a></li>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(Model.Site?.SiteOzellikleri?.SiteYoutubeAdress))
                                    {
                                        <li><a href="https://api.whatsapp.com/send?phone=@Model.Site.SiteOzellikleri.SiteYoutubeAdress">Youtube</a></li>
                                    }
                                </ul><!-- /.submenu -->
                            </li>
                        </ul><!-- /.menu -->
                    </nav><!-- /.mainnav -->

                    <a class="navbar-right search-toggle show-search" href="#">
                        <i class="fa fa-search"></i>
                    </a>

                    <div class="submenu top-search">
                        <form class="search-form">
                            <div class="input-group">
                                <input type="search" class="search-field" placeholder="Search Here">
                                <span class="input-group-btn">
                                    <button type="submit"><i class="fa fa-search fa-4x"></i></button>
                                </span>
                            </div>
                        </form>
                    </div>

                    <div class="navbar-right topnav-sidebar">
                        <ul class="textwidget">
                            @if (!string.IsNullOrWhiteSpace(Model.Site?.SiteOzellikleri?.SiteFacebookAdress))
                            {
                                   <li>
                                    <a href="@Model.Site.SiteOzellikleri.SiteFacebookAdress"><i class="fa fa-facebook"></i></a>
                            </li>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Site?.SiteOzellikleri?.SiteLinkedinAdress))
                            {
                                <li>
                                    <a href="@Model.Site.SiteOzellikleri.SiteLinkedinAdress"><i class="fa fa-linkedin"></i></a>
                                </li>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Site?.SiteOzellikleri?.SiteInstagramAdress))
                            {
                                <li>
                                    <a href="@Model.Site.SiteOzellikleri.SiteInstagramAdress"><i class="fa fa-instagram"></i></a>
                                </li>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Site?.SiteOzellikleri?.SiteYoutubeAdress))
                            {
                                <li>
                                    <a href="@Model.Site.SiteOzellikleri.SiteYoutubeAdress"><i class="fa fa-youtube"></i></a>
                                </li>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Site?.SiteOzellikleri?.SiteTwitterAdress))
                            {
                                <li>
                                    <a href="@Model.Site.SiteOzellikleri.SiteTwitterAdress"><i class="fa fa-twitter"></i></a>
                                </li>
                            }
                        </ul>
                    </div>
                </div><!-- col-md-12 -->
            </div><!-- row -->
        </div><!-- container -->
    </div><!-- Top -->
</div><!-- header-inner-pages -->
<!-- Header -->
<header id="header" class="header">
    <div class="header-wrap">
        <div class="container">
            <div class="header-wrap clearfix">
                <div id="logo" class="logo">
                    @if (!string.IsNullOrWhiteSpace(Model.Site?.SiteOzellikleri?.SiteTopbarLogo))
                    {
                        <a href="/" rel="home">
                            <img src="@Model.Site.SiteOzellikleri.SiteTopbarLogo" alt="image">
                        </a>
                    }
                </div><!-- /.logo -->


                <div class="nav-wrap">

                    <nav id="mainnav" class="mainnav">
                        <ul class="menu">
                            <li class="home">
                                <a href="/">Anasayfa</a>
                            </li>
                            @foreach (var menu in Model.Menus)
                            {
                                var href = BuildHref(menu.Link);

                                if (menu.Children.Count == 0)
                                {
                                    <li><a href="@href">@menu.Ad</a></li>
                                }
                                else
                                {
                                    <li>
                                        <a href="@href">@menu.Ad</a>
                                        <ul class="submenu">
                                            @foreach (var child in menu.Children.OrderBy(c => c.Sira))
                                            {
                                                var childHref = BuildHref(child.Link);
                                                <li><a href="@childHref">@child.Ad</a></li>
                                            }
                                        </ul><!-- /.submenu -->
                                    </li>
                                }
                            }
                        </ul><!-- /.menu -->
                    </nav><!-- /.mainnav -->
                </div><!-- /.nav-wrap -->
            </div><!-- /.header-wrap -->
        </div><!-- /.container-->
    </div><!-- /.header-wrap-->
</header><!-- /.header -->

















